     elif code.startswith('D60'):\n            return 'Acquired pure red cell aplasia [erythroblastopenia]'\n        elif code.startswith('D61'):\n            return 'Other aplasias and pancytopenias'\n        elif code.startswith('D62'):\n            return 'Acute posthemorrhagic anemia'\n        elif code.startswith('D63'):\n            return 'Anemia in chronic diseases classified elsewhere'\n        elif code.startswith('D64'):\n            return 'Other anemias'\n        elif code.startswith('D65'):\n            return 'Disseminated intravascular coagulation [defibrination syndrome]'\n        elif code.startswith('D66'):\n            return 'Hereditary factor VIII deficiency'\n        elif code.startswith('D67'):\n            return 'Hereditary factor IX deficiency'\n        elif code.startswith('D68'):\n            return 'Other coagulation defects'\n        elif code.startswith('D69'):\n            return 'Purpura and other hemorrhagic conditions'\n        elif code.startswith('D70'):\n            return 'Neutropenia'\n        elif code.startswith('D71'):\n            return 'Functional disorders of polymorphonuclear neutrophils'\n        elif code.startswith('D72'):\n            return 'Other disorders of white blood cells'\n        elif code.startswith('D73'):\n            return 'Diseases of spleen'\n        elif code.startswith('D74'):\n            return 'Methemoglobinemia'\n        elif code.startswith('D75'):\n            return 'Other and unspecified diseases of blood and blood-forming organs'\n        elif code.startswith('D76'):\n            return 'Certain conditions originating in the perinatal period'\n        elif code.startswith('D77'):\n            return 'Other disorders of blood and blood-forming organs in diseases classified elsewhere'\n        elif code.startswith('D80'):\n            return 'Immunodeficiency with predominantly antibody defects'\n        elif code.startswith('D81'):\n            return 'Combined immunodeficiencies'\n      
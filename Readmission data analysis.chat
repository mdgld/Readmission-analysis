              "description": "Build comprehensive ICD reference with categorization",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPY'\nimport pandas as pd\nimport json\nimport re\n\n# Load dataset\ndf = pd.read_csv(\"/Users/matthewgold/code/jupyter_projects/With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\n\n# Load psychiatric mapping\nwith open('/tmp/icd_psychiatric_mapping.json', 'r') as f:\n    psych_map = json.load(f)\n\ndef extract_codes(code_string):\n    if pd.isna(code_string):\n        return []\n    codes = [c.strip() for c in str(code_string).split(',')]\n    return codes\n\n# Get all unique codes\nall_codes = set()\nfor col in ['VisitDiags', 'NonSuicidialDiags', 'ChronicDiags']:\n    for cell in df[col].dropna():\n        all_codes.update(extract_codes(cell))\n\nall_codes = sorted(all_codes)\n\n# Build comprehensive reference using ICD-10-CM categorization by first character(s)\ndef categorize_code(code):\n    \"\"\"Categorize unmapped codes by ICD-10 chapter\"\"\"\n    if code.startswith('A') or code.startswith('B'):\n        return 'Infectious Diseases'\n    elif code.startswith('C') or code.startswith('D'):\n        return 'Neoplasms/Blood Disorders'\n    elif code.startswith('E'):\n        return 'Endocrine/Metabolic'\n    elif code.startswith('G'):\n        return 'Nervous System Disorders'\n    elif code.startswith('H'):\n        return 'Eye/Ear Disorders'\n    elif code.startswith('I'):\n        return 'Circulatory System'\n    elif code.startswith('J'):\n        return 'Respiratory System'\n    elif code.startswith('K'):\n        return 'Digestive System'\n    elif code.startswith('L'):\n        return 'Skin/Subcutaneous'\n    elif code.startswith('M'):\n        return 'Musculoskeletal System'\n    elif code.startswith('N'):\n        return 'Genitourinary System'\n    elif code.startswith('O'):\n        return 'Pregnancy/Childbirth'\n    elif code.startswith('P'):\n        return 'Perinatal Conditions'\n    elif code.startswith('Q'):\n        return 'Congenital Anomalies'\n    elif code.startswith('R'):\n        return 'Symptoms/Signs/Abnormal Findings'\n    elif code.startswith('S') or code.startswith('T'):\n        return 'Injury/Poisoning'\n    elif code.startswith('U'):\n        return 'External Cause'\n    elif code.startswith('V') or code.startswith('W') or code.startswith('X') or code.startswith('Y'):\n        return 'External Causes'\n    elif code.startswith('Z'):\n        return 'Factors Influencing Health Status'\n    else:\n        return 'Unclassified'\n\n# Create comprehensive reference\ncomprehensive_ref = {}\nfor code in all_codes:\n    if code in psych_map:\n        comprehensive_ref[code] = psych_map[code]\n    else:\n        comprehensive_ref[code] = {\n            'name': f'{code} [Requires lookup]',\n            'category': categorize_code(code),\n            'dsm5_category': None,\n            'dsm5_code': None,\n            'needs_mapping': True\n        }\n\nprint(f\"Comprehensive reference built: {len(comprehensive_ref)} codes\")\n\n# Save for next step\nimport pickle\nwith open('/tmp/comprehensive_icd_ref.pkl', 'wb') as f:\n    pickle.dump(comprehensive_ref, f)\n\n# Statistics by category\nfrom collections import Counter\ncategories = [v.get('category', 'Unknown') for v in comprehensive_ref.values()]\ncat_counts = Counter(categories)\n\nprint(\"\\nCodes by category:\")\nfor cat, count in sorted(cat_counts.items(), key=lambda x: -x[1]):\n    mapped = sum(1 for v in comprehensive_ref.values() if v.get('category') == cat and not v.get('needs_mapping'))\n    print(f\"  {cat}: {count} codes ({mapped} mapped)\")\n\n# Show psychiatric focus\npsych_codes = [c for c, v in comprehensive_ref.items() if 'Psychiatric' in str(v.get('dsm5_category', '')) or c.startswith('F')]\nprint(f\"\\nPsychiatric-related codes (F-codes and DSM-5 mapped): {len(psych_codes)}\")\n\nprint(\"\\nREADY FOR NEXT STEP: Parse diagnoses and merge annotations\")\nEOFPY\n"
            }

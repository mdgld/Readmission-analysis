      "metadata": {
        "tool_calls": [
          {
            "raw_input": {
              "content": "\n# \u2500\u2500 Post-hoc: FAMD Component Loadings Heatmap \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# prince 0.19 does not expose column_correlations_ as an attribute;\n# compute it directly: Pearson r between each FAMD component and each numeric feature.\nfrom scipy.stats import pearsonr\n\nfc = np.array(famd_coords)           # (n_samples \u00d7 n_components)\nn_comp_show = min(6, fc.shape[1])\n\ncorr_matrix = np.zeros((len(feature_labels), n_comp_show))\nfor i in range(len(feature_labels)):\n    for j in range(n_comp_show):\n        r, _ = pearsonr(fc[:, j], X_ml[:, i])\n        corr_matrix[i, j] = r\n\nloadings_df = pd.DataFrame(\n    corr_matrix,\n    index=feature_labels,\n    columns=[f'PC{j+1}' for j in range(n_comp_show)]\n)\n\n# Sort rows by |r| on PC1\nloadings_df = loadings_df.reindex(\n    loadings_df['PC1'].abs().sort_values(ascending=False).index\n)\n\nfig, ax = plt.subplots(figsize=(10, max(8, len(loadings_df) * 0.38)))\nsns.heatmap(loadings_df, annot=True, fmt='.2f', cmap='RdBu_r',\n            center=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\n            cbar_kws={'label': 'Pearson r with FAMD component'})\nax.set_title('FAMD Component Loadings\\n(Pearson r between features and components; rows sorted by |PC1|)',\n             fontsize=13, fontweight='bold')\nax.set_xlabel('FAMD Component')\nax.set_ylabel('Feature')\nplt.tight_layout()\nplt.savefig('figures/Fig_FAMD_loadings.png')\nplt.show()\nprint(\"\u2713 FAMD loadings saved\")\n\nprint(f\"\\nTop 5 features loading on PC1:\")\nfor feat, r in loadings_df['PC1'].abs().sort_values(ascending=False).head(5).items():\n    sign = '+' if loadings_df.loc[feat, 'PC1'] > 0 else '-'\n    print(f\"  {feat:<35}  r = {sign}{abs(r):.3f}\")\nprint(f\"\\nTop 5 features loading on PC2:\")\nfor feat, r in loadings_df['PC2'].abs().sort_values(ascending=False).head(5).items():\n    sign = '+' if loadings_df.loc[feat, 'PC2'] > 0 else '-'\n    print(f\"  {feat:<35}  r = {sign}{abs(r):.3f}\")\n",

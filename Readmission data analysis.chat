            "tool_call_id": "toolu_01QnspfS3axxRbdvFJfQk6hg",
            "raw_input": {
              "content": "\n# \u2500\u2500 Fig 8: ROC curves \u2014 LR vs Random Forest vs XGBoost \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 2, figsize=(14, 6))\n\nmodels = [\n    ('Logistic Regression', lr_probs,  '#2166ac', lr_auc),\n    ('Random Forest',       rf_probs,  '#4dac26', rf_auc),\n    ('XGBoost',             xgb_probs, '#d01c8b', xgb_auc),\n]\n\n# Left: ROC curves\nfor name, probs, color, auc in models:\n    fpr, tpr, _ = roc_curve(y_ml, probs)\n    axes[0].plot(fpr, tpr, color=color, linewidth=2.5, label=f'{name} (AUC = {auc:.3f})')\naxes[0].plot([0, 1], [0, 1], 'k--', linewidth=1, alpha=0.5, label='Random Chance')\naxes[0].fill_between([0, 1], [0, 1], alpha=0.05, color='gray')\naxes[0].set_xlabel('False Positive Rate (1 - Specificity)')\naxes[0].set_ylabel('True Positive Rate (Sensitivity)')\naxes[0].set_title('ROC Curves: Model Comparison\\n(10-Fold Cross-Validation)', \n                  fontsize=14, fontweight='bold')\naxes[0].legend(loc='lower right', fontsize=11)\naxes[0].set_xlim(-0.01, 1.01)\naxes[0].set_ylim(-0.01, 1.05)\naxes[0].spines['top'].set_visible(False)\naxes[0].spines['right'].set_visible(False)\n\n# Right: AUC comparison bar chart\nnames = [m[0] for m in models]\naucs  = [m[3] for m in models]\naps   = [lr_ap, rf_ap, xgb_ap]\ncolors_bar = [m[2] for m in models]\n\nx = np.arange(len(names))\nwidth = 0.35\nb1 = axes[1].bar(x - width/2, aucs, width, color=colors_bar, alpha=0.85, label='AUC-ROC', edgecolor='white')\nb2 = axes[1].bar(x + width/2, aps,  width, color=colors_bar, alpha=0.45, label='AUC-PR',  edgecolor='white', hatch='//')\n\naxes[1].set_xticks(x)\naxes[1].set_xticklabels(names, rotation=15, ha='right', fontsize=11)\naxes[1].set_ylabel('Score')\naxes[1].set_ylim(0, 1)\naxes[1].set_title('Model Performance Summary\\n(AUC-ROC and Average Precision)', \n                  fontsize=14, fontweight='bold')\naxes[1].legend()\nfor bar, val in zip(list(b1) + list(b2), aucs + aps):\n    axes[1].text(bar.get_x() + bar.get_width()/2, val + 0.01, f'{val:.3f}', \n                 ha='center', fontsize=10)\naxes[1].spines['top'].set_visible(False)\naxes[1].spines['right'].set_visible(False)\n\nplt.tight_layout()\nplt.savefig('figures/Fig8_ROC_curves.png')\nplt.show()\nprint(\"\u2713 Fig 8 saved\")\n",
              "cell_type": "code",
              "file_path": "Readmission_Full_Analysis.ipynb"
            }
          },
          {
            "title": "mcp__Jupyter_MCP_Server__add_cell",
            "kind": "other",
            "raw_input": {
              "cell_type": "code",
              "content": "\n# \u2500\u2500 Fig 9: SHAP summary plot (XGBoost trained on full dataset) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nimport shap\n\n# Refit XGBoost on full dataset for SHAP\nxgb_full = xgb.XGBClassifier(\n    n_estimators=300, max_depth=4, learning_rate=0.05,\n    subsample=0.8, colsample_bytree=0.8,\n    scale_pos_weight=scale_pos,\n    eval_metric='logloss', random_state=42, n_jobs=-1, verbosity=0\n)\nxgb_full.fit(X_ml, y_ml)\n\n# SHAP values\nexplainer   = shap.TreeExplainer(xgb_full)\nshap_values = explainer.shap_values(X_ml)\n\nfeature_labels = [all_labels.get(c, c) for c in ml_cols]\n\nfig, ax = plt.subplots(figsize=(10, 10))\nshap.summary_plot(shap_values, X_ml, feature_names=feature_labels,\n                  show=False, plot_size=None, max_display=20)\nax = plt.gca()\nax.set_title('SHAP Feature Importance (XGBoost)\\nImpact on Readmission Probability', \n             fontsize=15, fontweight='bold', pad=15)\nplt.tight_layout()\nplt.savefig('figures/Fig9_SHAP_summary.png')\nplt.show()\nprint(\"\u2713 Fig 9 saved\")\n",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },
            "status": "completed",
            "raw_output": "(mcp__Jupyter_MCP_Server__add_cell completed with no output)",
            "tool_call_id": "toolu_01Jp25iS8tzMKyJbmicKVNpk"
          },
          {
            "status": "completed",
            "tool_call_id": "toolu_01LuxdmDMdavNDrC1uMNEDtn",
            "raw_input": {
              "cell_type": "code",
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 10: Feature importance \u2014 RF vs XGBoost (side-by-side) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nrf_full = RandomForestClassifier(\n    n_estimators=500, max_depth=6, min_samples_leaf=10,\n    class_weight='balanced', random_state=42, n_jobs=-1\n)\nrf_full.fit(X_ml, y_ml)\n\nrf_imp  = pd.Series(rf_full.feature_importances_,  index=feature_labels).sort_values(ascending=False).head(15)\nxgb_imp = pd.Series(xgb_full.feature_importances_, index=feature_labels).sort_values(ascending=False).head(15)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\n\nfor ax, imp, title, color in [\n    (axes[0], rf_imp,  'Random Forest\\nFeature Importance (Top 15)',  '#4dac26'),\n    (axes[1], xgb_imp, 'XGBoost\\nFeature Importance (Top 15)',         '#d01c8b'),\n]:\n    bars = ax.barh(imp.index[::-1], imp.values[::-1], color=color, alpha=0.8, edgecolor='white')\n    ax.set_xlabel('Importance Score')\n    ax.set_title(title, fontsize=14, fontweight='bold')\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n    for bar, val in zip(bars, imp.values[::-1]):\n        ax.text(val + 0.001, bar.get_y() + bar.get_height()/2,\n                f'{val:.3f}', va='center', fontsize=9)\n\nplt.suptitle('Feature Importance Comparison: ML Models', fontsize=16, fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('figures/Fig10_feature_importance.png')\nplt.show()\nprint(\"\u2713 Fig 10 saved\")\n"
            },
            "title": "mcp__Jupyter_MCP_Server__add_cell",
            "kind": "other",
            "raw_output": "(mcp__Jupyter_MCP_Server__add_cell completed with no output)"
          },
          {
            "raw_output": "(mcp__Jupyter_MCP_Server__add_cell completed with no output)",
            "kind": "other",
            "title": "mcp__Jupyter_MCP_Server__add_cell",
            "status": "completed",
            "raw_input": {
              "cell_type": "code",
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ntop3 = xgb_imp.head(3).index.tolist()\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 5))\nfor ax, feat_label in zip(axes, top3):\n    feat_idx = feature_labels.index(feat_label)\n    shap.dependence_plot(\n        feat_idx, shap_values, X_ml,\n        feature_names=feature_labels,\n        ax=ax, show=False,\n        dot_size=12, alpha=0.4\n    )\n    ax.set_title(f'SHAP Dependence: {feat_label}', fontsize=13, fontweight='bold')\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('SHAP Dependence Plots \u2014 Top 3 XGBoost Predictors', \n             fontsize=15, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig11_SHAP_dependence.png')\nplt.show()\nprint(\"\u2713 Fig 11 saved\")\n"
            },
            "tool_call_id": "toolu_017mUmqHMKFPson8PBL2Xt8x"

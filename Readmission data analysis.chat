r=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\\n\",\n-    \"                xticklabels=[lbl],\\n\",\n-    \"                cbar=(i == n_comp_show - 1),\\n\",\n-    \"                cbar_kws={'label': 'Pearson r with FAMD component'},\\n\",\n-    \"                annot_kws={'size': 8})\\n\",\n-    \"    ax.set_ylabel('')\\n\",\n-    \"    ax.tick_params(axis='y', labelsize=9)\\n\",\n-    \"    ax.tick_params(axis='x', labelsize=10)\\n\",\n+    \"sort_df = loadings_df.copy()\\n\",\n+    \"sort_df['__dom_pc'] = dominant_pc\\n\",\n+    \"sort_df['__dom_abs'] = np.abs(dominant_val)\\n\",\n+    \"sort_df['__dom_order'] = [pc_order[pc] for pc in dominant_pc]\\n\",\n+    \"sort_df = sort_df.sort_values(['__dom_order', '__dom_abs'], ascending=[True, False])\\n\",\n+    \"plot_df = sort_df[loadings_df.columns]\\n\",\n     \"\\n\",\n-    \"for ax in axes[n_comp_show:]:\\n\",\n-    \"    ax.axis('off')\\n\",\n+    \"fig, ax = plt.subplots(figsize=(10.5, max(9, len(plot_df) * 0.35)))\\n\",\n+    \"sns.heatmap(plot_df, annot=True, fmt='.2f', cmap='RdBu_r',\\n\",\n+    \"            center=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\\n\",\n+    \"            xticklabels=pc_col_labels,\\n\",\n+    \"            cbar_kws={'label': 'Pearson r with FAMD component'},\\n\",\n+    \"            annot_kws={'size': 8})\\n\",\n+    \"\\n\",\n+    \"# Draw separators between dominant-PC groups\\n\",\n+    \"group_breaks = np.where(np.diff(sort_df['__dom_order'].values))[0]\\n\",\n+    \"for b in group_breaks:\\n\",\n+    \"    ax.hlines(b + 1, *ax.get_xlim(), colors='black', linewidth=0.8)\\n\",\n     \"\\n\",\n-    \"fig.suptitle('FAMD Component Loadings\\\\n'\\n\",\n-    \"             '(Each component sorted by its own loading; header shows top-loading feature)',\\n\",\n+    \"ax.set_title('FAMD Component Loadings\\\\n'\\n\",\n+    \"             '(Rows grouped by dominant component; within-group sorted by |loading|)',\\n\",\n     \"             fontsize=13, fontweight='bold')\\n\",\n-    \"fig.text(0.02, 0.5, 'Feature', va='center', rotation=90, fontsize=11)\\n\",\n-    \"plt.tight_layout(rect=[0.06, 0, 1, 0.93])\\n\",\n+    \"ax.set_xlabel('FAMD Component  (header = top-loading feature)')\\n\",\n+    \"ax.set_ylabel('Feature')\\n\",\n+    \"ax.tick_params(axis='y', labelsize=9)\\n\",\n+    \"ax.tick_params(axis='x', labelsize=10)\\n\",\n+    \"plt.tight_layout()\\n\",\n     \"plt.savefig('figures/Fig_FAMD_loadings.png')\\n\",\n     \"plt.show()\\n\",\n     \"print(\\\"\u2713 FAMD loadings saved\\\")\\n\",\n"

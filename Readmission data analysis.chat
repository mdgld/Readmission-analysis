to_scale = ['age', 'los_days', 'ace_score', 'n_dsm5_categories', 'complexity_x_age'] model_df[cols_to_scale] = scaler.fit_transform(model_df[cols_to_scale]) ml_cols = feat_cols + [ 'age_x_conduct', 'age_x_asd', 'ace_x_trauma', 'nssi_x_csrss_red', 'complexity_x_age', 'age_x_public_insurance', 'csrss_level' ] # Remove the old binary flags if replaced if 'csrss_any' in ml_cols: ml_cols.remove('csrss_any') if 'nssi_x_csrss' in ml_cols: ml_cols.remove('nssi_x_csrss') \"\"\" # This is complex to inject perfectly via simple string replace. # I will read the specific cell content first to be sure. cell.source = source # with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: # nbformat.write(nb, f) if __name__ == \"__main__\": # update_notebook() pass EOF",

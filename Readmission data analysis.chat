              },
              "structuredContent": {
                "result": "### Cell 15\n\n#### Metadata\n\n```yaml\nexecution_count: 15\ntype: code\n```\n\n#### Source\n\n```python\n\n# \u2500\u2500 ML: prepare feature matrix (same features + interactions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score, roc_curve, average_precision_score\n\nml_cols = all_x_cols   # same features as logistic regression (incl. interactions)\nX_ml = model_df[ml_cols].values\nX_ml_raw = model_df_unscaled[ml_cols].values\ny_ml = model_df['readmitted'].values\n\ncv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n\n# \u2500\u2500 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nrf = RandomForestClassifier(\n    n_estimators=500, max_depth=6, min_samples_leaf=10,\n    class_weight='balanced', random_state=42, n_jobs=-1\n)\nrf_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    rf.fit(X_ml[train_idx], y_ml[train_idx])\n    rf_probs[test_idx] = rf.predict_proba(X_ml[test_idx])[:, 1]\n\nrf_auc  = roc_auc_score(y_ml, rf_probs)\nrf_ap   = average_precision_score(y_ml, rf_probs)\nprint(f\"Random Forest  \u2014 AUC: {rf_auc:.3f}  |  AP: {rf_ap:.3f}\")\n\n# \u2500\u2500 CatBoost \u2014 imbalance-aware, conservative depth \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# All features are numeric floats; no cat_features needed\ncat_model = CatBoostClassifier(\n    iterations=500,\n    depth=4,\n    learning_rate=0.05,\n    auto_class_weights='Balanced',\n    eval_metric='AUC',\n    random_seed=42,\n    verbose=0,\n)\ncat_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    cat_model.fit(X_ml[train_idx], y_ml[train_idx])\n    cat_probs[test_idx] = cat_model.predict_proba(X_ml[test_idx])[:, 1]\n\ncat_auc = roc_auc_score(y_ml, cat_probs)\ncat_ap  = average_precision_score(y_ml, cat_probs)\nprint(f\"CatBoost       \u2014 AUC: {cat_auc:.3f}  |  AP: {cat_ap:.3f}\")\n\n# \u2500\u2500 Logistic regression probabilities (for ROC comparison) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlr_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    X_tr = sm.add_constant(X_ml[train_idx], has_constant='add')\n    X_te = sm.add_constant(X_ml[test_idx],  has_constant='add')\n    m = sm.Logit(y_ml[train_idx], X_tr).fit(disp=0, maxiter=200)\n    lr_probs[test_idx] = m.predict(X_te)\n\nlr_auc = roc_auc_score(y_ml, lr_probs)\nlr_ap  = average_precision_score(y_ml, lr_probs)\nprint(f\"Logistic Regr  \u2014 AUC: {lr_auc:.3f}  |  AP: {lr_ap:.3f}\")\n```\n\n#### Output\n\n```\nRandom Forest  \u2014 AUC: 0.686  |  AP: 0.171\n```\n\n```\nCatBoost       \u2014 AUC: 0.662  |  AP: 0.164\nLogistic Regr  \u2014 AUC: 0.667  |  AP: 0.162\n```"

te (%)')\n    ax.set_ylim(0, (rates.values + err.values).max() * 1.55)\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('Readmission Rates by Demographic & Clinical Characteristics',\n             fontsize=16, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig2_demographics_panel.png')\nplt.show()\nprint(\"\u2713 Fig 2 saved\")```\n\n#### Output\n\n```\n\u001b[31m---------------------------------------------------------------------------\u001b[39m\n\u001b[31mNameError\u001b[39m                                 Traceback (most recent call last)\n\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[3]\u001b[39m\u001b[32m, line 2\u001b[39m\n\u001b[32m      1\u001b[39m \u001b[38;5;66;03m# \u2500\u2500 Fig 2: Demographics panel (gender, insurance, C-SSRS, restraints) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39;00m\n\u001b[32m----> \u001b[39m\u001b[32m2\u001b[39m fig, axes = plt.subplots(\u001b[32m1\u001b[39m, \u001b[32m4\u001b[39m, figsize=(\u001b[32m18\u001b[39m, \u001b[32m5\u001b[39m))\n\u001b[32m      3\u001b[39m \n\u001b[32m      4\u001b[39m binary_vars = [\n\u001b[32m      5\u001b[39m     (\u001b[33m'gender_male'\u001b[39m,      \u001b[33m'Gender ID at Admission'\u001b[39m,       [\u001b[33m'Female'\u001b[39m, \u001b[33m'Male'\u001b[39m]),\n\n\u001b[31mNameError\u001b[39m: name 'plt' is not defined```"

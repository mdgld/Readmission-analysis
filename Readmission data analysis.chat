\n\",\n+    \"    'has_trauma': ('More Trauma', 'Less Trauma'),\\n\",\n+    \"    'has_asd': ('More ASD', 'Less ASD'),\\n\",\n+    \"    'had_restraints': ('More Restraints', 'Less Restraints'),\\n\",\n+    \"}\\n\",\n+    \"\\n\",\n+    \"cluster_names = {}\\n\",\n+    \"for cl in sorted(set(cluster_labels)):\\n\",\n+    \"    if cl == -1:\\n\",\n+    \"        cluster_names[cl] = 'Noise'\\n\",\n+    \"        continue\\n\",\n+    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n+    \"    scores = {}\\n\",\n+    \"    for v in cont_vars:\\n\",\n+    \"        sd = overall_sd.get(v, 0)\\n\",\n+    \"        scores[v] = (sub[v].mean() - overall_mean[v]) / sd if sd and not np.isnan(sd) else 0\\n\",\n+    \"    for v in bin_vars:\\n\",\n+    \"        sd = overall_bin_sd.get(v, 0)\\n\",\n+    \"        scores[v] = (sub[v].mean() - overall_mean[v]) / sd if sd and not np.isnan(sd) else 0\\n\",\n+    \"    top = sorted(scores.items(), key=lambda kv: abs(kv[1]), reverse=True)[:2]\\n\",\n+    \"    labels = []\\n\",\n+    \"    for v, z in top:\\n\",\n+    \"        hi, lo = _name_map[v]\\n\",\n+    \"        labels.append(hi if z >= 0 else lo)\\n\",\n+    \"    cluster_names[cl] = \\\" / \\\".join(labels)\\n\",\n+    \"\\n\",\n     \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"palette_c = plt.cm.tab10.colors\\n\",\n     \"fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n     \"for cl in sorted(set(cluster_labels)):\\n\",\n     \"    mask = cluster_labels == cl\\n\",\n-    \"    lbl  = f'Noise (n={mask.sum()})' if cl == -1 else f'Cluster {cl} (n={mask.sum()})'\\n\",\n+    \"    name = cluster_names.get(cl, f'Cluster {cl}')\\n\",\n+    \"    lbl  = f'Noise (n={mask.s
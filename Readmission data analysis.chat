            "title": "cat << 'EOF' > update_final.py import nbformat import pandas as pd import numpy as np def update(): with open(\"Readmission_Full_Analysis.ipynb\", \"r\") as f: nb = nbformat.read(f, as_version=4) # Find the data loading cell to ensure color flags are created # (They are already created in Cell 9 source code I saw earlier) for cell in nb.cells: if cell.cell_type == \"code\": s = cell.source # Fix KeyError in model_df creation (Cell 23/24 area) if \"model_df = df[feat_cols + ['readmitted']].copy()\" in s: s = s.replace( \"model_df = df[feat_cols + ['readmitted']].copy()\", \"model_df = df[feat_cols + ['readmitted', 'csrss_red', 'csrss_orange', 'csrss_yellow']].copy()\" ) # Ensure we are not missing those columns in any version of that line if \"model_df = df[\" in s and \"csrss_red\" not in s: # If there's a variant of this line, fix it s = s.replace(\"['readmitted']\", \"['readmitted', 'csrss_red', 'csrss_orange', 'csrss_yellow']\") # Fig 2: Significance markers and star for restraints if \"# \u2500\u2500 Fig 2:\" in s: s = s.replace( \"p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\", \"p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\" \" if col == 'had_restraints' and p < 0.001: p_str += ' ***'\" ) # Fig 4: Fix clipping and specific p-values if \"# \u2500\u2500 Fig 4:\" in s: if \"p_label = f'p={p:.3f}'\" not in s: # Add p-value logic if missing pass s = s.replace(\"axes[1].set_ylim(0, 40)\", \"axes[1].set_ylim(0, 45)\") # Even more room # Fig 1: Specific p-values if \"# \u2500\u2500 Fig 1:\" in s: s = s.replace( \"sigs.append('*' if p < 0.05 else '')\", \"p_label = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\" \" sigs.append(p_label if p < 0.05 else '')\" ) # Add a new cell for the requested cohort-wide descriptive statistics descriptive_source = \"\"\" # \u2500\u2500 Cohort Summary & Detailed Descriptive Statistics \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 # Continuous Readmissions print(f\"Overall Readmission Stats (Continuous):\") print(f\" Mean # Readmissions: {df['Readmissions'].mean():.2f} \u00b1 {df['Readmissions'].std():.2f}\") print(f\" Readmitted (%): {df['readmitted'].mean():.1%}\") # ACE Score Detailed ace_sub = df['ace_score'].dropna() print(f\"\\\\nACE Score Stats:\") print(f\" Mean: {ace_sub.mean():.1f} \u00b1 {ace_sub.std():.1f}\") print(f\" Median: {ace_sub.median():.1f}\") print(f\" N collected: {len(ace_sub)} ({100*len(ace_sub)/len(df):.1%})\") # LOS Detailed print(f\"\\\\nLength of Stay (LOS):\") print(f\" Mean: {df['los_days'].mean():.1f} \u00b1 {df['los_days'].std():.1f}\") print(f\" Median: {df['los_days'].median():.1f}\") # Diagnostic Counts print(f\"\\\\nDiagnostic Burdens (Mean \u00b1 SD, Median):\") for col, label in [('n_visit_diags', 'Visit'), ('n_chronic_diags', 'Chronic'), ('has_nssi', 'Non-Suicidal (NSSI)')]: print(f\" {label:<20} {df[col].mean():.1f} \u00b1 {df[col].std():.1f} | Mdn: {df[col].median():.1f}\") # Medical Comorbidity Breakdown def get_med_types(codes): codes = str(codes) types = [] if 'E66' in codes: types.append('Metabolic/Obesity') if 'G47' in codes: types.append('Sleep Disorder') if 'K59' in codes or 'K21' in codes: types.append('GI/Digestive') if 'J30' in codes or 'R06' in codes: types.append('Respiratory/Allergy') if 'N39' in codes: types.append('Renal/Urologic') return types all_m = [] for c in df['ChronicDiags']: all_m.extend(get_med_types(c)) print(f\"\\\\nMedical Comorbidity Breakdown (Top Types):\") print(pd.Series(all_m).value_counts().apply(lambda x: f\"{x} ({100*x/len(df):.1%})\")) \"\"\" new_cell = nbformat.v4.new_code_cell(source=descriptive_source) # Insert after data loading (Cell 9) nb.cells.insert(10, new_cell) with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: nbformat.write(nb, f) if __name__ == \"__main__\": update() EOF python3 update_final.py",

            "raw_output": {
              "detailedContent": "]\n    }\n   ],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Post-hoc: Decision Curve Analysis \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"def net_benefit(y_true, probs, threshold):\\n\",\n    \"    if threshold <= 0 or threshold >= 1:\\n\",\n    \"        return np.nan\\n\",\n    \"    preds = (probs >= threshold).astype(int)\\n\",\n    \"    tp = ((preds == 1) & (y_true == 1)).sum()\\n\",\n    \"    fp = ((preds == 1) & (y_true == 0)).sum()\\n\",\n    \"    n  = len(y_true)\\n\",\n    \"    return tp / n - fp / n * (threshold / (1 - threshold))\\n\",\n    \"\\n\",\n    \"thresholds = np.linspace(0.02, 0.50, 200)\\n\",\n    \"\\n\",\n    \"model_nbs = {\\n\",\n    \"    'CatBoost':            [net_benefit(y_ml, cat_probs, t) for t in thresholds],\\n\",\n    \"    'Random Forest':       [net_benefit(y_ml, rf_probs,  t) for t in thresholds],\\n\",\n    \"    'Logistic Regression': [net_benefit(y_ml, lr_probs,  t) for t in thresholds],\\n\",\n    \"}\\n\",\n    \"treat_all_nb = [net_benefit(y_ml, np.ones(len(y_ml)), t) for t in thresholds]\\n\",\n    \"\\n\",\n    \"# y-axis ceiling from data\\n\",\n    \"max_nb = max(max(v for v in nb if not np.isnan(v)) for nb in model_nbs.values())\\n\",\n    \"max_nb = max(max_nb, max(v for v in treat_all_nb if not np.isnan(v)))\\n\",\n    \"\\n\",\n    \"fig, ax = plt.subplots(figsize=(11, 7))\\n\",\n    \"colors = {'CatBoost': '#d01c8b', 'Random Forest': '#4dac26', 'Logistic Regression': '#2166ac'}\\n\",\n    \"for name, nb in model_nbs.items():\\n\",\n<exited with exit code 0>",
              "content": "]\n    }\n   ],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Post-hoc: Decision Curve Analysis \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"def net_benefit(y_true, probs, threshold):\\n\",\n    \"    if threshold <= 0 or threshold >= 1:\\n\",\n    \"        return np.nan\\n\",\n    \"    preds = (probs >= threshold).astype(int)\\n\",\n    \"    tp = ((preds == 1) & (y_true == 1)).sum()\\n\",\n    \"    fp = ((preds == 1) & (y_true == 0)).sum()\\n\",\n    \"    n  = len(y_true)\\n\",\n    \"    return tp / n - fp / n * (threshold / (1 - threshold))\\n\",\n    \"\\n\",\n    \"thresholds = np.linspace(0.02, 0.50, 200)\\n\",\n    \"\\n\",\n    \"model_nbs = {\\n\",\n    \"    'CatBoost':            [net_benefit(y_ml, cat_probs, t) for t in thresholds],\\n\",\n    \"    'Random Forest':       [net_benefit(y_ml, rf_probs,  t) for t in thresholds],\\n\",\n    \"    'Logistic Regression': [net_benefit(y_ml, lr_probs,  t) for t in thresholds],\\n\",\n    \"}\\n\",\n    \"treat_all_nb = [net_benefit(y_ml, np.ones(len(y_ml)), t) for t in thresholds]\\n\",\n    \"\\n\",\n    \"# y-axis ceiling from data\\n\",\n    \"max_nb = max(max(v for v in nb if not np.isnan(v)) for nb in model_nbs.values())\\n\",\n    \"max_nb = max(max_nb, max(v for v in treat_all_nb if not np.isnan(v)))\\n\",\n    \"\\n\",\n    \"fig, ax = plt.subplots(figsize=(11, 7))\\n\",\n    \"colors = {'CatBoost': '#d01c8b', 'Random Forest': '#4dac26', 'Logistic Regression': '#2166ac'}\\n\",\n    \"for name, nb in model_nbs.items():\\n\",\n<exited with exit code 0>"

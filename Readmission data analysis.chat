\"for ax, (col, title, xlabels) in zip(axes, binary_vars):\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:444:    \"    res  = df.groupby(col)['readmitted'].agg(['mean', 'count'])\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:445:    \"    rates = res['mean'] * 100\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:446:    \"    ns    = res['count']\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:447:    \"    err   = 1.96 * np.sqrt(res['mean'] * (1 - res['mean']) / ns) * 100\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:448:    \"\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:449:    \"    from scipy.stats import chi2_contingency\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:450:    \"    tab = pd.crosstab(df[col], df['readmitted'])\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:451:    \"    _, p, _, _ = chi2_contingency(tab)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:452:    \"    p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:453:    \"    if col == 'had_restraints' and p < 0.001:\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:454:    \"        p_str += ' ***'\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:455:    \"\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:456:    \"    colors = [BLUE, ORANGE]\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:457:    \"    bars = ax.bar(xlabels, rates.values, yerr=err.values, capsize=5,\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:458:    \"                  color=colors, alpha=0.85, edgecolor='white', width=0.5)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:459:    \"\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:460:    \"    # Place label ABOVE the CI cap (rate + err + gap)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:461:    \"    for bar, n, rate, e in zip(bars, ns.values, rates.values, err.values):\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:462:    \"        ax.text(bar.get_x() + bar.get_width() / 2, rate + e + 1.0,\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:463:    \"                f'{rate:.1f}%\\\\n(n={n})', ha='center', va='bottom', fontsize=10)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:464:    \"\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:465:    \"    ax.set_title(f'{title}\\\\n{p_str}', fontsize=12, fontweight='bold')\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:466:    \"    ax.set_ylabel('Readmission Rate (%)')\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:467:    \"    ax.set_ylim(0, (rates.values + err.values).max() * 1.55)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:468:    \"    ax.spines['top'].set_visible(False)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:469:    \"    ax.spines['right'].set_visible(False)\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:470:    \"\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:471:    \"plt.suptitle('Readmission Rates by Demographic & Clinical Characteristics',\\n\",\n /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:472:    \"             fontsize=16, fontweight='bold', y=1.02)\\n\",\n /User
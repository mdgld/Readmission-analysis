            "title": "mcp__Jupyter_MCP_Server__edit_cell",
            "status": "completed",
            "tool_call_id": "toolu_01WTvaAq1r858QA7YwcVqEdW",
            "selected_option_id": "allow"
          },
          {
            "permission_status": "resolved",
            "status": "completed",
            "title": "mcp__Jupyter_MCP_Server__edit_cell",
            "tool_call_id": "toolu_01LKjqpdx9ckjCduWbPU9d7M",
            "kind": "other",
            "raw_input": {
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 8: ROC curves \u2014 LR vs Random Forest vs CatBoost \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 2, figsize=(14, 6))\n\nmodels = [\n    ('Logistic Regression', lr_probs,  '#2166ac', lr_auc),\n    ('Random Forest',       rf_probs,  '#4dac26', rf_auc),\n    ('CatBoost',            cat_probs, '#d01c8b', cat_auc),\n]\n\n# Left: ROC curves\nfor name, probs, color, auc in models:\n    fpr, tpr, _ = roc_curve(y_ml, probs)\n    axes[0].plot(fpr, tpr, color=color, linewidth=2.5, label=f'{name} (AUC = {auc:.3f})')\naxes[0].plot([0, 1], [0, 1], 'k--', linewidth=1, alpha=0.5, label='Random Chance')\naxes[0].fill_between([0, 1], [0, 1], alpha=0.05, color='gray')\naxes[0].set_xlabel('False Positive Rate (1 - Specificity)')\naxes[0].set_ylabel('True Positive Rate (Sensitivity)')\naxes[0].set_title('ROC Curves: Model Comparison\\n(10-Fold Cross-Validation)', \n                  fontsize=14, fontweight='bold')\naxes[0].legend(loc='lower right', fontsize=11)\naxes[0].set_xlim(-0.01, 1.01)\naxes[0].set_ylim(-0.01, 1.05)\naxes[0].spines['top'].set_visible(False)\naxes[0].spines['right'].set_visible(False)\n\n# Right: AUC comparison bar chart\nnames = [m[0] for m in models]\naucs  = [m[3] for m in models]\naps   = [lr_ap, rf_ap, cat_ap]\ncolors_bar = [m[2] for m in models]\n\nx = np.arange(len(names))\nwidth = 0.35\nb1 = axes[1].bar(x - width/2, aucs, width, color=colors_bar, alpha=0.85, label='AUC-ROC', edgecolor='white')\nb2 = axes[1].bar(x + width/2, aps,  width, color=colors_bar, alpha=0.45, label='AUC-PR',  edgecolor='white', hatch='//')\n\naxes[1].set_xticks(x)\naxes[1].set_xticklabels(names, rotation=15, ha='right', fontsize=11)\naxes[1].set_ylabel('Score')\naxes[1].set_ylim(0, 1)\naxes[1].set_title('Model Performance Summary\\n(AUC-ROC and Average Precision)', \n                  fontsize=14, fontweight='bold')\naxes[1].legend()\nfor bar, val in zip(list(b1) + list(b2), aucs + aps):\n    axes[1].text(bar.get_x() + bar.get_width()/2, val + 0.01, f'{val:.3f}', \n                 ha='center', fontsize=10)\naxes[1].spines['top'].set_visible(False)\naxes[1].spines['right'].set_visible(False)\n\nplt.tight_layout()\nplt.savefig('figures/Fig8_ROC_curves.png')\nplt.show()\nprint(\"\u2713 Fig 8 saved\")\n",
              "cell_id": "e4e66113-d9a8-4c30-8846-0560e33af470"
            },
            "raw_output": "{\"success\":true}",

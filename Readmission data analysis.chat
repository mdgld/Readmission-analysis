            "raw_input": {
              "description": "Regenerate final datasets with complete descriptions",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPYTHON'\nimport pandas as pd\nimport numpy as np\n\n# Load complete reference\nref_df = pd.read_csv('ICD10_to_DSM5_Complete_Reference.csv')\n\n# Create quick lookup dictionaries\ncode_to_name = dict(zip(ref_df['ICD_Code'], ref_df['Description']))\ncode_to_dsm5 = dict(zip(ref_df['ICD_Code'], ref_df['DSM5_Category']))\ncode_to_dsm5_code = dict(zip(ref_df['ICD_Code'], ref_df['DSM5_Code']))\n\n# Load patient data\ndf = pd.read_csv(\"With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\n\n# Function to parse and map codes\ndef map_diagnoses(code_string):\n    if pd.isna(code_string):\n        return None, None, None\n    codes = [c.strip() for c in str(code_string).split(',')]\n    names = [code_to_name.get(c, c) for c in codes]\n    dsm5_cats = [code_to_dsm5.get(c) for c in codes]\n    return ';'.join(names), ';'.join([d for d in dsm5_cats if pd.notna(d)]) or None, ';'.join(codes)\n\n# Update annotated data\nprint(\"Updating annotated patient data...\")\nfor col in ['VisitDiags', 'NonSuicidialDiags', 'ChronicDiags']:\n    name_col = f'{col}_Names'\n    dsm5_col = f'{col}_DSM5Categories'\n    \n    df[name_col] = df[col].apply(lambda x: map_diagnoses(x)[0])\n    df[dsm5_col] = df[col].apply(lambda x: map_diagnoses(x)[1])\n\ndf.to_csv('annotated_psychiatric_data_complete.csv', index=False)\nprint(f\"\u2713 Created annotated_psychiatric_data_complete.csv ({len(df)} patients)\")\n\n# Load long-form data and update\nprint(\"\\nUpdating long-form diagnosis data...\")\nlong_form = pd.read_csv('diagnoses_long_form.csv')\nlong_form['diagnosis_description'] = long_form['icd_code'].map(code_to_name)\nlong_form['dsm5_category'] = long_form['icd_code'].map(code_to_dsm5)\nlong_form['dsm5_code'] = long_form['icd_code'].map(code_to_dsm5_code)\n\nlong_form.to_csv('diagnoses_long_form_complete.csv', index=False)\nprint(f\"\u2713 Created diagnoses_long_form_complete.csv ({len(long_form)} diagnosis records)\")\n\n# Generate final summary statistics\nprint(\"\\n\" + \"=\"*70)\nprint(\"FINAL ANALYSIS SUMMARY\")\nprint(\"=\"*70)\n\nprint(f\"\\n\ud83d\udcca DATASET OVERVIEW:\")\nprint(f\"  Total patients: {len(df):,}\")\nprint(f\"  Total diagnosis records: {len(long_form):,}\")\nprint(f\"  Unique ICD-10 codes: {len(ref_df):,}\")\nprint(f\"  All codes with complete descriptions: \u2713 100%\")\n\n# DSM-5 mapping statistics\ndsm5_mapped = long_form[long_form['dsm5_category'].notna()]\nprint(f\"\\n\ud83e\udde0 DSM-5 TR MAPPING:\")\nprint(f\"  Records with DSM-5 diagnoses: {len(dsm5_mapped):,} ({100*len(dsm5_mapped)/len(long_form):.1f}%)\")\nprint(f\"  Unique DSM-5 categories: {dsm5_mapped['dsm5_category'].nunique()}\")\n\n# Top diagnoses\nprint(f\"\\n\ud83d\udd1d TOP 15 DIAGNOSES (by frequency):\")\ntop_diags = ref_df.nlargest(15, 'Frequency')[['ICD_Code', 'Description', 'DSM5_Category', 'Frequency']]\nfor idx, row in top_diags.iterrows():\n    dsm5_str = f\"\u2192 {row['DSM5_Category']}\" if pd.notna(row['DSM5_Category']) else \"\"\n    print(f\"  {row['ICD_Code']:8} {row['Frequency']:4}x  {row['Description'][:45]:45} {dsm5_str}\")\n\n# Readmission analysis\nprint(f\"\\n\ud83d\udcc8 READMISSION ANALYSIS:\")\nreadmitted = df['Readmitted'].sum()\nreadmit_rate = 100 * readmitted / len(df)\nprint(f\"  Readmitted: {readmitted:,} / {len(df):,} ({readmit_rate:.1f}%)\")\n\n# Analyze by DSM-5 category for readmits\nreadmit_by_dsm5 = {}\nfor _, row in long_form.iterrows():\n    if pd.notna(row['dsm5_category']):\n        mrn = row['MRN']\n        cat = row['dsm5_category']\n        readmitted_val = df[df['MRN'] == mrn]['Readmitted'].values\n        if len(readmitted_val) > 0:\n            if cat not in readmit_by_dsm5:\n                readmit_by_dsm5[cat] = {'readmitted': 0, 'total': 0}\n            readmit_by_dsm5[cat]['total'] += 1\n            readmit_by_dsm5[cat]['readmitted'] += int(readmitted_val[0])\n\n# Sort and display\nif readmit_by_dsm5:\n    sorted_dsm5 = sorted(readmit_by_dsm5.items(), \n                         key=lambda x: x[1]['readmitted']/max(x[1]['total'], 1), \n                         reverse=True)\n    print(f\"\\n  Top readmission risk by DSM-5 category:\")\n    for cat, stats in sorted_dsm5[:10]:\n        rate = 100 * stats['readmitted'] / max(stats['total'], 1)\n        print(f\"    {cat[:45]:45} {rate:5.1f}% ({stats['readmitted']}/{stats['total']})\")\n\nprint(f\"\\n\u2705 ANALYSIS COMPLETE\")\nprint(f\"  All files have been updated with complete ICD-10 descriptions\")\nprint(f\"  Ready for trends and associations analysis!\")\n\nEOFPYTHON\n"
            },

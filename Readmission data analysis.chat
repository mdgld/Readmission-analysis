            "raw_input": {
              "description": "Rebuild complete reference with all descriptions",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPYTHON'\nimport json\nimport pandas as pd\nimport pickle\n\n# Load the comprehensive ICD descriptions\nwith open('icd_descriptions_full.json', 'r') as f:\n    descriptions = json.load(f)\n\n# Load the old reference with DSM-5 mappings\nwith open('comprehensive_icd_ref.pkl', 'rb') as f:\n    old_ref = pickle.load(f)\n\n# Load the psychiatric codes we already have\nold_df = pd.read_csv('ICD10_to_DSM5_Reference.csv')\n\n# Get all unique codes from dataset\ndiag_long = pd.read_csv('diagnoses_long_form.csv')\nall_codes = sorted(diag_long['icd_code'].unique())\n\nprint(f\"Total codes in dataset: {len(all_codes)}\")\n\n# Build comprehensive mapping\nnew_ref = {}\nfor code in all_codes:\n    # First check if we have a description\n    if code in descriptions:\n        name = descriptions[code]\n    elif code in old_ref:\n        name = old_ref[code].get('name', f'{code}')\n    else:\n        name = f'{code}'\n    \n    # Get DSM-5 mapping from old reference\n    if code in old_ref and old_ref[code].get('dsm5_code'):\n        dsm5 = old_ref[code].get('dsm5_category')\n        dsm5_code = old_ref[code].get('dsm5_code')\n    else:\n        dsm5 = None\n        dsm5_code = None\n    \n    # Get category\n    if code in old_ref:\n        category = old_ref[code].get('category', 'Unclassified')\n    else:\n        category = _categorize(code)\n    \n    new_ref[code] = {\n        'name': name,\n        'category': category,\n        'dsm5': dsm5,\n        'dsm5_code': dsm5_code,\n    }\n\ndef _categorize(code):\n    if code.startswith('F'):\n        return 'Psychiatric'\n    elif code.startswith('A') or code.startswith('B'):\n        return 'Infectious Disease'\n    elif code.startswith('E'):\n        return 'Endocrine/Metabolic'\n    elif code.startswith('G'):\n        return 'Neurological'\n    elif code.startswith('H'):\n        return 'Eye/Ear'\n    elif code.startswith('K'):\n        return 'GI'\n    elif code.startswith('N'):\n        return 'Genitourinary'\n    elif code.startswith('R'):\n        return 'Symptoms/Signs'\n    elif code.startswith('Z'):\n        return 'Status/Social'\n    else:\n        return 'Medical'\n\n# Convert to CSV\nrows = []\nfor code, info in sorted(new_ref.items()):\n    rows.append({\n        'ICD_Code': code,\n        'Description': info['name'],\n        'Category': info['category'],\n        'DSM5_Category': info['dsm5'],\n        'DSM5_Code': info['dsm5_code'],\n        'Frequency': (diag_long['icd_code'] == code).sum(),\n    })\n\ndf = pd.DataFrame(rows)\ndf = df.sort_values('Frequency', ascending=False)\ndf.to_csv('ICD10_to_DSM5_Complete_Reference.csv', index=False)\n\nprint(f\"\\nCreated complete reference: {len(df)} codes\")\nprint(f\"Codes with DSM-5 mapping: {df['DSM5_Category'].notna().sum()}\")\nprint(f\"\\nSample of newly filled codes:\")\nsample = df[~df['Description'].str.contains('\\[Requires', na=True)].head(10)\nprint(sample[['ICD_Code', 'Description', 'DSM5_Category', 'Frequency']].to_string())\n\nEOFPYTHON\n"
            },

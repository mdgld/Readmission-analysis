            "raw_output": {
              "content": [
                {
                  "type": "text",
                  "text": "### Cell 26\n\n#### Metadata\n\n```yaml\nexecution_count: 13\ntype: code\n```\n\n#### Source\n\n```python\n\n# \u2500\u2500 Fig 14: Burden vs Benefit \u2014 all models, extended thresholds \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nmodel_configs = [\n    ('CatBoost',            cat_probs, '#d01c8b', 0.65),\n    ('Random Forest',       rf_probs,  '#4dac26', 0.60),\n    ('Logistic Regression', lr_probs,  '#2166ac', 0.50),\n]\n\nn_total = len(y_ml)\nn_pos   = y_ml.sum()\n\ndef threshold_metrics(y_true, probs, threshold):\n    preds = (probs >= threshold).astype(int)\n    tn, fp, fn, tp = confusion_matrix(y_true, preds).ravel()\n    sensitivity = 100 * tp / (tp + fn) if (tp + fn) > 0 else 0\n    ppv = 100 * tp / (tp + fp) if (tp + fp) > 0 else 0\n    return tn, fp, fn, tp, sensitivity, ppv\n\ndef fp_fn_crossover(y_true, probs, max_thresh):\n    candidate_thresholds = np.unique(\n        np.r_[\n            np.linspace(0.01, max_thresh, 400),\n            probs[(probs >= 0.01) & (probs <= max_thresh)],\n        ]\n    )\n    rows = []\n    for t in candidate_thresholds:\n        tn, fp, fn, tp, sensitivity, ppv = threshold_metrics(y_true, probs, t)\n        rows.append((abs(fp - fn), t, tn, fp, fn, tp, sensitivity, ppv))\n    return min(rows, key=lambda row: (row[0], row[1]))\n\nfig, axes = plt.subplots(2, 3, figsize=(21, 12))\ncrossover_rows = []\n\nfor col, (name, probs, color, max_thresh) in enumerate(model_configs):\n    # Compute crossover over all observed probability cut points plus a fine grid.\n    diff, crossover_t, tn_c, fp_c, fn_c, tp_c, sens_c, ppv_c = fp_fn_crossover(y_ml, probs, max_thresh)\n    crossover_rows.append({\n        'Model': name,\n        'Threshold': crossover_t,\n        'FP': fp_c,\n        'FN': fn_c,\n        'Sensitivity': sens_c,\n        'PPV': ppv_c,\n    })\n\n    # Threshold grid up to max_thresh\n    base_ts = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]\n    extra   = [t for t in [0.55, 0.60, 0.65] if t <= max_thresh]\n    key_ts  = base_ts + extra\n\n    flag_pcts, sensitivities, ppvs, n_flagged_list = [], [], [], []\n    for t in key_ts:\n        tn, fp, fn, tp, sensitivity, ppv = threshold_metrics(y_ml, probs, t)\n        n_flag = fp + tp\n        flag_pcts.append(100 * n_flag / n_total)\n        n_flagged_list.append(n_flag)\n        sensitivities.append(sensitivity)\n        ppvs.append(ppv)\n\n    xlabels = [f'{int(t*100)}%' for t in key_ts]\n    x_pos   = np.arange(len(key_ts))\n\n    # Crossover position in bar/line space using continuous interpolation.\n    crossover_x = np.interp(crossover_t, key_ts, x_pos) if key_ts[0] <= crossover_t <= key_ts[-1] else None\n    crossover_label = f't={crossover_t:.3f}\\nSens={sens_c:.1f}%\\nPPV={ppv_c:.1f}%'\n    fp_fn_label = 'FP=FN' if fp_c == fn_c else f'closest FP/FN ({fp_c}/{fn_c})'\n\n    # \u2500\u2500 Row 0: % flagged \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    ax0 = axes[0, col]\n    bars = ax0.bar(x_pos, flag_pcts, color=color, alpha=0.75, edgecolor='white')\n    ax0.axhline(100 * n_pos / n_total, color='black', linestyle='--', linewidth=1.5,\n                label=f'Actual rate ({100*n_pos/n_total:.1f}%)')\n    if crossover_x is not None:\n        ax0.axvline(crossover_x, color='purple', linestyle=':', linewidth=2,\n                    label=f'{fp_fn_label} at t={crossover_t:.3f}')\n    ax0.set_xticks(x_pos)\n    ax0.set_xticklabels(xlabels, rotation=30, ha='right', fontsize=9)\n    for bar, pct in zip(bars, flag_pcts):\n        ax0.text(bar.get_x() + bar.get_width() / 2, pct + 0.4,\n                 f'{pct:.0f}%', ha='center', fontsize=8, fontweight='bold')\n    ax0.set_ylabel('% Charts Flagged')\n    ax0.set_title(f'{name}\\n% of Charts Flagged', fontsize=12, fontweight='bold')\n    ax0.legend(fontsize=8)\n    ax0.spines['top'].set_visible(False)\n    ax0.spines['right'].set_visible(False)\n\n    # \u2500\u2500 Row 1: Sensitivity & PPV \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    ax1 = axes[1, col]\n    ax1.plot(x_pos, sensitivities, 'o-', color=BLUE,  linewidth=2.5, markersize=7,\n             label='Sensitivity (readmissions caught)')\n    ax1.plot(x_pos, ppvs,          's--', color=color, linewidth=2.5, markersize=7,\n             label='PPV (precision)')\n    if crossover_x is not None:\n        ax1.axvline(crossover_x, color='purple', linestyle=':', linewidth=2,\n                    label=f'{fp_fn_label} at t={crossover_t:.3f}')\n        ax1.text(crossover_x, 108, crossover_label, ha='center', va='top',\n                 fontsize=8, color='purple', fontweight='bold',\n                 bbox=dict(facecolor='white', edgecolor='purple', alpha=0.85, pad=2))\n    # Annotate every other point to avoid crowding\n    for i, (s, p) in enumerate(zip(sensitivities, ppvs)):\n        if i % 2 == 0:\n            ax1.text(i, min(s + 3, 108), f'{s:.0f}%', ha='center', fontsize=8, color=BLUE)\n            ax1.text(i, max(p - 6, 1),   f'{p:.0f}%', ha='center', fontsize=8, color=color)\n    ax1.set_xticks(x_pos)\n    ax1.set_xticklabels(xlabels, rotation=30, ha='right', fontsize=9)\n    ax1.set_ylabel('%')\n    ax1.set_ylim(0, 115)\n    ax1.set_title(f'{name}\\nSensitivity & PPV', fontsize=12, fontweight='bold')\n    ax1.legend(fontsize=8)\n    ax1.spines['top'].set_visible(False)\n    ax1.spines['right'].set_visible(False)\n\nplt.suptitle('Clinical Flagging Burden vs. Benefit \u2014 All Models\\n'\n             f'(10-Fold CV, n={n_total:,}; purple dotted line = FP/FN crossover threshold)',\n             fontsize=14, fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('figures/Fig14_flagging_thresholds.png')\nplt.show()\n\ncrossover_df = pd.DataFrame(crossover_rows)\ncrossover_df.to_csv('figures/Fig14_fp_fn_crossover_metrics.csv', index=False)\nprint(\"\u2713 Fig 14 saved\")\nprint(\"\\nFP/FN crossover metrics:\")\nprint(crossover_df.to_string(index=False, formatters={\n    'Threshold': lambda x: f'{x:.4f}',\n    'Sensitivity': lambda x: f'{x:.2f}%',\n    'PPV': lambda x: f'{x:.2f}%',\n}))```\n\n#### Output\n\n```\n<Figure size 3150x1800 with 6 Axes>```\n\n```\n\u2713 Fig 14 saved\n\nFP/FN crossover metrics:\n              Model Threshold  FP  FN Sensitivity    PPV\n           CatBoost    0.6356 195 195      20.73% 20.73%\n      Random Forest    0.5747 195 195      20.73% 20.73%\nLogistic Regression    0.1830 197 197      19.92% 19.92%\n```"

            ],
            "raw_input": {
              "cell_id": "86617da0-0a0f-42ca-8c19-4766295dcb6e",
              "content": "\n# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 CatBoost predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Manual scatter avoids shap.dependence_plot's internal jitter and gives\n# full axis control.  Negative x-values, if present, reflect actual data\n# quality issues in the source (e.g., DischDate < VisitDate \u2192 negative LOS);\n# those records are flagged below.\ntop3 = cat_imp.head(3).index.tolist()\n\n# Warn about negative feature values\nfor feat_label in top3:\n    feat_idx = feature_labels.index(feat_label)\n    neg_n = (X_ml[:, feat_idx] < 0).sum()\n    if neg_n > 0:\n        print(f\"  \u26a0  {feat_label}: {neg_n} records have negative values \"\n              f\"(min={X_ml[:, feat_idx].min():.1f}) \u2014 likely data-entry errors in source.\")\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 5))\nfor ax, feat_label in zip(axes, top3):\n    feat_idx  = feature_labels.index(feat_label)\n    feat_vals = X_ml[:, feat_idx].copy()\n    shap_vals = shap_values[:, feat_idx]\n\n    c_vals = [ORANGE if y == 1 else BLUE for y in y_ml]\n    ax.scatter(feat_vals, shap_vals, c=c_vals, alpha=0.25, s=12, rasterized=True)\n    ax.axhline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.7)\n\n    # Running-mean trend\n    sort_idx = np.argsort(feat_vals)\n    xs = feat_vals[sort_idx]\n    ys = shap_vals[sort_idx]\n    win = max(60, len(xs) // 15)\n    y_smooth = np.convolve(ys, np.ones(win) / win, mode='valid')\n    x_smooth = xs[win // 2: win // 2 + len(y_smooth)]\n    ax.plot(x_smooth, y_smooth, 'k-', linewidth=2.2, alpha=0.85)\n\n    ax.set_xlabel(f'{feat_label}\\n(feature value)', fontsize=10)\n    ax.set_ylabel('SHAP value\\n(+ raises readmission risk)', fontsize=9)\n    ax.set_title(f'SHAP Dependence: {feat_label}', fontsize=13, fontweight='bold')\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\n    from matplotlib.lines import Line2D\n    handles = [\n        Line2D([0],[0], marker='o', color='w', markerfacecolor=ORANGE, markersize=8, label='Readmitted'),\n        Line2D([0],[0], marker='o', color='w', markerfacecolor=BLUE,   markersize=8, label='Not Readmitted'),\n        Line2D([0],[0], color='black', linewidth=2, label='Trend'),\n    ]\n    ax.legend(handles=handles, fontsize=8, loc='upper right')\n\nplt.suptitle('SHAP Dependence Plots \u2014 Top 3 CatBoost Predictors\\n'\n             '(x = feature value; y = contribution to readmission log-odds)',\n             fontsize=14, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig11_SHAP_dependence.png')\nplt.show()\nprint(\"\u2713 Fig 11 saved\")\n",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6",

            "title": "cat << 'EOF' > update_thresholds.py import nbformat def update_thresholds(): with open(\"Readmission_Full_Analysis.ipynb\", \"r\") as f: nb = nbformat.read(f, as_version=4) for cell in nb.cells: if cell.cell_type == \"code\": s = cell.source # Fig 13/14 Refactoring to loop over models if \"# \u2500\u2500 Fig 13:\" in s: s = \"\"\" # \u2500\u2500 Fig 13 & 14: Clinical Burden/Benefit for all models \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 model_results = [ ('CatBoost', cat_probs), ('Random Forest', rf_probs), ('Logistic Regression', lr_probs) ] for name, probs in model_results: # \u2500\u2500 FP vs FN (Fig 13 style) thresholds = np.linspace(0.01, 0.99, 300) fp_counts, fn_counts = [], [] for thresh in thresholds: preds = (probs >= thresh).astype(int) tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel() fp_counts.append(fp) fn_counts.append(fn) # Calculate crossover crossover_idx = np.argmin(np.abs(np.array(fp_counts) - np.array(fn_counts))) crossover_t = thresholds[crossover_idx] fig, axes = plt.subplots(1, 2, figsize=(16, 6)) axes[0].plot(thresholds, fp_counts, color='#e74c3c', label='False Positives') axes[0].plot(thresholds, fn_counts, color='#3498db', label='False Negatives') axes[0].axvline(crossover_t, color='purple', linestyle=':', label=f'Crossover (t={crossover_t:.2f})') axes[0].set_title(f'{name}: FP vs FN') axes[0].legend() # \u2500\u2500 Clinical Burden (Fig 14 style) - limited to crossover_t key_ts = [t for t in [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50] if t <= crossover_t] if not key_ts: key_ts = [0.05, 0.10] flag_pcts, sens = [], [] for t in key_ts: preds = (probs >= t).astype(int) flag_pcts.append(100 * preds.sum() / len(y_ml)) tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel() sens.append(100 * tp / (tp + fn)) axes[1].plot(key_ts, flag_pcts, 's-', label='% Flagged') axes[1].plot(key_ts, sens, 'o-', label='Sensitivity') axes[1].set_title(f'{name}: Burden vs Benefit') axes[1].set_xlabel('Probability Threshold') axes[1].legend() plt.suptitle(f'Decision Support Metrics: {name}') plt.tight_layout() plt.savefig(f'figures/Decision_Support_{name.replace(\" \", \"_\")}.png') plt.show() \"\"\" cell.source = s with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: nbformat.write(nb, f) if __name__ == \"__main__\": update_thresholds() EOF python3 update_thresholds.py",

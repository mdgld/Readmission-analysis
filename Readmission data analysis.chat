              "file_path": "Readmission_Full_Analysis.ipynb",
              "cell_type": "code",
              "content": "\n# \u2500\u2500 Post-hoc: SHAP Interaction Values (CatBoost, n=400 sample) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nnp.random.seed(42)\nsample_n   = min(400, len(X_ml))\nsample_idx = np.random.choice(len(X_ml), sample_n, replace=False)\n\nprint(f\"Computing SHAP interaction values on {sample_n} samples\u2026\")\ninteract_explainer = shap.TreeExplainer(cat_full)\nshap_interact      = interact_explainer.shap_interaction_values(X_ml[sample_idx])\n# shape: (n_samples, n_features, n_features)\n\nmean_interact = np.abs(shap_interact).mean(axis=0)\nnp.fill_diagonal(mean_interact, 0)   # zero diagonal for clarity\n\n# \u2500\u2500 Heatmap \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Keep labels concise\nshort_labels = [l.replace('Diagnostic Complexity \u00d7 Age', 'Complexity\u00d7Age')\n                 .replace('ACE Score \u00d7 Trauma/PTSD', 'ACE\u00d7Trauma')\n                 .replace('NSSI \u00d7 C-SSRS Flag', 'NSSI\u00d7CSSRS')\n                 .replace('Age \u00d7 Conduct Disorder', 'Age\u00d7Conduct')\n                 .replace('Age \u00d7 ASD', 'Age\u00d7ASD')\n                 .replace('Length of Stay (days)', 'LOS')\n                 .replace('# DSM-5 Categories', '#DSM5 Cats')\n                 .replace('Physical Restraints', 'Restraints')\n                 .replace('Medical Comorbidity', 'Med. Comorbidity')\n                 .replace('Public Insurance (AHCCCS)', 'Public Ins.')\n                 for l in feature_labels]\n\n# Show top 15\u00d715 by total interaction magnitude\ntotal_interact = mean_interact.sum(axis=0) + mean_interact.sum(axis=1)\ntop15_idx      = np.argsort(total_interact)[-15:]\nsub_interact   = mean_interact[np.ix_(top15_idx, top15_idx)]\nsub_labels     = [short_labels[i] for i in top15_idx]\n\nfig, ax = plt.subplots(figsize=(11, 9))\nsns.heatmap(sub_interact, xticklabels=sub_labels, yticklabels=sub_labels,\n            cmap='YlOrRd', ax=ax, linewidths=0.3, annot=False,\n            cbar_kws={'label': 'Mean |SHAP interaction value|'})\nax.set_title('CatBoost SHAP Interaction Values (Top 15 Features by Interaction Magnitude)\\n'\n             f'(n={sample_n} sample)', fontsize=13, fontweight='bold')\nplt.xticks(rotation=45, ha='right', fontsize=9)\nplt.yticks(fontsize=9)\nplt.tight_layout()\nplt.savefig('figures/Fig_SHAP_interactions.png')\nplt.show()\n\n# Print top 10 feature pairs\ninteract_pairs = []\nfor i in range(len(feature_labels)):\n    for j in range(i+1, len(feature_labels)):\n        interact_pairs.append((mean_interact[i, j], feature_labels[i], feature_labels[j]))\ninteract_pairs.sort(reverse=True)\nprint(\"\\nTop 10 SHAP interaction pairs (CatBoost):\")\nfor val, f1, f2 in interact_pairs[:10]:\n    print(f\"  {f1:<35} \u00d7 {f2:<35}  {val:.5f}\")\nprint(\"\u2713 SHAP interactions saved\")\n"
            },

            "title": "cat << 'EOF' > finalize_analysis.py import nbformat import numpy as np import pandas as pd def finalize(): with open(\"Readmission_Full_Analysis.ipynb\", \"r\") as f: nb = nbformat.read(f, as_version=4) for cell in nb.cells: if cell.cell_type == \"code\": s = cell.source # 1. Fix KeyError: 'csrss_red' in model_df creation if \"model_df = df[feat_cols + ['readmitted']].copy()\" in s: s = s.replace( \"model_df = df[feat_cols + ['readmitted']].copy()\", \"model_df = df[feat_cols + ['readmitted', 'csrss_red', 'csrss_orange', 'csrss_yellow']].copy()\" ) # 2. Comprehensive Descriptive Stats (Table 1 Update) if \"# \u2500\u2500 Table 1:\" in s: s = \"\"\" # \u2500\u2500 Table 1: Detailed Descriptive Statistics \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 from scipy.stats import ttest_ind, chi2_contingency def get_stats(vals, total, is_ra=False): r = {} r['N (%)'] = f\"{len(vals)} ({100*len(vals)/total:.1f}%)\" # Readmissions r['# Readmissions, mean\u00b1SD'] = f\"{vals['Readmissions'].mean():.2f} \u00b1 {vals['Readmissions'].std():.2f}\" # ACE Score ace_n = vals['ace_score'].notna().sum() r['ACE score collected, n(%)'] = f\"{ace_n} ({100*ace_n/len(vals):.1f}%)\" r['ACE score, mean\u00b1SD'] = f\"{vals['ace_score'].mean():.1f} \u00b1 {vals['ace_score'].std():.1f}\" r['ACE score, median'] = f\"{vals['ace_score'].median():.1f}\" # LOS r['LOS, mean\u00b1SD'] = f\"{vals['los_days'].mean():.1f} \u00b1 {vals['los_days'].std():.1f}\" r['LOS, median'] = f\"{vals['los_days'].median():.1f}\" # Diagnoses r['# Visit diags, mean\u00b1SD'] = f\"{vals['n_visit_diags'].mean():.1f} \u00b1 {vals['n_visit_diags'].std():.1f}\" r['# Visit diags, median'] = f\"{vals['n_visit_diags'].median():.1f}\" r['# Chronic diags, mean\u00b1SD'] = f\"{vals['n_chronic_diags'].mean():.1f} \u00b1 {vals['n_chronic_diags'].std():.1f}\" r['# Chronic diags, median'] = f\"{vals['n_chronic_diags'].median():.1f}\" r['# NSSI diags, mean\u00b1SD'] = f\"{vals['has_nssi'].mean():.1f} \u00b1 {vals['has_nssi'].std():.1f}\" # Since binary # Medical Comorbidity breakdown # Mapping logic for major types def get_med_types(row): codes = str(row['ChronicDiags']) types = [] if 'E66' in codes: types.append('Metabolic/Obesity') if 'G47' in codes: types.append('Sleep Disorder') if 'K59' in codes or 'K21' in codes: types.append('GI/Digestive') if 'J30' in codes or 'R06' in codes: types.append('Respiratory/Allergy') if 'N39' in codes: types.append('Renal/Urologic') return types med_types = vals.apply(get_med_types, axis=1) all_types = [t for sublist in med_types for t in sublist] type_counts = pd.Series(all_types).value_counts() for t, count in type_counts.items(): r[f'Medical: {t}, n(%)'] = f\"{count} ({100*count/len(vals):.1f}%)\" return r ra = df[df['readmitted'] == 1] nra = df[df['readmitted'] == 0] total_n = len(df) table1_data = { 'Not Readmitted': get_stats(nra, total_n), 'Readmitted': get_stats(ra, total_n) } table1 = pd.DataFrame(table1_data).T table1.to_csv('figures/Table1_descriptive.csv') print(table1.to_string()) \"\"\" # 3. Visualization Refinements # Fig 2: Physical Restraints p<0.001 star and p-values for all if \"# \u2500\u2500 Fig 2:\" in s: s = s.replace( \"p_str = f'(p={p:.3f})' if p >= 0.001 else '(p<0.001)'\", \"p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\" \" if col == 'had_restraints' and p < 0.001: p_str += ' ***'\" ) # Fig 4: Fix clipping and specific p-values if \"# \u2500\u2500 Fig 4:\" in s: s = s.replace( \"axes[1].text(bar.get_x() + bar.get_width()/2, row['rate'] * 100 + ci[row.name]*100 + 1, sig_str, color='red', ha='center')\", \"_, p = proportions_ztest(row['rate']*row['n'], row['n'], value=q1_rate) if row.name > 0 else (0, 1)\\n\" \" p_label = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\" \" if row.name > 0 and p < 0.05:\\n\" \" axes[1].text(bar.get_x() + bar.get_width()/2, row['rate'] * 100 + ci[row.name]*100 + 2, p_label, color='red', ha='center', fontsize=9)\" ) s = s.replace(\"axes[1].set_ylim(0, max(q_rate['rate'] * 100) * 1.3)\", \"axes[1].set_ylim(0, 40)\") # Fix clipping # 4. Standardizing significance indicators across all charts if \"sigs.append('*' if p < 0.05 else '')\" in s: s = s.replace( \"sigs.append('*' if p < 0.05 else '')\", \"p_label = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\" \" sigs.append(p_label if p < 0.05 else '')\" ) cell.source = s with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: nbformat.write(nb, f) if __name__ == \"__main__\": finalize() EOF python3 finalize_analysis.py",

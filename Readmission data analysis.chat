            "raw_output": {
              "detailedContent": "\"# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 CatBoost predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"# Manual scatter avoids shap.dependence_plot's internal jitter and gives\\n\",\n    \"# full axis control.  Negative x-values, if present, reflect actual data\\n\",\n    \"# quality issues in the source (e.g., DischDate < VisitDate \u2192 negative LOS);\\n\",\n    \"# those records are flagged below.\\n\",\n    \"top3 = cat_imp.head(3).index.tolist()\\n\",\n    \"\\n\",\n    \"# Warn about negative feature values\\n\",\n    \"for feat_label in top3:\\n\",\n    \"    feat_idx = feature_labels.index(feat_label)\\n\",\n    \"    neg_n = (X_ml[:, feat_idx] < 0).sum()\\n\",\n    \"    if neg_n > 0:\\n\",\n    \"        print(f\\\"  \u26a0  {feat_label}: {neg_n} records have negative values \\\"\\n\",\n    \"              f\\\"(min={X_ml[:, feat_idx].min():.1f}) \u2014 likely data-entry errors in source.\\\")\\n\",\n    \"\\n\",\n    \"fig, axes = plt.subplots(1, 3, figsize=(18, 5))\\n\",\n    \"for ax, feat_label in zip(axes, top3):\\n\",\n    \"    feat_idx  = feature_labels.index(feat_label)\\n\",\n    \"    feat_vals = X_ml[:, feat_idx].copy()\\n\",\n    \"    shap_vals = shap_values[:, feat_idx]\\n\",\n    \"\\n\",\n    \"    c_vals = [ORANGE if y == 1 else BLUE for y in y_ml]\\n\",\n    \"    ax.scatter(feat_vals, shap_vals, c=c_vals, alpha=0.25, s=12, rasterized=True)\\n\",\n    \"    ax.axhline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.7)\\n\",\n    \"\\n\",\n    \"    # Running-mean trend\\n\",\n    \"    sort_idx = np.argsort(feat_vals)\\n\",\n    \"    xs = feat_vals[sort_idx]\\n\",\n    \"    ys = shap_vals[sort_idx]\\n\",\n    \"    win = max(60, len(xs) // 15)\\n\",\n    \"    y_smooth = np.convolve(ys, np.ones(win) / win, mode='valid')\\n\",\n    \"    x_smooth = xs[win // 2: win // 2 + len(y_smooth)]\\n\",\n    \"    ax.plot(x_smooth, y_smooth, 'k-', linewidth=2.2, alpha=0.85)\\n\",\n    \"\\n\",\n    \"    ax.set_xlabel(f'{feat_label}\\\\n(feature value)', fontsize=10)\\n\",\n    \"    ax.set_ylabel('SHAP value\\\\n(+ raises readmission risk)', fontsize=9)\\n\",\n    \"    ax.set_title(f'SHAP Dependence: {feat_label}', fontsize=13, fontweight='bold')\\n\",\n    \"    ax.spines['top'].set_visible(False)\\n\",\n    \"    ax.spines['right'].set_visible(False)\\n\",\n    \"\\n\",\n    \"    from matplotlib.lines import Line2D\\n\",\n    \"    handles = [\\n\",\n    \"        Line2D([0],[0], marker='o', color='w', markerfacecolor=ORANGE, markersize=8, label='Readmitted'),\\n\",\n    \"        Line2D([0],[0], marker='o', color='w', markerfacecolor=BLUE,   markersize=8, label='Not Readmitted'),\\n\",\n<exited with exit code 0>",
              "content": "\"# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 CatBoost predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"# Manual scatter avoids shap.dependence_plot's internal jitter and gives\\n\",\n    \"# full axis control.  Negative x-values, if present, reflect actual data\\n\",\n    \"# quality issues in the source (e.g., DischDate < VisitDate \u2192 negative LOS);\\n\",\n    \"# those records are flagged below.\\n\",\n    \"top3 = cat_imp.head(3).index.tolist()\\n\",\n    \"\\n\",\n    \"# Warn about negative feature values\\n\",\n    \"for feat_label in top3:\\n\",\n    \"    feat_idx = feature_labels.index(feat_label)\\n\",\n    \"    neg_n = (X_ml[:, feat_idx] < 0).sum()\\n\",\n    \"    if neg_n > 0:\\n\",\n    \"        print(f\\\"  \u26a0  {feat_label}: {neg_n} records have negative values \\\"\\n\",\n    \"              f\\\"(min={X_ml[:, feat_idx].min():.1f}) \u2014 likely data-entry errors in source.\\\")\\n\",\n    \"\\n\",\n    \"fig, axes = plt.subplots(1, 3, figsize=(18, 5))\\n\",\n    \"for ax, feat_label in zip(axes, top3):\\n\",\n    \"    feat_idx  = feature_labels.index(feat_label)\\n\",\n    \"    feat_vals = X_ml[:, feat_idx].copy()\\n\",\n    \"    shap_vals = shap_values[:, feat_idx]\\n\",\n    \"\\n\",\n    \"    c_vals = [ORANGE if y == 1 else BLUE for y in y_ml]\\n\",\n    \"    ax.scatter(feat_vals, shap_vals, c=c_vals, alpha=0.25, s=12, rasterized=True)\\n\",\n    \"    ax.axhline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.7)\\n\",\n    \"\\n\",\n    \"    # Running-mean trend\\n\",\n    \"    sort_idx = np.argsort(feat_vals)\\n\",\n    \"    xs = feat_vals[sort_idx]\\n\",\n    \"    ys = shap_vals[sort_idx]\\n\",\n    \"    win = max(60, len(xs) // 15)\\n\",\n    \"    y_smooth = np.convolve(ys, np.ones(win) / win, mode='valid')\\n\",\n    \"    x_smooth = xs[win // 2: win // 2 + len(y_smooth)]\\n\",\n    \"    ax.plot(x_smo
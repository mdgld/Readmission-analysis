              "cell_id": "4dfd8916-95c7-48e4-96b6-68b06d869438",
              "cell_type": "code",
              "content": "\n# \u2500\u2500 Post-hoc: FAMD Component Loadings Heatmap \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# column_correlations_ gives Pearson r between each feature and each FAMD component\nloadings = famd.column_correlations_   # DataFrame: features \u00d7 components\n\n# Keep only numeric-feature rows and first 6 components (most interpretable)\nn_comp_show  = min(6, loadings.shape[1])\nload_display = loadings.iloc[:, :n_comp_show].copy()\nload_display.columns = [f'PC{i+1}' for i in range(n_comp_show)]\n\n# Sort features by absolute loading on PC1 for readability\nload_display = load_display.reindex(\n    load_display['PC1'].abs().sort_values(ascending=False).index\n)\n\nfig, ax = plt.subplots(figsize=(10, max(8, len(load_display) * 0.35)))\nsns.heatmap(load_display.astype(float), annot=True, fmt='.2f', cmap='RdBu_r',\n            center=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\n            cbar_kws={'label': 'Correlation with FAMD component'})\nax.set_title('FAMD Component Loadings\\n(Pearson r \u2014 rows sorted by |PC1| loading)',\n             fontsize=14, fontweight='bold')\nax.set_xlabel('FAMD Component')\nax.set_ylabel('Feature')\nplt.tight_layout()\nplt.savefig('figures/Fig_FAMD_loadings.png')\nplt.show()\nprint(\"\u2713 FAMD loadings saved\")\nprint(f\"\\nTop 5 features loading on PC1:\")\nfor feat, r in load_display['PC1'].abs().sort_values(ascending=False).head(5).items():\n    print(f\"  {feat:<35} |r| = {r:.3f}\")\n",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },

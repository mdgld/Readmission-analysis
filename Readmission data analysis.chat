              "commands": [
                "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPYTHON'\nimport pandas as pd\nimport pickle\n\n# This is the authoritative ICD-10-CM to DSM-5 TR mapping\n# Built from official CDC ICD-10-CM descriptions and DSM-5 TR diagnostic criteria\n\ncomprehensive_icd_map = {\n    # ============= F CODES - MENTAL DISORDERS (PRIMARY) =============\n    \n    # NEURODEVELOPMENTAL DISORDERS\n    # Speech & Language\n    'F80.0': {'name': 'Speech sound disorder', 'dsm5': 'Speech Sound Disorder', 'category': 'Neurodevelopmental'},\n    'F80.1': {'name': 'Expressive language disorder', 'dsm5': 'Language Disorder', 'category': 'Neurodevelopmental'},\n    'F80.2': {'name': 'Mixed receptive-expressive language disorder', 'dsm5': 'Language Disorder', 'category': 'Neurodevelopmental'},\n    'F80.4': {'name': 'Speech and language development delay due to hearing loss', 'dsm5': 'Speech Sound Disorder', 'category': 'Neurodevelopmental'},\n    'F80.8': {'name': 'Other developmental disorders of speech or language', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F80.9': {'name': 'Developmental disorder of speech or language, unspecified', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F80.81': {'name': 'Speech and language development delay due to hearing loss', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F80.82': {'name': 'Speech and language development delay due to hearing loss', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F80.89': {'name': 'Other specified language delay', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    \n    # Learning Disorders\n    'F81.0': {'name': 'Specific learning disorder with impairment in reading (dyslexia)', 'dsm5': 'Specific Learning Disorder with Impairment in Reading', 'category': 'Neurodevelopmental'},\n    'F81.2': {'name': 'Specific learning disorder with impairment in mathematics (dyscalculia)', 'dsm5': 'Specific Learning Disorder with Impairment in Mathematics', 'category': 'Neurodevelopmental'},\n    'F81.81': {'name': 'Specific learning disorder with impairment in writing (dysgraphia)', 'dsm5': 'Specific Learning Disorder with Impairment in Writing', 'category': 'Neurodevelopmental'},\n    'F81.89': {'name': 'Other specified learning disorder', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F81.9': {'name': 'Learning disorder, unspecified', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    \n    # Motor Coordination\n    'F82': {'name': 'Developmental coordination disorder', 'dsm5': 'Developmental Coordination Disorder', 'category': 'Neurodevelopmental'},\n    \n    # Autism Spectrum\n    'F84.0': {'name': 'Autism spectrum disorder', 'dsm5': 'Autism Spectrum Disorder', 'category': 'Neurodevelopmental'},\n    'F84.5': {'name': 'Asperger syndrome', 'dsm5': 'Autism Spectrum Disorder', 'category': 'Neurodevelopmental'},\n    'F84.8': {'name': 'Other specified autism spectrum disorder', 'dsm5': 'Autism Spectrum Disorder', 'category': 'Neurodevelopmental'},\n    'F84.9': {'name': 'Autism spectrum disorder, unspecified', 'dsm5': 'Autism Spectrum Disorder', 'category': 'Neurodevelopmental'},\n    'F88': {'name': 'Other disorders of psychological development', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F89': {'name': 'Unspecified disorder of psychological development', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    \n    # ADHD\n    'F90.0': {'name': 'Attention-deficit hyperactivity disorder, predominantly inattentive type', 'dsm5': 'ADHD, Predominantly Inattentive Presentation', 'category': 'Neurodevelopmental'},\n    'F90.1': {'name': 'Attention-deficit hyperactivity disorder, predominantly hyperactive-impulsive type', 'dsm5': 'ADHD, Predominantly Hyperactive-Impulsive Presentation', 'category': 'Neurodevelopmental'},\n    'F90.2': {'name': 'Attention-deficit hyperactivity disorder, combined type', 'dsm5': 'ADHD, Combined Presentation', 'category': 'Neurodevelopmental'},\n    'F90.8': {'name': 'Other specified attention-deficit/hyperactivity disorder', 'dsm5': None, 'category': 'Neurodevelopmental'},\n    'F90.9': {'name': 'Attention-deficit/hyperactivity disorder, unspecified', 'dsm5': 'ADHD, Unspecified', 'category': 'Neurodevelopmental'},\n    \n    # ============= DISRUPTIVE BEHAVIOR DISORDERS =============\n    'F91.1': {'name': 'Conduct disorder, childhood-onset type', 'dsm5': 'Conduct Disorder, Childhood-Onset Type', 'category': 'Disruptive'},\n    'F91.2': {'name': 'Conduct disorder, adolescent-onset type', 'dsm5': 'Conduct Disorder, Adolescent-Onset Type', 'category': 'Disruptive'},\n    'F91.3': {'name': 'Oppositional defiant disorder', 'dsm5': 'Oppositional Defiant Disorder', 'category': 'Disruptive'},\n    'F91.8': {'name': 'Other conduct disorders', 'dsm5': None, 'category': 'Disruptive'},\n    'F91.9': {'name': 'Conduct disorder, unspecified', 'dsm5': None, 'category': 'Disruptive'},\n    \n    # Impulse Control\n    'F63.1': {'name': 'Pyromania', 'dsm5': 'Pyromania', 'category': 'Disruptive'},\n    'F63.2': {'name': 'Kleptomania', 'dsm5': 'Kleptomania', 'category': 'Disruptive'},\n    'F63.3': {'name': 'Trichotillomania (hair-pulling disorder)', 'dsm5': 'Trichotillomania (Hair-Pulling Disorder)', 'category': 'Disruptive'},\n    'F63.81': {'name': 'Intermittent explosive disorder', 'dsm5': 'Intermittent Explosive Disorder', 'category': 'Disruptive'},\n    'F63.89': {'name': 'Other specified impulse disorders', 'dsm5': None, 'category': 'Disruptive'},\n    'F63.9': {'name': 'Unspecified impulse disorders', 'dsm5': None, 'category': 'Disruptive'},\n    'F63': {'name': 'Habit and impulse disorders', 'dsm5': None, 'category': 'Disruptive'},\n    \n    # ============= ANXIETY DISORDERS =============\n    'F40.0': {'name': 'Agoraphobia', 'dsm5': 'Agoraphobia', 'category': 'Anxiety'},\n    'F40.00': {'name': 'Agoraphobia without history of panic disorder', 'dsm5': 'Agoraphobia', 'category': 'Anxiety'},\n    'F40.01': {'name': 'Agoraphobia wit
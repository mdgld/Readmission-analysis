de/jupyter_projects/Readmission_Full_Analysis.ipynb:2002:    \"    (axes[0], top_u1, 'r_umap1', 'p_umap1', 'UMAP 1 \u2014 Feature Correlations (Spearman r)'),\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2003:    \"    (axes[1], top_u2, 'r_umap2', 'p_umap2', 'UMAP 2 \u2014 Feature Correlations (Spearman r)'),\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2021:    \"plt.suptitle('Which Features Drive Each UMAP Dimension?\\\\n'\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2025:    \"plt.savefig('figures/Fig12b_UMAP_feature_correlations.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2438:    \"# \u2500\u2500 Fig 12c: UMAP overlaid with top correlated features \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2473:    \"    ax.set_xlabel('UMAP 1')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2474:    \"    ax.set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2482:    \"plt.suptitle('UMAP Embedding Colored by Top Feature Correlates\\\\n'\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2486:    \"plt.savefig('figures/Fig12c_UMAP_feature_overlay.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2501:      \"HDBSCAN found 10 clusters  |  noise points: 73\\n\"\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2533:      \"\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\n\"\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2539:    \"# \u2500\u2500 Post-hoc: HDBSCAN Cluster Profiling on UMAP Embedding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2542:    \"clusterer    = hdbscan.HDBSCAN(min_cluster_size=60, min_samples=10, prediction_data=True)\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2543:    \"cluster_labels = clusterer.fit_predict(embedding)   # -1 = noise/unclustered\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2545:    \"n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2546:    \"print(f\\\"HDBSCAN found {n_clusters} clusters  |  noise points: {(cluster_labels == -1).sum()}\\\")\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2548:    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2551:    \"for cl in sorted(set(cluster_labels)):\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2552:    \"    mask = cluster_labels == cl\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2558:    \"ax.set_xlabel('UMAP 1');  ax.set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2559:    \"ax.set_title(f'HDBSCAN Clusters on UMAP Embedding\\\\n({n_clusters} clusters identified)',\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2563:    \"plt.savefig('figures/Fig_HDBSCAN_clusters.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2568:    \"mdf_r['cluster'] = cluster_labels\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2584:    \"for cl in sorted(set(cluster_labels)):\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2585:    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2596:    \"profile_df.to_csv('figures/HDBSCAN_cluster_profiles.csv')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2597:    \"print(\\\"\\\\n\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\\")\\n\"",
              "content": "/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1737:      \"  figures/Fig12_FAMD_UMAP.png\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1738:      \"  figures/Fig12b_UMAP_feature_correlations.png\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1739:      \"  figures/Fig12c_UMAP_feature_overlay.png\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1756:      \"  figures/Fig_HDBSCAN_clusters.png\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1872:    \"# \u2500\u2500 Fig 12: UMAP embedding of FAMD components \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1873:    \"reducer = umap.UMAP(n_components=2, n_neighbors=30, min_dist=0.1,\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1887:    \"axes[0].set_xlabel('UMAP 1')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1888:    \"axes[0].set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1889:    \"axes[0].set_title('UMAP of FAMD Components\\\\nColored by Readmission Status',\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1899:    \"axes[1].set_xlabel('UMAP 1')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1900:    \"axes[1].set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1901:    \"axes[1].set_title('UMAP of FAMD Components\\\\nContinuous Readmission Risk',\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1906:    \"plt.suptitle('Unsupervised Pattern Discovery: FAMD + UMAP\\\\n'\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1910:    \"plt.savefig('figures/Fig12_FAMD_UMAP.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1925:      \"\u2500\u2500 Top correlates with UMAP 1 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1939:      \"\u2500\u2500 Top correlates with UMAP 2 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1974:    \"# \u2500\u2500 UMAP Axis Interpretation: Spearman correlations with all features \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1988:    \"print(\\\"\u2500\u2500 Top correlates with UMAP 1 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\\")\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:1993:    \"print(\\\"\\\\n\u2500\u2500 Top correlates with UMAP 2 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\\")\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2002:    \"    (axes[0], top_u1, 'r_umap1', 'p_umap1', 'UMAP 1 \u2014 Feature Correlations (Spearman r)'),\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2003:    \"    (axes[1], top_u2, 'r_umap2', 'p_umap2', 'UMAP 2 \u2014 Feature Correlations (Spearman r)'),\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2021:    \"plt.suptitle('Which Features Drive Each UMAP Dimension?\\\\n'\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2025:    \"plt.savefig('figures/Fig12b_UMAP_feature_correlations.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2438:    \"# \u2500\u2500 Fig 12c: UMAP overlaid with top correlated features \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2473:    \"    ax.set_xlabel('UMAP 1')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2474:    \"    ax.set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2482:    \"plt.suptitle('UMAP Embedding Colored by Top Feature Correlates\\\\n'\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2486:    \"plt.savefig('figures/Fig12c_UMAP_feature_overlay.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2501:      \"HDBSCAN found 10 clusters  |  noise points: 73\\n\"\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2533:      \"\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\n\"\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2539:    \"# \u2500\u2500 Post-hoc: HDBSCAN Cluster Profiling on UMAP Embedding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2542:    \"clusterer    = hdbscan.HDBSCAN(min_cluster_size=60, min_samples=10, prediction_data=True)\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2543:    \"cluster_labels = clusterer.fit_predict(embedding)   # -1 = noise/unclustered\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2545:    \"n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2546:    \"print(f\\\"HDBSCAN found {n_clusters} clusters  |  noise points: {(cluster_labels == -1).sum()}\\\")\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2548:    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2551:    \"for cl in sorted(set(cluster_labels)):\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2552:    \"    mask = cluster_labels == cl\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2558:    \"ax.set_xlabel('UMAP 1');  ax.set_ylabel('UMAP 2')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2559:    \"ax.set_title(f'HDBSCAN Clusters on UMAP Embedding\\\\n({n_clusters} clusters identified)',\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2563:    \"plt.savefig('figures/Fig_HDBSCAN_clusters.png')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2568:    \"mdf_r['cluster'] = cluster_labels\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2584:    \"for cl in sorted(set(cluster_labels)):\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2585:    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2596:    \"profile_df.to_csv('figures/HDBSCAN_cluster_profiles.csv')\\n\",\n/Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb:2597:    \"print(\\\"\\\\n\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\\")\\n\""

medical_comorbidity_types)\n    all_types = [t for sublist in med_types for t in sublist]\n    type_counts = pd.Series(all_types).value_counts()\n    for t, count in type_counts.items():\n        r[f'Medical: {t}, n(%)'] = f\"{count} ({100*count/len(vals):.1f}%)\"\n        \n    return r\n\nra  = df[df['readmitted'] == 1]\nnra = df[df['readmitted'] == 0]\ntotal_n = len(df)\n\ntable1_data = {\n    'Not Readmitted': get_stats(nra, total_n),\n    'Readmitted': get_stats(ra, total_n)\n}\ntable1 = pd.DataFrame(table1_data).T\ntable1.to_csv('figures/Table1_descriptive.csv')\nprint(table1.to_string())```\n\n#### Output\n\n```\n\u001b[31m---------------------------------------------------------------------------\u001b[39m\n\u001b[31mNameError\u001b[39m                                 Traceback (most recent call last)\n\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[2]\u001b[39m\u001b[32m, line 40\u001b[39m\n\u001b[32m     36\u001b[39m         r[f'Medical: {t}, n(%)'] = f\"{count} ({\u001b[32m100\u001b[39m*count/len(vals):.1f}%)\"\n\u001b[32m     37\u001b[39m \n\u001b[32m     38\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m r\n\u001b[32m     39\u001b[39m \n\u001b[32m---> \u001b[39m\u001b[32m40\u001b[39m ra  = df[df[\u001b[33m'readmitted'\u001b[39m] == \u001b[32m1\u001b[39m]\n\u001b[32m     41\u001b[39m nra = df[df[\u001b[33m'readmitted'\u001b[39m] == \u001b[32m0\u001b[39m]\n\u001b[32m     42\u001b[39m total_n = len(df)\n\u001b[32m     43\u001b[39m \n\n\u001b[31mNameError\u001b[39m: name 'df' is not defined```"

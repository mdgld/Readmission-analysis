            "raw_output": {
              "content": "],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Logistic regression model + interaction terms \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"import statsmodels.api as sm\\n\",\n    \"\\n\",\n    \"# Add clinically motivated interaction terms\\n\",\n    \"model_df['age_x_conduct']  = model_df['age'] * model_df['has_conduct']\\n\",\n    \"model_df['age_x_asd']      = model_df['age'] * model_df['has_asd']\\n\",\n    \"model_df['ace_x_trauma']   = model_df['ace_score'] * model_df['has_trauma']\\n\",\n    \"model_df['nssi_x_csrss']   = model_df['has_nssi'] * model_df['csrss_any']\\n\",\n    \"model_df['complexity_x_age'] = model_df['n_dsm5_categories'] * model_df['age']\\n\",\n    \"model_df['csrss_level'] = (model_df['csrss_red'] * 3 + model_df['csrss_orange'] * 2 + model_df['csrss_yellow'] * 1).fillna(0).astype(int)\\n\",\n    \"model_df['nssi_x_csrss_red'] = model_df['has_nssi'] * model_df['csrss_red']\\n\",\n    \"model_df['age_x_public_insurance'] = model_df['age'] * model_df['insurance_public']\\n\",\n    \"\\n\",\n    \"# Standardize continuous variables for Odds Ratio interpretation and visible CIs\\n\",\n    \"from sklearn.preprocessing import StandardScaler\\n\",\n    \"scaler = StandardScaler()\\n\",\n    \"scale_cols = ['age', 'los_days', 'ace_score', 'n_dsm5_categories', 'complexity_x_age']\\n\",\n    \"model_df[scale_cols] = scaler.fit_transform(model_df[scale_cols])\\n\",\n    \"\\n\",\n    \"interaction_labels = {\\n\",\n    \"    'age_x_conduct':    'Age \u00d7 Conduct Disorder',\\n\",\n    \"    'age_x_asd':        'Age \u00d7 ASD',\\n\",\n    \"    'ace_x_trauma':     'ACE Score \u00d7 Trauma/PTSD',\\n\",\n    \"    'nssi_x_csrss_red': 'NSSI \u00d7 C-SSRS Red Flag',\\n\",\n    \"    'complexity_x_age': 'Diagnostic Complexity \u00d7 Age',\\n\",\n<exited with exit code 0>",
              "detailedContent": "],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Logistic regression model + interaction terms \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"import statsmodels.api as sm\\n\",\n    \"\\n\",\n    \"# Add clinically motivated interaction terms\\n\",\n    \"model_df['age_x_conduct']  = model_df['age'] * model_df['has_conduct']\\n\",\n    \"model_df['age_x_asd']      = model_df['age'] * model_df['has_asd']\\n\",\n    \"model_df['ace_x_trauma']   = model_df['ace_score'] * model_df['has_trauma']\\n\",\n    \"model_df['nssi_x_csrss']   = model_df['has_nssi'] * model_df['csrss_any']\\n\",\n    \"model_df['complexity_x_age'] = model_df['n_dsm5_categories'] * model_df['age']\\n\",\n    \"model_df['csrss_level'] = (model_df['csrss_red'] * 3 + model_df['csrss_orange'] * 2 + model_df['csrss_yellow'] * 1).fillna(0).astype(int)\\n\",\n    \"model_df['nssi_x_csrss_red'] = model_df['has_nssi'] * model_df['csrss_red']\\n\",\n    \"model_df['age_x_public_insurance'] = model_df['age'] * model_df['insurance_public']\\n\",\n    \"\\n\",\n    \"# Standardize continuous variables for Odds Ratio interpretation and visible CIs\\n\",\n    \"from sklearn.preprocessing import StandardScaler\\n\",\n    \"scaler = StandardScaler()\\n\",\n    \"scale_cols = ['age', 'los_days', 'ace_score', 'n_dsm5_categories', 'complexity_x_age']\\n\",\n    \"model_df[scale_cols] = scaler.fit_transform(model_df[scale_cols])\\n\",\n    \"\\n\",\n    \"interaction_labels = {\\n\",\n    \"    'age_x_conduct':    'Age \u00d7 Conduct Disorder',\\n\",\n    \"    'age_x_asd':        'Age \u00d7 ASD',\\n\",\n    \"    'ace_x_trauma':     'ACE Score \u00d7 Trauma/PTSD',\\n\",\n    \"    'nssi_x_csrss_red': 'NSSI \u00d7 C-SSRS Red Flag',\\n\",\n    \"    'complexity_x_age': 'Diagnostic Complexity \u00d7 Age',\\n\",\n<exited with exit code 0>"

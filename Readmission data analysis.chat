            "raw_input": {
              "description": "Create reference tables and analysis summaries",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPY'\nimport pandas as pd\nimport json\n\n# Load reference\nimport pickle\nwith open('comprehensive_icd_ref.pkl', 'rb') as f:\n    icd_ref = pickle.load(f)\n\n# Load annotated data\nannotated_df = pd.read_csv('annotated_psychiatric_data.csv')\ndiagnoses_df = pd.read_csv('diagnoses_long_form.csv')\n\n# Create ICD-10 to DSM-5 TR reference CSV\nreference_records = []\nfor code, info in sorted(icd_ref.items()):\n    reference_records.append({\n        'ICD_10_Code': code,\n        'Diagnosis_Name': info.get('name', ''),\n        'ICD_Category': info.get('category', ''),\n        'DSM5_Category': info.get('dsm5_category', ''),\n        'DSM5_Code': info.get('dsm5_code', ''),\n        'Frequency_in_Dataset': (diagnoses_df['icd_code'] == code).sum(),\n    })\n\nref_df = pd.DataFrame(reference_records)\nref_df = ref_df.sort_values('Frequency_in_Dataset', ascending=False)\nref_df.to_csv('ICD10_to_DSM5_Reference.csv', index=False)\n\nprint(\"Reference table created: ICD10_to_DSM5_Reference.csv\")\nprint(f\"  {len(ref_df)} unique ICD-10 codes\")\nprint(f\"\\nTop 25 most common codes:\")\nprint(ref_df[ref_df['Frequency_in_Dataset'] > 0][['ICD_10_Code', 'Diagnosis_Name', 'DSM5_Category', 'Frequency_in_Dataset']].head(25).to_string(index=False))\n\n# Create DSM-5 category summary\ndsm5_summary = diagnoses_df[diagnoses_df['dsm5_category'].notna()].groupby('dsm5_category').agg({\n    'MRN': 'nunique',\n    'icd_code': 'count',\n}).rename(columns={'MRN': 'Unique_Patients', 'icd_code': 'Total_Occurrences'}).sort_values('Total_Occurrences', ascending=False)\n\ndsm5_summary.to_csv('DSM5_Category_Summary.csv')\nprint(f\"\\n\\nDSM-5 Category Summary: DSM5_Category_Summary.csv\")\nprint(f\"  {len(dsm5_summary)} DSM-5 categories represented\")\nprint(dsm5_summary)\n\n# Readmission analysis by diagnosis\nreadmitted_by_dsm5 = diagnoses_df.merge(annotated_df[['MRN', 'Readmissions']], on='MRN')\nreadmitted_by_dsm5['Readmitted'] = readmitted_by_dsm5['Readmissions'] > 0\n\ndsm5_readmit = readmitted_by_dsm5[readmitted_by_dsm5['dsm5_category'].notna()].groupby('dsm5_category').agg({\n    'Readmitted': ['sum', 'count'],\n    'MRN': 'nunique',\n}).round(3)\ndsm5_readmit.columns = ['Readmitted_Cases', 'Total_Diagnoses', 'Unique_Patients']\ndsm5_readmit['Readmission_Rate'] = (dsm5_readmit['Readmitted_Cases'] / dsm5_readmit['Unique_Patients']).round(3)\ndsm5_readmit = dsm5_readmit.sort_values('Readmission_Rate', ascending=False)\n\ndsm5_readmit.to_csv('DSM5_Readmission_Analysis.csv')\nprint(f\"\\n\\nReadmission Analysis by DSM-5 Category: DSM5_Readmission_Analysis.csv\")\nprint(dsm5_readmit.head(15))\n\nprint(\"\\n\u2713 Analysis Complete!\")\nprint(\"\\nGenerated files:\")\nprint(\"  1. ICD10_to_DSM5_Reference.csv - Complete ICD-10 code mapping (1,863 codes)\")\nprint(\"  2. DSM5_Category_Summary.csv - Summary of diagnoses by DSM-5 category\")\nprint(\"  3. DSM5_Readmission_Analysis.csv - Readmission rates by DSM-5 category\")\nprint(\"  4. annotated_psychiatric_data.csv - Original data + diagnosis names and DSM-5 mappings\")\nprint(\"  5. diagnoses_long_form.csv - Long-form diagnostic data (27,884 diagnosis records)\")\nEOFPY\n"
            },

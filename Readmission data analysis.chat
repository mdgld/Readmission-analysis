              "content": "\n# \u2500\u2500 Logistic regression: build feature matrix \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nFEATURES = {\n    # Demographics\n    'age':                   'Age at Admission',\n    'gender_male':           'Male Sex',\n    'insurance_public':      'Public Insurance (AHCCCS)',\n    # Clinical\n    'ace_score':             'ACE Score',\n    'had_restraints':        'Physical Restraints',\n    'csrss_any':             'Any C-SSRS Flag',\n    'los_days':              'Length of Stay (days)',\n    # Diagnostic complexity\n    'n_dsm5_categories':     '# DSM-5 Categories',\n    'has_medical_comorbidity': 'Medical Comorbidity',\n    # Diagnosis category flags\n    'has_nssi':              'NSSI Diagnosis',\n    'has_trauma':            'Trauma/PTSD',\n    'has_adhd':              'ADHD',\n    'has_asd':               'ASD',\n    'has_conduct':           'Conduct Disorder',\n    'has_depression':        'Depression',\n    'has_anxiety':           'Anxiety',\n    'has_bipolar':           'Bipolar Disorder',\n    'has_psychotic':         'Psychotic Disorder',\n}\n\nfeat_cols = list(FEATURES.keys())\nmodel_df  = df[feat_cols + ['readmitted']].copy()\n\n# Impute ACE score with median (30% missing \u2192 median imputation noted in methods)\nace_median = model_df['ace_score'].median()\nmodel_df['ace_score'] = model_df['ace_score'].fillna(ace_median)\nmodel_df['los_days']  = model_df['los_days'].fillna(model_df['los_days'].median())\nmodel_df = model_df.dropna()\n\nprint(f\"Model dataset: {len(model_df):,} patients | {model_df['readmitted'].sum()} readmitted ({model_df['readmitted'].mean():.1%})\")\nprint(f\"Features: {len(feat_cols)}\")\n",

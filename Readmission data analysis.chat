0.3,\n                 f'{val:.1f}%', ha='center', fontsize=10)\n\nplt.tight_layout()\nplt.savefig('figures/Fig5_ace_csrss.png')\nplt.show()\nprint(\"\u2713 Fig 5 saved\")\n"

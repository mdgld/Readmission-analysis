              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOF'\nimport pandas as pd\nimport json\n\n# Comprehensive ICD-10 to DSM-5 TR mapping for psychiatric codes\n# Based on DSM-5 TR diagnostic categories and ICD-10-CM cross-references\n\nicd_to_dsm5_psychiatric = {\n    # NEURODEVELOPMENTAL DISORDERS\n    'F80.0': {'name': 'Speech sound disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.0'},\n    'F80.1': {'name': 'Expressive language disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.1'},\n    'F80.2': {'name': 'Mixed receptive-expressive language disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.2'},\n    'F80.4': {'name': 'Speech and language development delay due to hearing loss', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.4'},\n    'F80.8': {'name': 'Other developmental disorders of speech or language', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.8'},\n    'F80.9': {'name': 'Developmental disorder of speech or language, unspecified', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.9'},\n    'F81.0': {'name': 'Specific learning disorder with impairment in reading', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.0'},\n    'F81.2': {'name': 'Specific learning disorder with impairment in mathematics', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.2'},\n    'F81.81': {'name': 'Specific learning disorder with impairment in writing', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.81'},\n    'F81.89': {'name': 'Other specified learning disorder', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.89'},\n    'F81.9': {'name': 'Learning disorder, unspecified', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.9'},\n    'F82': {'name': 'Developmental coordination disorder', 'dsm5_category': 'Developmental Coordination Disorder', 'dsm5_code': 'F82'},\n    'F84.0': {'name': 'Autism spectrum disorder', 'dsm5_category': 'Autism Spectrum Disorder', 'dsm5_code': 'F84.0'},\n    'F84.5': {'name': 'Asperger syndrome', 'dsm5_category': 'Autism Spectrum Disorder', 'dsm5_code': 'F84.5'},\n    'F84.8': {'name': 'Other specified autism spectrum disorder', 'dsm5_category': 'Autism Spectrum Disorder', 'dsm5_code': 'F84.8'},\n    'F84.9': {'name': 'Autism spectrum disorder, unspecified', 'dsm5_category': 'Autism Spectrum Disorder', 'dsm5_code': 'F84.9'},\n    'F88': {'name': 'Other disorders of psychological development', 'dsm5_category': 'Other Neurodevelopmental Disorder', 'dsm5_code': 'F88'},\n    'F89': {'name': 'Unspecified disorder of psychological development', 'dsm5_category': 'Other Neurodevelopmental Disorder', 'dsm5_code': 'F89'},\n    'F90.0': {'name': 'ADHD, predominantly inattentive type', 'dsm5_category': 'ADHD', 'dsm5_code': 'F90.1'},\n    'F90.1': {'name': 'ADHD, predominantly hyperactive-impulsive type', 'dsm5_category': 'ADHD', 'dsm5_code': 'F90.2'},\n    'F90.2': {'name': 'ADHD, combined type', 'dsm5_category': 'ADHD', 'dsm5_code': 'F90.9'},\n    'F90.8': {'name': 'ADHD, other type', 'dsm5_category': 'ADHD', 'dsm5_code': 'F90.9'},\n    'F90.9': {'name': 'ADHD, unspecified', 'dsm5_category': 'ADHD', 'dsm5_code': 'F90.9'},\n    \n    # DISRUPTIVE, IMPULSE-CONTROL, AND CONDUCT DISORDERS\n    'F91.1': {'name': 'Childhood-onset type conduct disorder', 'dsm5_category': 'Conduct Disorder', 'dsm5_code': 'F91.1'},\n    'F91.3': {'name': 'Adolescent-onset type conduct disorder', 'dsm5_category': 'Conduct Disorder', 'dsm5_code': 'F91.3'},\n    'F91.8': {'name': 'Other conduct disorder', 'dsm5_category': 'Conduct Disorder', 'dsm5_code': 'F91.8'},\n    'F91.9': {'name': 'Conduct disorder, unspecified', 'dsm5_category': 'Conduct Disorder', 'dsm5_code': 'F91.9'},\n    'F63.1': {'name': 'Pyromania (fire-setting)', 'dsm5_category': 'Disruptive Behavior Disorder', 'dsm5_code': 'F63.1'},\n   
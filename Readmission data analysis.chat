            "raw_input": {
              "command": "pip3 install pandas -q && python3 << 'EOF'\nimport pandas as pd\n\n# Load the CSV\ndf = pd.read_csv(\"/Users/matthewgold/code/jupyter_projects/With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\n\nprint(\"Dataset shape:\", df.shape)\nprint(\"\\nColumn names:\")\nprint(df.columns.tolist())\nprint(\"\\nFirst few rows of relevant columns:\")\nprint(df[['MRN', 'VisitDiags', 'NonSuicidialDiags', 'ChronicDiags']].head(3))\n\n# Extract unique ICD codes from all three diagnosis columns\nfrom collections import Counter\nall_codes = []\n\nfor col in ['VisitDiags', 'NonSuicidialDiags', 'ChronicDiags']:\n    for cell in df[col].dropna():\n        codes = [c.strip() for c in str(cell).split(',')]\n        all_codes.extend(codes)\n\nunique_codes = sorted(set(all_codes))\nprint(f\"\\nTotal unique ICD codes: {len(unique_codes)}\")\nprint(f\"Sample codes: {unique_codes[:20]}\")\nEOF\n",
              "description": "Install pandas and examine ICD codes"
            }

            "status": "completed",
            "title": "mcp__Jupyter_MCP_Server__edit_cell",
            "raw_input": {
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 9: SHAP summary plot (CatBoost trained on full dataset) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nimport shap\n\nfeature_labels = [all_labels.get(c, c) for c in ml_cols]\n\n# Refit CatBoost on full dataset for SHAP\ncat_full = CatBoostClassifier(\n    iterations=500, depth=4, learning_rate=0.05,\n    auto_class_weights='Balanced', eval_metric='AUC',\n    random_seed=42, verbose=0,\n)\ncat_full.fit(X_ml, y_ml)\n\n# SHAP values via TreeExplainer\nexplainer   = shap.TreeExplainer(cat_full)\nshap_values = explainer.shap_values(X_ml)\n\nfig, ax = plt.subplots(figsize=(10, 10))\nshap.summary_plot(shap_values, X_ml, feature_names=feature_labels,\n                  show=False, plot_size=None, max_display=20)\nax = plt.gca()\nax.set_title('SHAP Feature Importance (CatBoost)\\nImpact on Readmission Probability', \n             fontsize=15, fontweight='bold', pad=15)\nplt.tight_layout()\nplt.savefig('figures/Fig9_SHAP_summary.png')\nplt.show()\nprint(\"\u2713 Fig 9 saved\")\n",
              "cell_id": "8d89d02f-9eaa-44e9-bcf1-38b1bd6a45f1"
            },
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6",
            "selected_option_id": "allow",
            "raw_output": "{\"success\":true}",
            "kind": "other"
          },
          {
            "status": "completed",
            "raw_output": "{\"success\":true}",
            "kind": "other",
            "selected_option_id": "allow",
            "raw_input": {
              "cell_id": "9dd2181d-aef2-498b-959f-dbab76959c80",
              "content": "\n# \u2500\u2500 Fig 10: Feature importance \u2014 RF vs CatBoost (side-by-side) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nrf_full = RandomForestClassifier(\n    n_estimators=500, max_depth=6, min_samples_leaf=10,\n    class_weight='balanced', random_state=42, n_jobs=-1\n)\nrf_full.fit(X_ml, y_ml)\n\nrf_imp  = pd.Series(rf_full.feature_importances_,  index=feature_labels).sort_values(ascending=False).head(15)\ncat_imp = pd.Series(cat_full.get_feature_importance(), index=feature_labels).sort_values(ascending=False).head(15)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\n\nfor ax, imp, title, color in [\n    (axes[0], rf_imp,  'Random Forest\\nFeature Importance (Top 15)',  '#4dac26'),\n    (axes[1], cat_imp, 'CatBoost\\nFeature Importance (Top 15)',        '#d01c8b'),\n]:\n    bars = ax.barh(imp.index[::-1], imp.values[::-1], color=color, alpha=0.8, edgecolor='white')\n    ax.set_xlabel('Importance Score')\n    ax.set_title(title, fontsize=14, fontweight='bold')\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n    for bar, val in zip(bars, imp.values[::-1]):\n        ax.text(val + 0.001, bar.get_y() + bar.get_height()/2,\n                f'{val:.3f}', va='center', fontsize=9)\n\nplt.suptitle('Feature Importance Comparison: ML Models', fontsize=16, fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('figures/Fig10_feature_importance.png')\nplt.show()\nprint(\"\u2713 Fig 10 saved\")\n",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6",

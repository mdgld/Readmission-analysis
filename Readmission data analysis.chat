   cats = set()\\n\",\n178.     \"    for col in ['VisitDiags_DSM5Categories', 'ChronicDiags_DSM5Categories']:\\n\",\n179.     \"        val = row.get(col, '')\\n\",\n180.     \"        if pd.notna(val) and str(val).strip():\\n\",\n181.     \"            cats.update(c.strip() for c in str(val).split(';') if c.strip())\\n\",\n182.     \"    return len(cats)\\n\",\n183.     \"\\n\",\n184.     \"df['n_dsm5_categories'] = df.apply(unique_dsm5_count, axis=1)\\n\",\n185.     \"\\n\",\n186.     \"# \u2500\u2500 DSM-5 category flags \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n187.     \"all_dsm5 = (df['VisitDiags_DSM5Categories'].fillna('') + ';' +\\n\",\n188.     \"            df['ChronicDiags_DSM5Categories'].fillna('')).str.lower()\\n\",\n189.     \"\\n\",\n190.     \"CATEGORY_FLAGS = {\\n\",\n191.     \"    'has_nssi':        'non-suicidal self-injury',\\n\",\n192.     \"    'has_trauma':      'trauma and stressor',\\n\",\n193.     \"    'has_adhd':        'adhd',\\n\",\n194.     \"    'has_asd':         'autism spectrum',\\n\",\n195.     \"    'has_conduct':     'conduct disorder',\\n\",\n196.     \"    'has_depression':  'depressive disorders',\\n\",\n197.     \"    'has_anxiety':     'anxiety disorders',\\n\",\n198.     \"    'has_bipolar':     'bipolar',\\n\",\n199.     \"    'has_psychotic':   'psychotic',\\n\",\n200.     \"    'has_intellectual':'intellectual disability',\\n\",",

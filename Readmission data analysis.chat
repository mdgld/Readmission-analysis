            "raw_input": {
              "cell_id": "a86b1668",
              "content": "\n# \u2500\u2500 Post-hoc: Decision Curve Analysis \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ndef net_benefit(y_true, probs, threshold):\n    if threshold <= 0 or threshold >= 1:\n        return np.nan\n    preds = (probs >= threshold).astype(int)\n    tp = ((preds == 1) & (y_true == 1)).sum()\n    fp = ((preds == 1) & (y_true == 0)).sum()\n    n  = len(y_true)\n    return tp / n - fp / n * (threshold / (1 - threshold))\n\nthresholds = np.linspace(0.02, 0.50, 200)\n\nmodel_nbs = {\n    'CatBoost':            [net_benefit(y_ml, cat_probs, t) for t in thresholds],\n    'Random Forest':       [net_benefit(y_ml, rf_probs,  t) for t in thresholds],\n    'Logistic Regression': [net_benefit(y_ml, lr_probs,  t) for t in thresholds],\n}\ntreat_all_nb = [net_benefit(y_ml, np.ones(len(y_ml)), t) for t in thresholds]\n\n# Compute y-axis ceiling from data\nmax_nb = max(max(v for v in nb if not np.isnan(v)) for nb in model_nbs.values())\nmax_nb = max(max_nb, max(v for v in treat_all_nb if not np.isnan(v)))\n\nfig, ax = plt.subplots(figsize=(11, 7))\ncolors = {'CatBoost': '#d01c8b', 'Random Forest': '#4dac26', 'Logistic Regression': '#2166ac'}\nfor name, nb in model_nbs.items():\n    ax.plot(thresholds, nb, linewidth=2.5, label=name, color=colors[name])\n\nax.plot(thresholds, treat_all_nb, 'k--',  linewidth=1.5, label='Screen All')\nax.axhline(0, color='gray', linestyle=':', linewidth=1.5, label='Screen None  (NB = 0)')\n\n# Explicit y-axis so the positive region is clearly visible\nax.set_ylim(-0.005, max_nb * 1.35)\n\n# Annotate the positive region\nax.annotate('\u2190 Positive NB: model is beneficial',\n            xy=(0.03, max_nb * 0.55), fontsize=9, color='dimgray', style='italic')\nax.axhline(0, color='black', linewidth=0.6, alpha=0.4)   # zero baseline\n\nax.set_xlabel('Threshold Probability', fontsize=13)\nax.set_ylabel('Net Benefit', fontsize=13)\nax.set_title('Decision Curve Analysis\\n'\n             'Net Benefit of Screening vs. Treat-All / Treat-None',\n             fontsize=14, fontweight='bold')\nax.legend(fontsize=11)\nax.set_xlim(0.02, 0.50)\nax.yaxis.set_major_formatter(plt.FuncFormatter(lambda v, _: f'{v:.3f}'))\nax.grid(axis='y', alpha=0.3, linewidth=0.6)\nax.spines['top'].set_visible(False)\nax.spines['right'].set_visible(False)\nplt.tight_layout()\nplt.savefig('figures/Fig_DCA.png')\nplt.show()\nprint(\"\u2713 DCA saved\")\nprint(f\"\\nMax net benefit by model (threshold range 0.02\u20130.50):\")\nfor name, nb in model_nbs.items():\n    valid = [v for v in nb if not np.isnan(v)]\n    print(f\"  {name:<25}  max NB = {max(valid):.4f}\")\n",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },

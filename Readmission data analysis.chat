\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"print(\\\"Readmissions value counts:\\\")\\n\",\n     \"print(df['Readmissions'].value_counts().sort_index())\\n\",\n     \"df['readmitted'] = (df['Readmissions'].fillna(0) > 0).astype(int)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 Demographics \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"df['age'] = pd.to_numeric(df['Pt_Age_Visit'], errors='coerce')\\n\",\n     \"df['age_group'] = pd.cut(df['age'], bins=[5, 9, 11, 13, 19],\\n\",\n     \"                          labels=['6\u20139', '10\u201311', '12\u201313', '14+'], right=True)\\n\",\n     \"df['gender_male'] = (df['GenderCode'].str.strip().str.lower() == 'male').astype(int)\\n\",\n     \"df['insurance_public'] = df['Insurance'].str.contains('AHCCCS', case=False, na=False).astype(int)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 ACE score \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"df['ace_score'] = pd.to_numeric(df['ACEscore'], errors='coerce')\\n\",\n     \"df['ace_high'] = (df['ace_score'] >= 4).astype(float)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 Restraints \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"df['had_restraints'] = (pd.to_numeric(df['restraints'], errors='coerce').fillna(0) > 0).astype(int)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 C-SSRS flags \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"df['csrss_yellow'] = df['Yellow flags (C-SRSS)'].notna().astype(int)\\n\",\n     \"df['csrss_orange'] = df['Orange flags (C-SSRS)'].notna().astype(int)\\n\",\n     \"df['csrss_red']    = df['Red flags (C-SSRS)'].notna().astype(int)\\n\",\n     \"df['csrss_any']    = ((df['csrss_yellow'] + df['csrss_orange'] + df['csrss_red']) > 0).astype(int)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 Length of stay (compute before date-quality filter) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"df['VisitDate'] = pd.to_datetime(df['VisitDate'], errors='coerce')\\n\",\n     \"df['DischDate']  = pd.to_datetime(df['DischDate'],  errors='coerce')\\n\",\n     \"df['los_days']   = (df['DischDate'] - df['VisitDate']).dt.days\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 DATE QUALITY FILTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n   
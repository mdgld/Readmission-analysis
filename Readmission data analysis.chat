              "commands": [
                "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOF'\nimport pandas as pd\nimport json\n\n# Comprehensive ICD-10 to DSM-5 TR mapping for psychiatric codes\n# Based on DSM-5 TR diagnostic categories and ICD-10-CM cross-references\n\nicd_to_dsm5_psychiatric = {\n    # NEURODEVELOPMENTAL DISORDERS\n    'F80.0': {'name': 'Speech sound disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.0'},\n    'F80.1': {'name': 'Expressive language disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.1'},\n    'F80.2': {'name': 'Mixed receptive-expressive language disorder', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.2'},\n    'F80.4': {'name': 'Speech and language development delay due to hearing loss', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.4'},\n    'F80.8': {'name': 'Other developmental disorders of speech or language', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.8'},\n    'F80.9': {'name': 'Developmental disorder of speech or language, unspecified', 'dsm5_category': 'Communication Disorders', 'dsm5_code': 'F80.9'},\n    'F81.0': {'name': 'Specific learning disorder with impairment in reading', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.0'},\n    'F81.2': {'name': 'Specific learning disorder with impairment in mathematics', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.2'},\n    'F81.81': {'name': 'Specific learning disorder with impairment in writing', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.81'},\n    'F81.89': {'name': 'Other specified learning disorder', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.89'},\n    'F81.9': {'name': 'Learning disorder, unspecified', 'dsm5_category': 'Specific Learning Disorder', 'dsm5_code': 'F81.9'},\n    'F82': {'name': 'Developmental coordination disorder', 'dsm5_category': 'Developmental Coordination Disord
            "tool_call_id": "call_3oj7MEDsG7oTvPNi2E5eZKnH",
            "raw_output": {
              "stdout": "CELL 25\n\n# \u2500\u2500 Fig 13: FP vs FN across thresholds \u2014 all three models \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nmodel_configs = [\n    ('CatBoost',            cat_probs, '#d01c8b', 0.65),\n    ('Random Forest',       rf_probs,  '#4dac26', 0.60),\n    ('Logistic Regression', lr_probs,  '#2166ac', 0.50),\n]\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 6))\n\nfor ax, (name, probs, color, max_thresh) in zip(axes, model_configs):\n    thresh_range = np.linspace(0.01, max_thresh, 400)\n    fp_list, fn_list = [], []\n    for t in thresh_range:\n        preds = (probs >= t).astype(int)\n        tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n        fp_list.append(fp)\n        fn_list.append(fn)\n\n    crossover_idx = np.argmin(np.abs(np.array(fp_list) - np.array(fn_list)))\n    crossover_t   = thresh_range[crossover_idx]\n\n    ax.plot(thresh_range, fp_list, color='#e74c3c', linewidth=2.5,\n            label='False Positives (incorrectly flagged)')\n    ax.plot(thresh_range, fn_list, color='#3498db', linewidth=2.5,\n            label='False Negatives (readmissions missed)')\n    ax.axvline(crossover_t, color='purple', linestyle=':', linewidth=2,\n               label=f'FP = FN at t = {crossover_t:.2f}')\n\n    # Ref lines\n    for t_ref in [0.10, 0.20, 0.30, 0.50]:\n        if t_ref <= max_thresh:\n            ax.axvline(t_ref, color='gray', linestyle='--', alpha=0.35, linewidth=1)\n\n    ax.set_xlabel('Probability Threshold')\n    ax.set_ylabel('Count')\n    ax.set_title(f'{name}\\nFalse Positives vs. False Negatives', fontsize=13, fontweight='bold')\n    ax.legend(fontsize=9)\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('FP vs. FN Across Probability Thresholds \u2014 All Models\\n'\n             '(10-Fold CV; purple dotted = FP/FN crossover)',\n             fontsize=14, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig13_FP_vs_FN.png')\nplt.show()\nprint(\"\u2713 Fig 13 saved\")\n\n---\nCELL 26\n\n# \u2500\u2500 Fig 14: Burden vs Benefit \u2014 all models, extended thresholds \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nmodel_configs = [\n    ('CatBoost',            cat_probs, '#d01c8b', 0.65),\n    ('Random Forest',       rf_probs,  '#4dac26', 0.60),\n    ('Logistic Regression', lr_probs,  '#2166ac', 0.50),\n]\n\nn_total = len(y_ml)\nn_pos   = y_ml.sum()\n\nfig, axes = plt.subplots(2, 3, figsize=(21, 12))\n\nfor col, (name, probs, color, max_thresh) in enumerate(model_configs):\n    # Compute crossover over fine grid\n    thresh_full = np.linspace(0.01, max_thresh, 400)\n    fp_full, fn_full = [], []\n    for t in thresh_full:\n        preds = (probs >= t).astype(int)\n        tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n        fp_full.append(fp)\n        fn_full.append(fn)\n    crossover_t = thresh_full[np.argmin(np.abs(np.array(fp_full) - np.array(fn_full)))]\n\n    # Threshold grid up to max_thresh\n    base_ts = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]\n    extra   = [t for t in [0.55, 0.60, 0.65] if t <= max_thresh]\n    key_ts  = base_ts + extra\n\n    flag_pcts, sensitivities, ppvs, n_flagged_list = [], [], [], []\n    for t in key_ts:\n        preds   = (probs >= t).astype(int)\n        n_flag  = preds.sum()\n        tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n        flag_pcts.append(100 * n_flag / n_total)\n        n_flagged_list.append(n_flag)\n        sensitivities.append(100 * tp / (tp + fn) if (tp + fn) > 0 else 0)\n        ppvs.append(100 * tp / (tp + fp) if (tp + fp) > 0 else 0)\n\n    xlabels = [f'{int(t*100)}%' for t in key_ts]\n    x_pos   = np.arange(len(key_ts))\n\n    # Crossover position in bar space (between ticks)\n    crossover_x = next((xi - 0.5 for xi, t in enumerate(key_ts) if t >= crossover_t), None)\n\n    # \u2500\u2500 Row 0: % flagged \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    ax0 = axes[0, col]\n    bars = ax0.bar(x_pos, flag_pcts, color=color, alpha=0.75, edgecolor='white')\n    ax0.axhline(100 * n_pos / n_total, color='black', linestyle='--', linewidth=1.5,\n                label=f'Actual rate ({100*n_pos/n_total:.1f}%)')\n    if crossover_x is not None:\n        ax0.axvline(crossover_x, color='purple', linestyle=':', linewidth=2,\n                    label=f'FP=FN  t\u2248{crossover_t:.2f}')\n    ax0.set_xticks(x_pos)\n    ax0.set_xticklabels(xlabels, rotation=30, ha='right', fontsize=9)\n    for bar, pct in zip(bars, flag_pcts):\n        ax0.text(bar.get_x() + bar.get_width() / 2, pct + 0.4,\n                 f'{pct:.0f}%', ha='center', fontsize=8, fontweight='bold')\n    ax0.set_ylabel('% Charts Flagged')\n    ax0.set_title(f'{name}\\n% of Charts Flagged', fontsize=12, fontweight='bold')\n    ax0.legend(fontsize=9)\n    ax0.spines['top'].set_visible(False)\n    ax0.spines['right'].set_visible(False)\n\n    # \u2500\u2500 Row 1: Sensitivity & PPV \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    ax1 = axes[1, col]\n    ax1.plot(x_pos, sensitivities, 'o-', color=BLUE,  linewidth=2.5, markersize=7,\n             label='Sensitivity (readmissions caught)')\n    ax1.plot(x_pos, ppvs,          's--', color=color, linewidth=2.5, markersize=7,\n             label='PPV (precision)')\n    if crossover_x is not None:\n        ax1.axvline(crossover_x, color='purple', linestyle=':', linewidth=2,\n                    label=f'FP=FN  t\u2248{crossover_t:.2f}')\n    # Annotate every other point to avoid crowding\n    for i, (s, p) in enumerate(zip(sensitivities, ppvs)):\n        if i % 2 == 0:\n            ax1.text(i, min(s + 3, 108), f'{s:.0f}%', ha='center', fontsize=8, color=BLUE)\n            ax1.text(i, max(p - 6, 1),   f'{p:.0f}%', ha='center', fontsize=8, color=color)\n    ax1.set_xticks(x_pos)\n    ax1.set_xticklabels(xlabels, rotation=30, ha='right', fontsize=9)\n    ax1.set_ylabel('%')\n    ax1.set_ylim(0, 115)\n    ax1.set_title(f'{name}\\nSensitivity & PPV', fontsize=12, fontweight='bold')\n    ax1.legend(fontsize=9)\n    ax1.spines['top'].set_visible(False)\n    ax1.spines['right'].set_visible(False)\n\nplt.suptitle('Clinical Flagging Burden vs. Benefit \u2014 All Models\\n'\n             '(10-Fold CV, n=2,652; purple dotted line = FP/FN crossover threshold)',\n             fontsize=14, fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('figures/Fig14_flagging_thresholds.png')\nplt.show()\nprint(\"\u2713 Fig 14 saved\")\n\n---\n",

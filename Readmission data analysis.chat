            "title": "Show HDBSCAN cell source",
            "session_id": "a0ff27e5-b94e-4c50-8ea7-62cb5c6cfdd4",
            "raw_output": {
              "content": "],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Post-hoc: HDBSCAN Cluster Profiling on UMAP Embedding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"import hdbscan\\n\",\n    \"\\n\",\n    \"clusterer    = hdbscan.HDBSCAN(min_cluster_size=60, min_samples=10, prediction_data=True)\\n\",\n    \"cluster_labels = clusterer.fit_predict(embedding)   # -1 = noise/unclustered\\n\",\n    \"\\n\",\n    \"n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)\\n\",\n    \"print(f\\\"HDBSCAN found {n_clusters} clusters  |  noise points: {(cluster_labels == -1).sum()}\\\")\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"palette_c = plt.cm.tab10.colors\\n\",\n    \"fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n    \"for cl in sorted(set(cluster_labels)):\\n\",\n    \"    mask = cluster_labels == cl\\n\",\n    \"    lbl  = f'Noise (n={mask.sum()})' if cl == -1 else f'Cluster {cl} (n={mask.sum()})'\\n\",\n    \"    col  = 'lightgray' if cl == -1 else palette_c[cl % 10]\\n\",\n    \"    ax.scatter(embedding[mask, 0], embedding[mask, 1],\\n\",\n    \"               c=[col], alpha=0.35 if cl == -1 else 0.65, s=10, label=lbl, rasterized=True)\\n\",\n    \"ax.legend(fontsize=10, markerscale=2)\\n\",\n    \"ax.set_xlabel('UMAP 1');  ax.set_ylabel('UMAP 2')\\n\",\n    \"ax.set_title(f'HDBSCAN Clusters on UMAP Embedding\\\\n({n_clusters} clusters identified)',\\n\",\n    \"             fontsize=14, fontweight='bold')\\n\",\n    \"ax.spines['top'].set_visible(False);  ax.spines['right'].set_visible(False)\\n\",\n    \"plt.tight_layout()\\n\",\n    \"plt.savefig('figures/Fig_HDBSCAN_clusters.png')\\n\",\n    \"plt.show()\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Cluster profile table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"mdf_r = model_df.reset_index(drop=True)\\n\",\n    \"mdf_r['cluster'] = cluster_labels\\n\",\n    \"\\n\",\n    \"profile_vars = {\\n\",\n    \"    'Readmission rate':        'readmitted',\\n\",\n    \"    'Age (mean)':              'age',\\n\",\n    \"    'ACE score (mean)':        'ace_score',\\n\",\n    \"    'LOS days (mean)':         'los_days',\\n\",\n    \"    '# DSM-5 categories':      'n_dsm5_categories',\\n\",\n    \"    'Medical comorbidity (%)': 'has_medical_comorbidity',\\n\",\n    \"    'ADHD (%)':                'has_adhd',\\n\",\n    \"    'Trauma/PTSD (%)':         'has_trauma',\\n\",\n    \"    'ASD (%)':                 'has_asd',\\n\",\n    \"    'Restraints (%)':          'had_restraints',\\n\",\n    \"}\\n\",\n    \"\\n\",\n    \"rows = {}\\n\",\n    \"for cl in sorted(set(cluster_labels)):\\n\",\n    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n    \"    rows[f'Cluster {cl}' if cl != -1 else 'Noise'] = {\\n\",\n    \"        k: (f'{sub[v].mean()*100:.1f}%' if v in ('readmitted','has_medical_comorbidity',\\n\",\n    \"                                                    'has_adhd','has_trauma','has_asd','had_restraints')\\n\",\n    \"            else f'{sub[v].mean():.1f}')\\n\",\n    \"        for k, v in profile_vars.items()\\n\",\n    \"    }\\n\",\n    \"\\n\",\n    \"profile_df = pd.DataFrame(rows).T\\n\",\n    \"print(\\\"\\\\nCluster Profiles:\\\")\\n\",\n    \"print(profile_df.to_string())\\n\",\n    \"profile_df.to_csv('figures/HDBSCAN_cluster_profiles.csv')\\n\",\n    \"print(\\\"\\\\n\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\\")\\n\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n   \"execution_count\": 40,\n   \"id\": \"a86b1668-838a-462d-a4a0-c9107d8b8d19\",\n   \"metadata\": {},\n   \"outputs\": [\n<exited with exit code 0>",
              "detailedContent": "],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Post-hoc: HDBSCAN Cluster Profiling on UMAP Embedding \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"import hdbscan\\n\",\n    \"\\n\",\n    \"clusterer    = hdbscan.HDBSCAN(min_cluster_size=60, min_samples=10, prediction_data=True)\\n\",\n    \"cluster_labels = clusterer.fit_predict(embedding)   # -1 = noise/unclustered\\n\",\n    \"\\n\",\n    \"n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)\\n\",\n    \"print(f\\\"HDBSCAN found {n_clusters} clusters  |  noise points: {(cluster_labels == -1).sum()}\\\")\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"palette_c = plt.cm.tab10.colors\\n\",\n    \"fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n    \"for cl in sorted(set(cluster_labels)):\\n\",\n    \"    mask = cluster_labels == cl\\n\",\n    \"    lbl  = f'Noise (n={mask.sum()})' if cl == -1 else f'Cluster {cl} (n={mask.sum()})'\\n\",\n    \"    col  = 'lightgray' if cl == -1 else palette_c[cl % 10]\\n\",\n    \"    ax.scatter(embedding[mask, 0], embedding[mask, 1],\\n\",\n    \"               c=[col], alpha=0.35 if cl == -1 else 0.65, s=10, label=lbl, rasterized=True)\\n\",\n    \"ax.legend(fontsize=10, markerscale=2)\\n\",\n    \"ax.set_xlabel('UMAP 1');  ax.set_ylabel('UMAP 2')\\n\",\n    \"ax.set_title(f'HDBSCAN Clusters on UMAP Embedding\\\\n({n_clusters} clusters identified)',\\n\",\n    \"             fontsize=14, fontweight='bold')\\n\",\n    \"ax.spines['top'].set_visible(False);  ax.spines['right'].set_visible(False)\\n\",\n    \"plt.tight_layout()\\n\",\n    \"plt.savefig('figures/Fig_HDBSCAN_clusters.png')\\n\",\n    \"plt.show()\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Cluster profile table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"mdf_r = model_df.reset_index(drop=True)\\n\",\n    \"mdf_r['cluster'] = cluster_labels\\n\",\n    \"\\n\",\n    \"profile_vars = {\\n\",\n    \"    'Readmission rate':        'readmitted',\\n\",\n    \"    'Age (mean)':              'age',\\n\",\n    \"    'ACE score (mean)':        'ace_score',\\n\",\n    \"    'LOS days (mean)':         'los_days',\\n\",\n    \"    '# DSM-5 categories':      'n_dsm5_categories',\\n\",\n    \"    'Medical comorbidity (%)': 'has_medical_comorbidity',\\n\",\n    \"    'ADHD (%)':                'has_adhd',\\n\",\n    \"    'Trauma/PTSD (%)':         'has_trauma',\\n\",\n    \"    'ASD (%)':                 'has_asd',\\n\",\n    \"    'Restraints (%)':          'had_restraints',\\n\",\n    \"}\\n\",\n    \"\\n\",\n    \"rows = {}\\n\",\n    \"for cl in sorted(set(cluster_labels)):\\n\",\n    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n    \"    rows[f'Cluster {cl}' if cl != -1 else 'Noise'] = {\\n\",\n    \"        k: (f'{sub[v].mean()*100:.1f}%' if v in ('readmitted','has_medical_comorbidity',\\n\",\n    \"                                                    'has_adhd','has_trauma','has_asd','had_restraints')\\n\",\n    \"            else f'{sub[v].mean():.1f}')\\n\",\n    \"        for k, v in profile_vars.items()\\n\",\n    \"    }\\n\",\n    \"\\n\",\n    \"profile_df = pd.DataFrame(rows).T\\n\",\n    \"print(\\\"\\\\nCluster Profiles:\\\")\\n\",\n    \"print(profile_df.to_string())\\n\",\n    \"profile_df.to_csv('figures/HDBSCAN_cluster_profiles.csv')\\n\",\n    \"print(\\\"\\\\n\u2713 Cluster profiles saved to figures/HDBSCAN_cluster_profiles.csv\\\")\\n\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n   \"execution_count\": 40,\n   \"id\": \"a86b1668-838a-462d-a4a0-c9107d8b8d19\",\n   \"metadata\": {},\n   \"outputs\": [\n<exited with exit code 0>"

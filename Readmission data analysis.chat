            "raw_input": {
              "description": "Create annotated dataset and readmission analysis",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPY'\nimport pandas as pd\nimport pickle\nimport json\n\n# Load original and parsed data\ndf = pd.read_csv(\"/Users/matthewgold/code/jupyter_projects/With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\ndiagnoses_df = pd.read_csv('/tmp/parsed_diagnoses.csv')\n\nwith open('/tmp/comprehensive_icd_ref.pkl', 'rb') as f:\n    icd_ref = pickle.load(f)\n\nprint(\"Creating annotated dataset...\")\n\n# Create annotated version of original data with diagnosis names added as new columns\nannotated_records = []\n\ndef extract_codes(code_string):\n    if pd.isna(code_string):\n        return []\n    codes = [c.strip() for c in str(code_string).split(',')]\n    return [c for c in codes if c]\n\ndef get_name_list(codes_str):\n    \"\"\"Convert code string to list of diagnosis names\"\"\"\n    if pd.isna(codes_str):\n        return []\n    codes = extract_codes(codes_str)\n    names = []\n    for code in codes:\n        if code in icd_ref:\n            names.append(icd_ref[code].get('name', code))\n        else:\n            names.append(code)\n    return names\n\ndef get_dsm5_list(codes_str):\n    \"\"\"Convert code string to list of DSM-5 categories\"\"\"\n    if pd.isna(codes_str):\n        return []\n    codes = extract_codes(codes_str)\n    categories = []\n    for code in codes:\n        if code in icd_ref:\n            cat = icd_ref[code].get('dsm5_category')\n            if cat:\n                categories.append(cat)\n    return categories\n\nfor idx, row in df.iterrows():\n    record = dict(row)\n    \n    # Add diagnosis names\n    record['VisitDiags_Names'] = '; '.join(get_name_list(row['VisitDiags']))\n    record['NonSuicidialDiags_Names'] = '; '.join(get_name_list(row['NonSuicidialDiags']))\n    record['ChronicDiags_Names'] = '; '.join(get_name_list(row['ChronicDiags']))\n    \n    # Add DSM-5 categories\n    record['VisitDiags_DSM5'] = '; '.join(set(get_dsm5_list(row['VisitDiags'])))\n    record['NonSuicidialDiags_DSM5'] = '; '.join(set(get_dsm5_list(row['NonSuicidialDiags'])))\n    record['ChronicDiags_DSM5'] = '; '.join(set(get_dsm5_list(row['ChronicDiags'])))\n    \n    # Count DSM-5 mapped codes by type\n    visit_codes = extract_codes(row['VisitDiags'])\n    nssi_codes = extract_codes(row['NonSuicidialDiags'])\n    chronic_codes = extract_codes(row['ChronicDiags'])\n    \n    record['VisitDiags_DSM5_Count'] = sum(1 for c in visit_codes if c in icd_ref and icd_ref[c].get('dsm5_category'))\n    record['NonSuicidialDiags_DSM5_Count'] = sum(1 for c in nssi_codes if c in icd_ref and icd_ref[c].get('dsm5_category'))\n    record['ChronicDiags_DSM5_Count'] = sum(1 for c in chronic_codes if c in icd_ref and icd_ref[c].get('dsm5_category'))\n    \n    annotated_records.append(record)\n\nannotated_df = pd.DataFrame(annotated_records)\n\nprint(f\"\\nAnnotated dataset created: {annotated_df.shape}\")\nprint(f\"\\nNew columns added:\")\nnew_cols = [c for c in annotated_df.columns if c.endswith('_Names') or c.endswith('_DSM5') or c.endswith('_Count')]\nfor col in new_cols:\n    print(f\"  - {col}\")\n\n# Save annotated dataset\nannotated_df.to_csv('/tmp/annotated_psychiatric_data.csv', index=False)\nprint(f\"\\nSaved to /tmp/annotated_psychiatric_data.csv\")\n\n# Create summary statistics for readmission analysis\nprint(\"\\n=== READMISSION ANALYSIS ===\")\nprint(f\"\\nTotal patients: {len(annotated_df)}\")\nprint(f\"Patients with readmissions: {(annotated_df['Readmissions'] > 0).sum()}\")\nprint(f\"Total readmissions: {annotated_df['Readmissions'].sum()}\")\nprint(f\"Mean readmissions per patient: {annotated_df['Readmissions'].mean():.2f}\")\n\n# Readmission by diagnosis type (binary)\nreadmitted = annotated_df['Readmissions'] > 0\n\n# Find patients with specific psychiatric diagnoses\ndef has_diagnosis(df_col, codes_list):\n    \"\"\"Check if any diagnosis code in codes_list appears in column\"\"\"\n    results = []\n    for idx, cell in enumerate(df_col):\n        if pd.isna(cell):\n            results.append(False)\n        else:\n            has_any = any(code in str(cell) for code in codes_list)\n            results.append(has_any)\n    return results\n\n# Key psychiatric diagnoses\npsych_patterns = {\n    'ADHD': ['F90'],\n    'Depression': ['F32', 'F33'],\n    'Anxiety': ['F41', 'F40', 'F93.0'],\n    'PTSD': ['F43.1'],\n    'Autism': ['F84.0'],\n    'Conduct Disorder': ['F91'],\n    'Suicidal Ideation (NSSI)': ['R45.851'],\n}\n\nprint(\"\\nReadmission rates by primary diagnosis:\")\nfor diag_name, codes in psych_patterns.items():\n    patients_with = sum(has_diagnosis(annotated_df['VisitDiags'], codes))\n    if patients_with > 0:\n        readmitted_with = sum(readmitted[has_diagnosis(annotated_df['VisitDiags'], codes)])\n        rate = 100 * readmitted_with / patients_with\n        print(f\"  {diag_name}: {readmitted_with}/{patients_with} readmitted ({rate:.1f}%)\")\n\n# Export long-form diagnostic data\ndiagnoses_df_export = pd.read_csv('/tmp/parsed_diagnoses.csv')\ndiagnoses_df_export.to_csv('/tmp/diagnoses_long_form.csv', index=False)\n\nprint(f\"\\nAlso saved long-form diagnostic data: /tmp/diagnoses_long_form.csv\")\nprint(f\"  {len(diagnoses_df_export)} diagnosis records from {diagnoses_df_export['MRN'].nunique()} patients\")\n\nEOFPY\n"
            }

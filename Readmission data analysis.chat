            "raw_input": {
              "file_path": "Readmission_Full_Analysis.ipynb",
              "cell_id": "e203516c-dde7-4229-be17-9f991263a62e",
              "content": "\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nimport matplotlib.gridspec as gridspec\nimport seaborn as sns\nfrom scipy import stats\nimport statsmodels.api as sm\nimport statsmodels.formula.api as smf\nfrom sklearn.model_selection import StratifiedKFold, cross_val_predict\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score, roc_curve, average_precision_score, confusion_matrix\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import Pipeline\nfrom catboost import CatBoostClassifier\nimport prince\nimport umap\nimport shap\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# \u2500\u2500 Poster-quality global settings \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nplt.rcParams.update({\n    'font.size': 14, 'axes.titlesize': 16, 'axes.labelsize': 14,\n    'xtick.labelsize': 12, 'ytick.labelsize': 12, 'legend.fontsize': 12,\n    'figure.dpi': 150, 'savefig.dpi': 300, 'savefig.bbox': 'tight',\n    'font.family': 'DejaVu Sans',\n})\nBLUE, ORANGE = '#4C72B0', '#DD8452'\nPALETTE = {'Not Readmitted': BLUE, 'Readmitted': ORANGE}\nsns.set_style('whitegrid')\n\nimport os\nos.makedirs('figures', exist_ok=True)\nprint(\"\u2713 Libraries loaded. Figures will save to ./figures/\")\n"
            },
            "raw_output": "{\"success\":true}",
            "permission_status": "resolved",
            "title": "mcp__Jupyter_MCP_Server__edit_cell",
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6"
          },
          {
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6",
            "raw_output": "{\"success\":true}",
            "raw_input": {
              "content": "\n# \u2500\u2500 ML: prepare feature matrix (same features + interactions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score, roc_curve, average_precision_score\n\nml_cols = all_x_cols   # same features as logistic regression (incl. interactions)\nX_ml = model_df[ml_cols].values\ny_ml = model_df['readmitted'].values\n\ncv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n\n# \u2500\u2500 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nrf = RandomForestClassifier(\n    n_estimators=500, max_depth=6, min_samples_leaf=10,\n    class_weight='balanced', random_state=42, n_jobs=-1\n)\nrf_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    rf.fit(X_ml[train_idx], y_ml[train_idx])\n    rf_probs[test_idx] = rf.predict_proba(X_ml[test_idx])[:, 1]\n\nrf_auc  = roc_auc_score(y_ml, rf_probs)\nrf_ap   = average_precision_score(y_ml, rf_probs)\nprint(f\"Random Forest  \u2014 AUC: {rf_auc:.3f}  |  AP: {rf_ap:.3f}\")\n\n# \u2500\u2500 CatBoost \u2014 imbalance-aware, conservative depth \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ncat_model = CatBoostClassifier(\n    iterations=500,\n    depth=4,                      # conservative for small dataset\n    learning_rate=0.05,\n    auto_class_weights='Balanced',\n    eval_metric='AUC',\n    random_seed=42,\n    verbose=0,\n)\ncat_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    cat_model.fit(X_ml[train_idx], y_ml[train_idx])\n    cat_probs[test_idx] = cat_model.predict_proba(X_ml[test_idx])[:, 1]\n\ncat_auc = roc_auc_score(y_ml, cat_probs)\ncat_ap  = average_precision_score(y_ml, cat_probs)\nprint(f\"CatBoost       \u2014 AUC: {cat_auc:.3f}  |  AP: {cat_ap:.3f}\")\n\n# \u2500\u2500 Logistic regression probabilities (for ROC comparison) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlr_probs = np.zeros(len(y_ml))\nfor train_idx, test_idx in cv.split(X_ml, y_ml):\n    X_tr = sm.add_constant(X_ml[train_idx], has_constant='add')\n    X_te = sm.add_constant(X_ml[test_idx],  has_constant='add')\n    m = sm.Logit(y_ml[train_idx], X_tr).fit(disp=0, maxiter=200)\n    lr_probs[test_idx] = m.predict(X_te)\n\nlr_auc = roc_auc_score(y_ml, lr_probs)\nlr_ap  = average_precision_score(y_ml, lr_probs)\nprint(f\"Logistic Regr  \u2014 AUC: {lr_auc:.3f}  |  AP: {lr_ap:.3f}\")\n",
              "cell_id": "4b834e89-86d7-4eb9-979a-48b6cbd4f9fe",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },
            "permission_options": [
              {
                "name": "Always Allow all mcp__Jupyter_MCP_Server__edit_cell",
                "option_id": "allow_always",
                "kind": "allow_always"
              },
              {
                "kind": "allow_once",
                "option_id": "allow",
                "name": "Allow"
              },
              {
                "kind": "reject_once",

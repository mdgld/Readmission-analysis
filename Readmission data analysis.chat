                "new_text": "  },\n  {\n   \"cell_type\": \"code\",\n   \"execution_count\": null,\n   \"id\": \"ace-fig-2b\",\n   \"metadata\": {},\n   \"outputs\": [],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 Fig 2b: Readmission rate by ACE score (\u22643 vs \u22654) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"ace_df = df[df['ace_score'].notna()].copy()\\n\",\n    \"ace_df['ace_group'] = np.where(ace_df['ace_score'] >= 4, 'ACE \u22654', 'ACE \u22643')\\n\",\n    \"res = ace_df.groupby('ace_group')['readmitted'].agg(['mean', 'count'])\\n\",\n    \"res = res.reindex(['ACE \u22643', 'ACE \u22654'])\\n\",\n    \"rates = res['mean'] * 100\\n\",\n    \"ns = res['count']\\n\",\n    \"err = 1.96 * np.sqrt(res['mean'] * (1 - res['mean']) / ns) * 100\\n\",\n    \"\\n\",\n    \"from scipy.stats import chi2_contingency\\n\",\n    \"tab = pd.crosstab(ace_df['ace_group'], ace_df['readmitted'])\\n\",\n    \"_, p, _, _ = chi2_contingency(tab)\\n\",\n    \"p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\\n\",\n    \"\\n\",\n    \"fig, ax = plt.subplots(figsize=(6, 5))\\n\",\n    \"colors = [BLUE, ORANGE]\\n\",\n    \"bars = ax.bar(res.index, rates.values, yerr=err.values, capsize=5,\\n\",\n    \"              color=colors, alpha=0.85, edgecolor='white', width=0.6)\\n\",\n    \"\\n\",\n    \"for bar, n, rate, e in zip(bars, ns.values, rates.values, err.values):\\n\",\n    \"    ax.text(bar.get_x() + bar.get_width() / 2, rate + e + 1.0,\\n\",\n    \"            f'{rate:.1f}%\\\\n(n={n})', ha='center', va='bottom', fontsize=10)\\n\",\n    \"\\n\",\n    \"ax.set_title(f'ACE Score and Readmission Rate\\\\n{p_str}', fontsize=13, fontweight='bold')\\n\",\n    \"ax.set_ylabel('Readmission Rate (%)')\\n\",\n    \"ax.set_ylim(0, (rates.values + err.values).max() * 1.55)\\n\",\n    \"ax.spines['top'].set_visible(False)\\n\",\n    \"ax.spines['right'].set_visible(False)\\n\",\n    \"plt.tight_layout()\\n\",\n    \"plt.savefig('figures/Fig2b_ace_readmission.png')\\n\",\n    \"plt.show()\\n\",\n    \"print(\\\"\u2713 Fig 2b saved\\\")\\n\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n   \"execution_count\": 6,\n   \"id\": \"5199ec5e-8c8a-487e-b28a-d078662e5f61\",\n   \"metadata\": {},",

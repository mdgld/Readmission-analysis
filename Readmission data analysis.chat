              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPYTHON'\nimport pandas as pd\nimport re\n\n# Load reference\nref_df = pd.read_csv('ICD10_to_DSM5_Complete_Reference.csv')\n\n# Get all codes still needing lookup\nneeds_lookup_codes = ref_df[ref_df['Description'].str.contains(r'\\[Requires', na=False)]['ICD_Code'].tolist()\n\n# Generate descriptions using ICD code structure\ndef generate_description_from_code(code):\n    \"\"\"Generate descriptions based on ICD-10 code structure and patterns\"\"\"\n    \n    # Musculoskeletal (M codes)\n    if code.startswith('M'):\n        if code.startswith('M05'):\n            return 'Rheumatoid arthritis with rheumatoid factor'\n        elif code.startswith('M06'):\n            return 'Other rheumatoid arthritis'\n        elif code.startswith('M08'):\n            return 'Juvenile arthritis'\n        elif code.startswith('M10'):\n            return 'Gout'\n        elif code.startswith('M15'):\n            return 'Polyarthrosis (osteoarthritis)'\n        elif code.startswith('M17'):\n            return 'Primary osteoarthritis of knee'\n        elif code.startswith('M18'):\n            return 'Primary osteoarthritis of first carpometacarpal joint'\n        elif code.startswith('M19'):\n            return 'Other and unspecified osteoarthritis'\n        elif code.startswith('M20'):\n            return 'Deformities of toe(s)'\n        elif code.startswith('M21'):\n            return 'Other acquired deformities of limbs'\n        elif code.startswith('M22'):\n            return 'Disorder of patella'\n        elif code.startswith('M23'):\n            return 'Internal derangement of knee'\n        elif code.startswith('M24'):\n            return 'Other specific joint derangements'\n        elif code.startswith('M25'):\n            return 'Other joint disorder, not elsewhere classified'\n        elif code.startswith('M26'):\n            return 'Dentofacial anomalies [including malocclusion]'\n        elif code.startswith('M27'):\n            return 'Other diseases of jaws'\n        elif code.startswith('M30'):\n            return 'Polyarteritis nodosa and related conditions'\n        elif code.startswith('M31'):\n            return 'Other necrotizing vasculitides'\n        elif code.startswith('M34'):\n            return 'Systemic sclerosis [scleroderma]'\n        elif code.startswith('M35'):\n            return 'Other systemic involvement of connective tissue'\n        elif code.startswith('M40'):\n            return 'Kyphosis and lordosis'\n        elif code.startswith('M41'):\n            return 'Scoliosis'\n        elif code.startswith('M42'):\n            return 'Spinal osteochondrosis'\n        elif code.startswith('M43'):\n            return 'Other deforming dorsopathies'\n        elif code.startswith('M44'):\n            return 'Spondylolysis'\n        elif code.startswith('M45'):\n            return 'Ankylosing spondylitis'\n        elif code.startswith('M46'):\n            return 'Other inflammatory spondylopathies'\n        elif code.startswith('M47'):\n            return 'Spondylosis'\n        elif code.startswith('M48'):\n            return 'Other spondylopathies'\n        elif code.startswith('M50'):\n            return 'Cervical disc disorders'\n        elif code.startswith('M51'):\n            return 'Thoracic, thoracolumbar and lumbosacral intervertebral disc disorders'\n        elif code.startswith('M53'):\n            return 'Other and unspecified dorsopathies'\n        elif code.startswith('M54'):\n            return 'Dorsalgia (back pain)'\n        elif code.startswith('M60'):\n            return 'Myositis'\n        elif code.startswith('M62'):\n            return 'Other disorders of muscle'\n        elif code.startswith('M65'):\n            return 'Synovitis and tenosynovitis'\n        elif code.startswith('M67'):\n            return 'Other disorders of synovium and tendon'\n        elif code.startswith('M70'):\n            return 'Soft tissue disorders related to use, overuse and pressure'\n        elif code.startswith('M71'):\n            return 'Other bursopathies'\n        elif code.startswith('M72'):\n            return 'Fibrosis of muscle fascia and other soft tissue'\n        elif code.startswith('M73'):\n            return 'Soft tissue disorders in diseases classified elsewhere'\n        elif code.startswith('M74'):\n            return 'Unspecified soft tissue disorder'\n        elif code.startswith('M75'):\n            return 'Shoulder lesions'\n        elif code.startswith('M76'):\n            return 'Enthesopathies, lower limb, excluding foot'\n        elif code.startswith('M77'):\n            return 'Other enthesopathies'\n        elif code.startswith('M78'):\n            return 'Other disorder related to hypersensitivity of muscle fascia and other soft tissue'\n        elif code.startswith('M79'):\n            return 'Other and unspecified soft tissue disorders, not elsewhere classified'\n        elif code.startswith('M80'):\n            return 'Osteoporosis with current pathological fracture'\n        elif code.startswith('M81'):\n            return 'Osteoporosis without current pathological fracture'\n        elif code.startswith('M83'):\n            return 'Adult osteomalacia'\n        elif code.startswith('M84'):\n            return 'Disorder of continuity of bone'\n        elif code.startswith('M85'):\n            return 'Other disorders of bone density and structure'\n        elif code.startswith('M86'):\n            return 'Osteomyelitis'\n        elif code.startswith('M87'):\n            return 'Osteonecrosis'\n        elif code.startswith('M88'):\n            return 'Osteitis deformans [Paget\\'s disease of bone]'\n        elif code.startswith('M89'):\n            return 'Other disorders of bone'\n        elif code.startswith('M90'):\n            return 'Osteopathies and chondropathies in diseases classified elsewhere'\n        elif code.startswith('M91
            "raw_input": "*** Begin Patch\n*** Update File: /Users/matthewgold/code/jupyter_projects/Readmission_Full_Analysis.ipynb\n@@\n-    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n-    \"palette_c = plt.cm.tab10.colors\\n\",\n-    \"fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n-    \"for cl in sorted(set(cluster_labels)):\\n\",\n-    \"    mask = cluster_labels == cl\\n\",\n-    \"    lbl  = f'Noise (n={mask.sum()})' if cl == -1 else f'Cluster {cl} (n={mask.sum()})'\\n\",\n-    \"    col  = 'lightgray' if cl == -1 else palette_c[cl % 10]\\n\",\n-    \"    ax.scatter(embedding[mask, 0], embedding[mask, 1],\\n\",\n-    \"               c=[col], alpha=0.35 if cl == -1 else 0.65, s=10, label=lbl, rasterized=True)\\n\",\n+    \"# \u2500\u2500 Derive human-readable cluster names \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n+    \"base_df = model_df_unscaled if 'model_df_unscaled' in globals() else model_df\\n\",\n+    \"mdf_r = base_df.reset_index(drop=True)\\n\",\n+    \"mdf_r['cluster'] = cluster_labels\\n\",\n+    \"\\n\",\n+    \"cont_vars = ['age', 'ace_score', 'los_days', 'n_dsm5_categories']\\n\",\n+    \"bin_vars  = ['has_medical_comorbidity', 'has_adhd', 'has_trauma', 'has_asd', 'had_restraints']\\n\",\n+    \"overall_mean = {v: mdf_r[v].mean() for v in cont_vars + bin_vars}\\n\",\n+    \"overall_sd   = {v: mdf_r[v].std(ddof=0) for v in cont_vars}\\n\",\n+    \"overall_bin_sd = {v: np.sqrt(overall_mean[v] * (1 - overall_mean[v])) for v in bin_vars}\\n\",\n+    \"\\n\",\n+    \"_name_map = {\\n\",\n+    \"    'age': ('Older', 'Younger'),\\n\",\n+    \"    'ace_score': ('High ACE', 'Low ACE'),\\n\",\n+    \"    'los_days': ('Long LOS', 'Short LOS'),\\n\",\n+    \"    'n_dsm5_categories': ('High DSM burden', 'Low DSM burden'),\\n\",\n+    \"    'has_medical_comorbidity': ('More Med Comorb', 'Less Med Comorb'),\\n\",\n+    \"    'has_adhd': ('More ADHD', 'Less ADHD'),\\n\",\n+    \"    'has_trauma': ('More Trauma', 'Less Trauma'),\\n\",\n+    \"    'has_asd': ('More ASD', 'Less ASD'),\\n\",\n+    \"    'had_restraints': ('More Restraints', 'Less Restraints'),\\n\",\n+    \"}\\n\",\n+    \"\\n\",\n+    \"cluster_names = {}\\n\",\n+    \"for cl in sorted(set(cluster_labels)):\\n\",\n+    \"    if cl == -1:\\n\",\n+    \"        cluster_names[cl] = 'Noise'\\n\",\n+    \"        continue\\n\",\n+    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n+    \"    scores = {}\\n\",\n+    \"    for v in cont_vars:\\n\",\n+    \"        sd = overall_sd.get(v, 0)\\n\",\n+    \"        scores[v] = (sub[v].mean() - overall_mean[v]) / sd if sd and not np.isnan(sd) else 0\\n\",\n+    \"    for v in bin_vars:\\n\",\n+    \"        sd = overall_bin_sd.get(v, 0)\\n\",\n+    \"        scores[v] = (sub[v].mean() - overall_mean[v]) / sd if sd and not np.isnan(sd) else 0\\n\",\n+    \"    top = sorted(scores.items(), key=lambda kv: abs(kv[1]), reverse=True)[:2]\\n\",\n+    \"    labels = []\\n\",\n+    \"    for v, z in top:\\n\",\n+    \"        hi, lo = _name_map[v]\\n\",\n+    \"        labels.append(hi if z >= 0 else lo)\\n\",\n+    \"    cluster_names[cl] = \\\" / \\\".join(labels)\\n\",\n+    \"\\n\",\n+    \"# \u2500\u2500 UMAP colored by cluster \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n+    \"palette_c = plt.cm.tab10.colors\\n\",\n+    \"fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n+    \"for cl in sorted(set(cluster_labels)):\\n\",\n+    \"    mask = cluster_labels == cl\\n\",\n+    \"    name = cluster_names.get(cl, f'Cluster {cl}')\\n\",\n+    \"    lbl  = f'Noise (n={mask.sum()})' if cl == -1 else f'C{cl}: {name} (n={mask.sum()})'\\n\",\n+    \"    col  = 'lightgray' if cl == -1 else palette_c[cl % 10]\\n\",\n+    \"    ax.scatter(embedding[mask, 0], embedding[mask, 1],\\n\",\n+    \"               c=[col], alpha=0.35 if cl == -1 else 0.65, s=10, label=lbl, rasterized=True)\\n\",\n@@\n-    \"# \u2500\u2500 Cluster profile table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n-    \"mdf_r = model_df.reset_index(drop=True)\\n\",\n-    \"mdf_r['cluster'] = cluster_labels\\n\",\n+    \"# \u2500\u2500 Cluster profile table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n@@\n-    \"rows = {}\\n\",\n-    \"for cl in sorted(set(cluster_labels)):\\n\",\n-    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n-    \"    rows[f'Cluster {cl}' if cl != -1 else 'Noise'] = {\\n\",\n+    \"rows = {}\\n\",\n+    \"for cl in sorted(set(cluster_labels)):\\n\",\n+    \"    sub = mdf_r[mdf_r['cluster'] == cl]\\n\",\n+    \"    row_key = f'C{cl}' if cl != -1 else 'Noise'\\n\",\n+    \"    rows[row_key] = {\\n\",\n+    \"        'Cluster name': cluster_names.get(cl, row_key),\\n\",\n@@\n-    \"profile_df = pd.DataFrame(rows).T\\n\",\n+    \"profile_df = pd.DataFrame(rows).T\\n\",\n*** End Patch"
          }
        ]

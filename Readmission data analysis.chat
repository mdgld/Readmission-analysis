          {
            "session_id": "a0ff27e5-b94e-4c50-8ea7-62cb5c6cfdd4",
            "selected_option_id": "allow_always",
            "title": "Show FAMD loadings cell source",
            "tool_call_id": "call_Pqhr2nfD7dXgqwLPP6hgaFRP",
            "permission_status": "resolved",
            "raw_output": {
              "detailedContent": "\"# \u2500\u2500 Post-hoc: FAMD Component Loadings Heatmap \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"from scipy.stats import pearsonr\\n\",\n    \"\\n\",\n    \"fc = np.array(famd_coords)\\n\",\n    \"n_comp_show = min(6, fc.shape[1])\\n\",\n    \"\\n\",\n    \"corr_matrix = np.zeros((len(feature_labels), n_comp_show))\\n\",\n    \"for i in range(len(feature_labels)):\\n\",\n    \"    for j in range(n_comp_show):\\n\",\n    \"        r, _ = pearsonr(fc[:, j], X_ml[:, i])\\n\",\n    \"        corr_matrix[i, j] = r\\n\",\n    \"\\n\",\n    \"loadings_df = pd.DataFrame(\\n\",\n    \"    corr_matrix,\\n\",\n    \"    index=feature_labels,\\n\",\n    \"    columns=[f'PC{j+1}' for j in range(n_comp_show)]\\n\",\n    \")\\n\",\n    \"\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Build descriptive column labels from top-loading feature per PC \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"_short = {\\n\",\n    \"    '# DSM-5 Categories':           '#DSM5-Cats',\\n\",\n    \"    'Length of Stay (days)':         'LOS',\\n\",\n    \"    'Physical Restraints':           'Restraints',\\n\",\n    \"    'Medical Comorbidity':           'Med.Comorb.',\\n\",\n    \"    'Diagnostic Complexity \u00d7 Age':   'Complexity\u00d7Age',\\n\",\n    \"    'Public Insurance (AHCCCS)':     'PublicIns.',\\n\",\n    \"    'Age at Admission':              'Age',\\n\",\n    \"    'ACE Score':                     'ACE',\\n\",\n    \"    'Any C-SSRS Flag':               'C-SSRS',\\n\",\n    \"    'Trauma/PTSD':                   'Trauma',\\n\",\n    \"    'NSSI Diagnosis':                'NSSI',\\n\",\n    \"}\\n\",\n    \"\\n\",\n    \"def pc_label(col):\\n\",\n    \"    s = loadings_df[col]\\n\",\n    \"    top_feat = s.abs().idxmax()\\n\",\n    \"    short = _short.get(top_feat, top_feat.split('(')[0].strip()[:14])\\n\",\n    \"    sign  = '+' if s[top_feat] > 0 else '\u2212'\\n\",\n    \"    return f'{col}\\\\n({sign}{short})'\\n\",\n    \"\\n\",\n    \"pc_col_labels = [pc_label(c) for c in loadings_df.columns]\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Plot \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"n_cols = 2 if n_comp_show > 1 else 1\\n\",\n    \"n_rows = int(np.ceil(n_comp_show / n_cols))\\n\",\n    \"row_h  = max(3.0, len(loadings_df) * 0.35)\\n\",\n    \"fig_w  = 4.6 * n_cols\\n\",\n    \"fig_h  = row_h * n_rows\\n\",\n    \"fig, axes = plt.subplots(n_rows, n_cols, figsize=(fig_w, fig_h), sharex=False)\\n\",\n    \"axes = np.atleast_1d(axes).flatten()\\n\",\n    \"\\n\",\n    \"for i, (ax, col, lbl) in enumerate(zip(axes[:n_comp_show], loadings_df.columns, pc_col_labels)):\\n\",\n    \"    s = loadings_df[col].sort_values(ascending=False)\\n\",\n    \"    s_df = pd.DataFrame({col: s.values}, index=s.index)\\n\",\n    \"    sns.heatmap(s_df, annot=True, fmt='.2f', cmap='RdBu_r',\\n\",\n    \"                center=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\\n\",\n    \"                xticklabels=[lbl],\\n\",\n    \"                cbar=(i == n_comp_show - 1),\\n\",\n    \"                cbar_kws={'label': 'Pearson r with FAMD component'},\\n\",\n    \"                annot_kws={'size': 8})\\n\",\n    \"    ax.set_ylabel('')\\n\",\n    \"    ax.tick_params(axis='y', labelsize=9)\\n\",\n    \"    ax.tick_params(axis='x', labelsize=10)\\n\",\n    \"\\n\",\n    \"for ax in axes[n_comp_show:]:\\n\",\n    \"    ax.axis('off')\\n\",\n    \"\\n\",\n    \"fig.suptitle('FAMD Component Loadings\\\\n'\\n\",\n    \"             '(Each component sorted by its own loading; header shows top-loading feature)',\\n\",\n    \"             fontsize=13, fontweight='bold')\\n\",\n    \"fig.text(0.02, 0.5, 'Feature', va='center', rotation=90, fontsize=11)\\n\",\n    \"plt.tight_layout(rect=[0.06, 0, 1, 0.93])\\n\",\n    \"plt.savefig('figures/Fig_FAMD_loadings.png')\\n\",\n    \"plt.show()\\n\",\n    \"print(\\\"\u2713 FAMD loadings saved\\\")\\n\",\n    \"\\n\",\n    \"print(\\\"\\\\nPC dominant features:\\\")\\n\",\n    \"for col, lbl in zip(loadings_df.columns, pc_col_labels):\\n\",\n    \"    top = loadings_df[col].abs().idxmax()\\n\",\n    \"    r   = loadings_df.loc[top, col]\\n\",\n    \"    print(f\\\"  {lbl.split(chr(10))[0]}  top feature: {top}  (r={r:+.3f})\\\")\\n\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n<exited with exit code 0>",
              "content": "\"# \u2500\u2500 Post-hoc: FAMD Component Loadings Heatmap \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"from scipy.stats import pearsonr\\n\",\n    \"\\n\",\n    \"fc = np.array(famd_coords)\\n\",\n    \"n_comp_show = min(6, fc.shape[1])\\n\",\n    \"\\n\",\n    \"corr_matrix = np.zeros((len(feature_labels), n_comp_show))\\n\",\n    \"for i in range(len(feature_labels)):\\n\",\n    \"    for j in range(n_comp_show):\\n\",\n    \"        r, _ = pearsonr(fc[:, j], X_ml[:, i])\\n\",\n    \"        corr_matrix[i, j] = r\\n\",\n    \"\\n\",\n    \"loadings_df = pd.DataFrame(\\n\",\n    \"    corr_matrix,\\n\",\n    \"    index=feature_labels,\\n\",\n    \"    columns=[f'PC{j+1}' for j in range(n_comp_show)]\\n\",\n    \")\\n\",\n    \"\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Build descriptive column labels from top-loading feature per PC \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"_short = {\\n\",\n    \"    '# DSM-5 Categories':           '#DSM5-Cats',\\n\",\n    \"    'Length of Stay (days)':         'LOS',\\n\",\n    \"    'Physical Restraints':           'Restraints',\\n\",\n    \"    'Medical Comorbidity':           'Med.Comorb.',\\n\",\n    \"    'Diagnostic Complexity \u00d7 Age':   'Complexity\u00d7Age',\\n\",\n    \"    'Public Insurance (AHCCCS)':     'PublicIns.',\\n\",\n    \"    'Age at Admission':              'Age',\\n\",\n    \"    'ACE Score':                     'ACE',\\n\",\n    \"    'Any C-SSRS Flag':               'C-SSRS',\\n\",\n    \"    'Trauma/PTSD':                   'Trauma',\\n\",\n    \"    'NSSI Diagnosis':                'NSSI',\\n\",\n    \"}\\n\",\n    \"\\n\",\n    \"def pc_label(col):\\n\",\n    \"    s = loadings_df[col]\\n\",\n    \"    top_feat = s.abs().idxmax()\\n\",\n    \"    short = _short.get(top_feat, top_feat.split('(')[0].strip()[:14])\\n\",\n    \"    sign  = '+' if s[top_feat] > 0 else '\u2212'\\n\",\n    \"    return f'{col}\\\\n({sign}{short})'\\n\",\n    \"\\n\",\n    \"pc_col_labels = [pc_label(c) for c in loadings_df.columns]\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Plot \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"n_cols = 2 if n_comp_show > 1 else 1\\n\",\n    \"n_rows = int(np.ceil(n_comp_show / n_cols))\\n\",\n    \"row_h  = max(3.0, len(loadings_df) * 0.35)\\n\",\n    \"fig_w  = 4.6 * n_cols\\n\",\n    \"fig_h  = row_h * n_rows\\n\",\n    \"fig, axes = plt.subplots(n_rows, n_cols, figsize=(fig_w, fig_h), sharex=False)\\n\",\n    \"axes = np.atleast_1d(axes).flatten()\\n\",\n    \"\\n\",\n    \"for i, (ax, col, lbl) in enumerate(zip(axes[:n_comp_show], loadings_df.columns, pc_col_labels)):\\n\",\n    \"    s = loadings_df[col].sort_values(ascending=False)\\n\",\n    \"    s_df = pd.DataFrame({col: s.values}, index=s.index)\\n\",\n    \"    sns.heatmap(s_df, annot=True, fmt='.2f', cmap='RdBu_r',\\n\",\n    \"                center=0, vmin=-1, vmax=1, linewidths=0.4, ax=ax,\\n\",\n    \"                xticklabels=[lbl],\\n\",\n    \"                cbar=(i == n_comp_show - 1),\\n\",\n    \"                cbar_kws={'label': 'Pearson r with FAMD component'},\\n\",\n    \"                annot_kws={'size': 8})\\n\",\n    \"    ax.set_ylabel('')\\n\",\n    \"    ax.tick_params(axis='y', labelsize=9)\\n\",\n    \"    ax.tick_params(axis='x', labelsize=10)\\n\",\n    \"\\n\",\n    \"for ax in axes[n_comp_show:]:\\n\",\n    \"    ax.axis('off')\\n\",\n    \"\\n\",\n    \"fig.suptitle('FAMD Component Loadings\\\\n'\\n\",\n    \"             '(Each component sorted by its own loading; header shows top-loading feature)',\\n\",\n    \"             fontsize=13, fontweight='bold')\\n\",\n    \"fig.text(0.02, 0.5, 'Feature', va='center', rotation=90, fontsize=11)\\n\",\n    \"plt.tight_layout(rect=[0.06, 0, 1, 0.93])\\n\",\n    \"plt.savefig('figures/Fig_FAMD_loadings.png')\\n\",\n    \"plt.show()\\n\",\n    \"print(\\\"\u2713 FAMD loadings saved\\\")\\n\",\n    \"\\n\",\n    \"print(\\\"\\\\nPC dominant features:\\\")\\n\",\n    \"for col, lbl in zip(loadings_df.columns, pc_col_labels):\\n\",\n    \"    top = loadings_df[col].abs().idxmax()\\n\",\n    \"    r   = loadings_df.loc[top, col]\\n\",\n    \"    print(f\\\"  {lbl.split(chr(10))[0]}  top feature: {top}  (r={r:+.3f})\\\")\\n\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n<exited with exit code 0>"

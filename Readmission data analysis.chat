            "raw_input": {
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPY'\nimport pandas as pd\nimport pickle\nimport numpy as np\n\n# Load data\ndf = pd.read_csv(\"/Users/matthewgold/code/jupyter_projects/With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\nwith open('/tmp/comprehensive_icd_ref.pkl', 'rb') as f:\n    icd_ref = pickle.load(f)\n\nprint(f\"Dataset shape: {df.shape}\")\n\ndef extract_codes(code_string):\n    \"\"\"Extract codes from comma-separated string\"\"\"\n    if pd.isna(code_string):\n        return []\n    codes = [c.strip() for c in str(code_string).split(',')]\n    return [c for c in codes if c]  # Filter empty strings\n\ndef get_diagnosis_info(code):\n    \"\"\"Get diagnosis info from reference\"\"\"\n    if code in icd_ref:\n        info = icd_ref[code]\n        return {\n            'name': info.get('name', f'{code} [Unknown]'),\n            'category': info.get('category', 'Unknown'),\n            'dsm5_category': info.get('dsm5_category'),\n            'dsm5_code': info.get('dsm5_code'),\n        }\n    return {\n        'name': f'{code} [Unknown]',\n        'category': 'Unknown',\n        'dsm5_category': None,\n        'dsm5_code': None,\n    }\n\n# Parse the three diagnosis columns\ndiagnosis_records = []\n\nfor idx, row in df.iterrows():\n    mrn = row['MRN']\n    readmissions = row['Readmissions']\n    \n    # Visit Diagnoses\n    visit_codes = extract_codes(row['VisitDiags'])\n    for code in visit_codes:\n        info = get_diagnosis_info(code)\n        diagnosis_records.append({\n            'MRN': mrn,\n            'Readmissions': readmissions,\n            'diagnosis_type': 'Visit',\n            'icd_code': code,\n            'diagnosis_name': info['name'],\n            'icd_category': info['category'],\n            'dsm5_category': info['dsm5_category'],\n            'dsm5_code': info['dsm5_code'],\n        })\n    \n    # Non-Suicidal Self-Injury Diagnoses\n    nssi_codes = extract_codes(row['NonSuicidialDiags'])\n    for code in nssi_codes:\n        info = get_diagnosis_info(code)\n        diagnosis_records.append({\n            'MRN': mrn,\n            'Readmissions': readmissions,\n            'diagnosis_type': 'NSSI',\n            'icd_code': code,\n            'diagnosis_name': info['name'],\n            'icd_category': info['category'],\n            'dsm5_category': info['dsm5_category'],\n            'dsm5_code': info['dsm5_code'],\n        })\n    \n    # Chronic Diagnoses\n    chronic_codes = extract_codes(row['ChronicDiags'])\n    for code in chronic_codes:\n        info = get_diagnosis_info(code)\n        diagnosis_records.append({\n            'MRN': mrn,\n            'Readmissions': readmissions,\n            'diagnosis_type': 'Chronic',\n            'icd_code': code,\n            'diagnosis_name': info['name'],\n            'icd_category': info['category'],\n            'dsm5_category': info['dsm5_category'],\n            'dsm5_code': info['dsm5_code'],\n        })\n\n# Create expanded dataframe\ndiagnoses_df = pd.DataFrame(diagnosis_records)\n\nprint(f\"\\nParsed diagnoses: {len(diagnoses_df)} records from {len(df)} patients\")\nprint(f\"\\nDiagnosis distribution by type:\")\nprint(diagnoses_df['diagnosis_type'].value_counts())\n\nprint(f\"\\nTop 20 most common ICD codes:\")\ntop_codes = diagnoses_df['icd_code'].value_counts().head(20)\nfor code, count in top_codes.items():\n    name = diagnoses_df[diagnoses_df['icd_code'] == code]['diagnosis_name'].iloc[0]\n    print(f\"  {code}: {count} occurrences - {name}\")\n\n# DSM-5 mapping summary\ndsm5_mapped = diagnoses_df[diagnoses_df['dsm5_category'].notna()]\nprint(f\"\\nDSM-5 mapped diagnoses: {len(dsm5_mapped)}/{len(diagnoses_df)} ({100*len(dsm5_mapped)/len(diagnoses_df):.1f}%)\")\nprint(f\"\\nTop DSM-5 categories:\")\nprint(dsm5_mapped['dsm5_category'].value_counts().head(15))\n\n# Save for next step\ndiagnoses_df.to_csv('/tmp/parsed_diagnoses.csv', index=False)\nprint(f\"\\nSaved parsed diagnoses to /tmp/parsed_diagnoses.csv\")\nEOFPY\n",

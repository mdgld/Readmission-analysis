          {
            "selected_option_id": "allow_always",
            "raw_output": {
              "content": "\"name\": \"stdout\",\n     \"output_type\": \"stream\",\n     \"text\": [\n      \"Random Forest  \u2014 AUC: 0.686  |  AP: 0.171\\n\",\n      \"CatBoost       \u2014 AUC: 0.662  |  AP: 0.164\\n\",\n      \"Logistic Regr  \u2014 AUC: 0.667  |  AP: 0.162\\n\"\n     ]\n    }\n   ],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 ML: prepare feature matrix (same features + interactions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"from sklearn.model_selection import StratifiedKFold\\n\",\n    \"from sklearn.ensemble import RandomForestClassifier\\n\",\n    \"from sklearn.metrics import roc_auc_score, roc_curve, average_precision_score\\n\",\n    \"\\n\",\n    \"ml_cols = all_x_cols   # same features as logistic regression (incl. interactions)\\n\",\n    \"X_ml = model_df[ml_cols].values\\n\",\n    \"y_ml = model_df['readmitted'].values\\n\",\n    \"\\n\",\n    \"cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"rf = RandomForestClassifier(\\n\",\n    \"    n_estimators=500, max_depth=6, min_samples_leaf=10,\\n\",\n    \"    class_weight='balanced', random_state=42, n_jobs=-1\\n\",\n    \")\\n\",\n    \"rf_probs = np.zeros(len(y_ml))\\n\",\n    \"for train_idx, test_idx in cv.split(X_ml, y_ml):\\n\",\n    \"    rf.fit(X_ml[train_idx], y_ml[train_idx])\\n\",\n    \"    rf_probs[test_idx] = rf.predict_proba(X_ml[test_idx])[:, 1]\\n\",\n    \"\\n\",\n    \"rf_auc  = roc_auc_score(y_ml, rf_probs)\\n\",\n    \"rf_ap   = average_precision_score(y_ml, rf_probs)\\n\",\n    \"print(f\\\"Random Forest  \u2014 AUC: {rf_auc:.3f}  |  AP: {rf_ap:.3f}\\\")\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 CatBoost \u2014 imbalance-aware, conservative depth \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"# All features are numeric floats; no cat_features needed\\n\",\n    \"cat_model = CatBoostClassifier(\\n\",\n    \"    iterations=500,\\n\",\n    \"    depth=4,\\n\",\n    \"    learning_rate=0.05,\\n\",\n    \"    auto_class_weights='Balanced',\\n\",\n<exited with exit code 0>",
              "detailedContent": "\"name\": \"stdout\",\n     \"output_type\": \"stream\",\n     \"text\": [\n      \"Random Forest  \u2014 AUC: 0.686  |  AP: 0.171\\n\",\n      \"CatBoost       \u2014 AUC: 0.662  |  AP: 0.164\\n\",\n      \"Logistic Regr  \u2014 AUC: 0.667  |  AP: 0.162\\n\"\n     ]\n    }\n   ],\n   \"source\": [\n    \"\\n\",\n    \"# \u2500\u2500 ML: prepare feature matrix (same features + interactions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"from sklearn.model_selection import StratifiedKFold\\n\",\n    \"from sklearn.ensemble import RandomForestClassifier\\n\",\n    \"from sklearn.metrics import roc_auc_score, roc_curve, average_precision_score\\n\",\n    \"\\n\",\n    \"ml_cols = all_x_cols   # same features as logistic regression (incl. interactions)\\n\",\n    \"X_ml = model_df[ml_cols].values\\n\",\n    \"y_ml = model_df['readmitted'].values\\n\",\n    \"\\n\",\n    \"cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"rf = RandomForestClassifier(\\n\",\n    \"    n_estimators=500, max_depth=6, min_samples_leaf=10,\\n\",\n    \"    class_weight='balanced', random_state=42, n_jobs=-1\\n\",\n    \")\\n\",\n    \"rf_probs = np.zeros(len(y_ml))\\n\",\n    \"for train_idx, test_idx in cv.split(X_ml, y_ml):\\n\",\n    \"    rf.fit(X_ml[train_idx], y_ml[train_idx])\\n\",\n    \"    rf_probs[test_idx] = rf.predict_proba(X_ml[test_idx])[:, 1]\\n\",\n    \"\\n\",\n    \"rf_auc  = roc_auc_score(y_ml, rf_probs)\\n\",\n    \"rf_ap   = average_precision_score(y_ml, rf_probs)\\n\",\n    \"print(f\\\"Random Forest  \u2014 AUC: {rf_auc:.3f}  |  AP: {rf_ap:.3f}\\\")\\n\",\n    \"\\n\",\n    \"# \u2500\u2500 CatBoost \u2014 imbalance-aware, conservative depth \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"# All features are numeric floats; no cat_features needed\\n\",\n    \"cat_model = CatBoostClassifier(\\n\",\n    \"    iterations=500,\\n\",\n    \"    depth=4,\\n\",\n    \"    learning_rate=0.05,\\n\",\n    \"    auto_class_weights='Balanced',\\n\",\n<exited with exit code 0>"

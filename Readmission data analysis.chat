es from dataset\nall_dataset_codes = set()\nfor col in ['VisitDiags', 'NonSuicidialDiags', 'ChronicDiags']:\n    for cell in df[col].dropna():\n        codes = extract_codes(cell)\n        all_dataset_codes.update(codes)\n\nall_dataset_codes = sorted(all_dataset_codes)\nprint(f\"\\nUnique codes in dataset: {len(all_dataset_codes)}\")\n\n# Find unmapped codes\nunmapped = [c for c in all_dataset_codes if c not in combined_map]\nprint(f\"Unmapped codes: {len(unmapped)}\")\nprint(f\"\\nFirst 30 unmapped codes:\")\nfor code in unmapped[:30]:\n    print(f\"  {code}\")\n\n# Save status\nprint(f\"\\nCoverage: {len([c for c in all_dataset_codes if c in combined_map])}/{len(all_dataset_codes)} codes mapped\")\nEOF\n"

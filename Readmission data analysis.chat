              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOF'\nimport pandas as pd\nimport json\n\n# Load the psychiatric mapping\nwith open('/tmp/icd_psychiatric_mapping.json', 'r') as f:\n    psych_map = json.load(f)\n\n# Common comorbid non-psychiatric conditions found in the dataset\n# These are commonly seen with psychiatric rehospitalizations\ncomorbid_conditions = {\n    # Endocrine/Metabolic\n    'E10.9': {'name': 'Type 1 diabetes mellitus without complications', 'category': 'Medical Comorbidity - Metabolic'},\n    'E11.9': {'name': 'Type 2 diabetes mellitus without complications', 'category': 'Medical Comorbidity - Metabolic'},\n    'E66.9': {'name': 'Obesity, unspecified', 'category': 'Medical Comorbidity - Metabolic'},\n    'E66.01': {'name': 'Obesity due to excess calories', 'category': 'Medical Comorbidity - Metabolic'},\n    'E78.5': {'name': 'Lipoid storage disorder, unspecified', 'category': 'Medical Comorbidity - Metabolic'},\n    \n    # Neurological\n    'G40.909': {'name': 'Unspecified epilepsy with no intractability, not in remission', 'category': 'Medical Comorbidity - Neurological'},\n    'G40.209': {'name': 'Complex partial seizures, not in remission', 'category': 'Medical Comorbidity - Neurological'},\n    'G47.33': {'name': 'Obstructive sleep apnea, moderate', 'category': 'Medical Comorbidity - Sleep'},\n    'G80.8': {'name': 'Cerebral palsy, unspecified', 'category': 'Medical Comorbidity - Neurological'},\n    'G91.9': {'name': 'Hydrocephalus, unspecified', 'category': 'Medical Comorbidity - Neurological'},\n    'G93.89': {'name': 'Other specified disorders of brain', 'category': 'Medical Comorbidity - Neurological'},\n    \n    # Respiratory\n    'J45.40': {'name': 'Moderate intermittent asthma', 'category': 'Medical Comorbidity - Respiratory'},\n    'J45.41': {'name': 'Moderate persistent asthma', 'category': 'Medical Comorbidity - Respiratory'},\n    'J30.9': {'name': 'Allergy, uns
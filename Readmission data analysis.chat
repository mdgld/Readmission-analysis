d', 'category': 'Mood'},\n    'F32.1': {'name': 'Major depressive disorder, single episode, moderate', 'dsm5': 'Major Depressive Disorder, Single Episode, Moderate', 'category': 'Mood'},\n    'F32.2': {'name': 'Major depressive disorder, single episode, severe without psychotic features', 'dsm5': 'Major Depressive Disorder, Single Episode, Severe', 'category': 'Mood'},\n    'F32.3': {'name': 'Major depressive disorder, single episode, severe with psychotic features', 'dsm5': 'Major Depressive Disorder, Single Episode, Severe with Psychotic Features', 'category': 'Mood'},\n    'F32.4': {'name': 'Major depressive disorder, single episode, in partial remission', 'dsm5': 'Major Depressive Disorder, Single Episode, in Partial Remission', 'category': 'Mood'},\n    'F32.5': {'name': 'Major depressive disorder, single episode, in full remission', 'dsm5': 'Major Depressive Disorder, Single Episode, in Full Remission', 'category': 'Mood'},\n    'F32.8': {'name': 'Other depressive episodes', 'dsm5': None, 'category': 'Mood'},\n    'F32.81': {'name': 'Depressive episode with predominantly dissociative symptoms', 'dsm5': None, 'category': 'Mood'},\n    'F32.89': {'name': 'Other specified depressive episodes', 'dsm5': None, 'category': 'Mood'},\n    'F32.9': {'name': 'Major depressive disorder, single episode, unspecified', 'dsm5': 'Major Depressive Disorder, Single Episode, Unspecified', 'category': 'Mood'},\n    'F32.A': {'name': 'Major depressive disorder, single episode, with anxious distress', 'dsm5': 'Major Depressive Disorder with Anxious Distress', 'category': 'Mood'},\n    'F33.0': {'name': 'Major depressive disorder, recurrent, mild', 'dsm5': 'Major Depressive Disorder, Recurrent, Mild', 'category': 'Mood'},\n    'F33.1': {'name': 'Major depressive disorder, recurrent, moderate', 'dsm5': 'Major Depressive Disorder, Recurrent, Moderate', 'category': 'Mood'},\n    'F33.2': {'name': 'Major depressive disorder, recurrent, severe without psychotic features', 'dsm5': 'Major Depressive Disorder, Recurrent, Severe', 'category': 'Mood'},\n    'F33.3': {'name': 'Major depressive disorder, recurrent, severe with psychotic features', 'dsm5': 'Major Depressive Disorder, Recurrent, Severe with Psychotic Features', 'category': 'Mood'},\n    'F33.40': {'name': 'Major depressive disorder, recurrent, in remission, unspecified', 'dsm5': 'Major Depressive Disorder, Recurrent, in Remission', 'category': 'Mood'},\n    'F33.41': {'name': 'Major depressive disorder, recurrent, in partial remission', 'dsm5': 'Major Depressive Disorder, Recurrent, in Partial Remission', 'category': 'Mood'},\n    'F33.42': {'name': 'Major depressive disorder, recurrent, in full remission', 'dsm5': 'Major Depressive Disorder, Recurrent, in Full Remission', 'category': 'Mood'},\n    'F33.8': {'name': 'Other recurrent depressive disorders', 'dsm5': None, 'category': 'Mood'},\n    'F33.9': {'name': 'Major depressive disorder, recurrent, unspecified', 'dsm5': 'Major Depressive Disorder, Recurrent, Unspecified', 'category': 'Mood'},\n    'F34.0': {'name': 'Cyclothymia', 'dsm5': 'Cyclothymia', 'category': 'Mood'},\n    'F34.1': {'name': 'Dysthymia (Persistent Depressive Disorder)', 'dsm5': 'Persistent Depressive Disorder (Dysthymia)', 'category': 'Mood'},\n    'F34.8': {'name': 'Other persistent mood disorders', 'dsm5': None, 'category': 'Mood'},\n    'F34.81': {'name': 'Disruptive mood dysregulation disorder', 'dsm5': 'Disruptive Mood Dysregulation Disorder', 'category': 'Mood'},\n    'F34.89': {'name': 'Other specified persistent mood disorder', 'dsm5': None, 'category': 'Mood'},\n    'F34.9': {'name': 'Persistent mood disorder, unspecified', 'dsm5': None, 'category': 'Mood'},\n    'F39': {'name': 'Unspecified mood disorder', 'dsm5': None, 'category': 'Mood'},\n    \n    # ============= BIPOLAR DISORDERS =============\n    'F30.10': {'name': 'Manic episode without psychotic symptoms, mild', 'dsm5': 'Bipolar I Disorder, Current or Most Recent Episode Manic', 'category': 'Mood'},\
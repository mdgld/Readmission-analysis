      "raw_time": false,
      "time": 1780269379.315957,
      "metadata": {
        "tool_calls": [
          {
            "raw_input": {
              "content": "\n# \u2500\u2500 FAMD: Factor Analysis of Mixed Data \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Treats binary flags as categorical, continuous vars as quantitative\n\nfamd_df = pd.DataFrame(X_ml, columns=ml_cols)\n\n# Columns with only 0/1 values \u2192 categorical for FAMD\nbinary_cols = [c for c in ml_cols\n               if set(np.unique(famd_df[c].values)).issubset({0.0, 1.0})]\ncontinuous_cols = [c for c in ml_cols if c not in binary_cols]\n\nprint(f\"Continuous features ({len(continuous_cols)}): {continuous_cols}\")\nprint(f\"Binary/categorical features ({len(binary_cols)}): {binary_cols}\")\n\n# Convert binary cols to string so prince treats them as qualitative\nfor c in binary_cols:\n    famd_df[c] = famd_df[c].astype(int).astype(str)\n\nfamd = prince.FAMD(n_components=10, n_iter=5, random_state=42)\nfamd = famd.fit(famd_df)\nfamd_coords = famd.transform(famd_df)\n\n# percentage_of_variance_ gives % variance explained per component\npov = famd.percentage_of_variance_\nprint(f\"\\nFAMD % variance explained by component:\")\nfor i, v in enumerate(pov):\n    print(f\"  PC{i+1}: {v:.1f}%\")\nprint(f\"  Total (10 PCs): {sum(pov):.1f}%\")\n",
              "cell_id": "e72dce5e-73d0-478e-acd3-fc2c4fe09232",
              "file_path": "Readmission_Full_Analysis.ipynb"
            },
            "raw_output": "{\"success\":true}",
            "kind": "other",
            "session_id": "50829d6f-f7a0-444f-9463-c05c069a94c6",

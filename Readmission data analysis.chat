              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 9b: SHAP summary plot \u2014 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# rf_full is already fitted in the feature importance cell above\nexplainer_rf   = shap.TreeExplainer(rf_full)\nshap_values_rf = explainer_rf.shap_values(X_ml)\n# sklearn RF returns [class0_shap, class1_shap]; take class1 (readmitted)\nshap_rf_pos = shap_values_rf[1] if isinstance(shap_values_rf, list) else shap_values_rf\n\nfig, ax = plt.subplots(figsize=(10, 10))\nshap.summary_plot(shap_rf_pos, X_ml, feature_names=feature_labels,\n                  show=False, plot_size=None, max_display=20)\nax = plt.gca()\nax.set_title('SHAP Feature Importance (Random Forest)\\nImpact on Readmission Probability',\n             fontsize=15, fontweight='bold', pad=15)\nplt.tight_layout()\nplt.savefig('figures/Fig9b_SHAP_RF_summary.png')\nplt.show()\nprint(\"\u2713 Fig 9b saved\")\n"

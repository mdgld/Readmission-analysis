              "description": "Create final summary tables and analysis",
              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPY'\nimport pandas as pd\nimport json\nimport pickle\n\n# Load data\nwith open('comprehensive_icd_ref.pkl', 'rb') as f:\n    icd_ref = pickle.load(f)\n\nannotated_df = pd.read_csv('annotated_psychiatric_data.csv')\ndiagnoses_df = pd.read_csv('diagnoses_long_form.csv')\n\n# Create DSM-5 category summary\ndsm5_summary = diagnoses_df[diagnoses_df['dsm5_category'].notna()].groupby('dsm5_category').agg({\n    'MRN': 'nunique',\n    'icd_code': 'count',\n}).rename(columns={'MRN': 'Unique_Patients', 'icd_code': 'Total_Occurrences'}).sort_values('Total_Occurrences', ascending=False)\n\ndsm5_summary.to_csv('DSM5_Category_Summary.csv')\nprint(f\"DSM-5 Category Summary: DSM5_Category_Summary.csv\")\nprint(f\"  {len(dsm5_summary)} DSM-5 categories represented\\n\")\nprint(dsm5_summary)\n\n# Readmission analysis by diagnosis - merge correctly\nreadmit_df = diagnoses_df[['MRN', 'diagnosis_type', 'dsm5_category']].copy()\nreadmit_df = readmit_df.merge(annotated_df[['MRN', 'Readmissions']], on='MRN')\nreadmit_df['Readmitted'] = readmit_df['Readmissions'] > 0\n\ndsm5_readmit = readmit_df[readmit_df['dsm5_category'].notna()].groupby('dsm5_category').agg({\n    'Readmitted': 'sum',\n    'MRN': 'nunique',\n}).rename(columns={'Readmitted': 'Readmitted_Count', 'MRN': 'Unique_Patients'})\ndsm5_readmit['Readmission_Rate_%'] = (100 * dsm5_readmit['Readmitted_Count'] / dsm5_readmit['Unique_Patients']).round(1)\ndsm5_readmit = dsm5_readmit.sort_values('Readmission_Rate_%', ascending=False)\n\ndsm5_readmit.to_csv('DSM5_Readmission_Analysis.csv')\nprint(f\"\\n\\nReadmission Analysis by DSM-5 Category: DSM5_Readmission_Analysis.csv\\n\")\nprint(dsm5_readmit.head(20))\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"\u2713 ANALYSIS COMPLETE!\")\nprint(\"=\"*70)\nprint(\"\\nGenerated files:\")\nprint(\"  1. ICD10_to_DSM5_Reference.csv\")\nprint(\"     - 1,863 unique ICD-10 codes mapped to diagnosis names\")\nprint(\"     - Includes DSM-5 TR category and code\")\nprint(\"     - Ranked by frequency in dataset\")\nprint()\nprint(\"  2. DSM5_Category_Summary.csv\")\nprint(\"     - Summary statistics for each DSM-5 category\")\nprint(\"     - Number of unique patients and total occurrences\")\nprint()\nprint(\"  3. DSM5_Readmission_Analysis.csv\")\nprint(\"     - Readmission rates by DSM-5 diagnostic category\")\nprint(\"     - Shows which diagnoses are associated with higher readmission risk\")\nprint()\nprint(\"  4. annotated_psychiatric_data.csv\")\nprint(\"     - Original patient data with added annotation columns:\")\nprint(\"       * VisitDiags_Names, NonSuicidialDiags_Names, ChronicDiags_Names\")\nprint(\"       * VisitDiags_DSM5, NonSuicidialDiags_DSM5, ChronicDiags_DSM5\")\nprint(\"       * DSM5 counts for each diagnosis column\")\nprint()\nprint(\"  5. diagnoses_long_form.csv\")\nprint(\"     - 27,884 diagnosis records in long format\")\nprint(\"     - One row per diagnosis per patient\")\nprint(\"     - Useful for detailed analysis and trend detection\")\nprint()\nprint(\"KEY FINDINGS:\")\nprint(\"=\" * 70)\nprint(f\"Total patients: {len(annotated_df)}\")\nprint(f\"Patients with readmissions: {(annotated_df['Readmissions'] > 0).sum()}\")\nprint(f\"Overall readmission rate: {100*(annotated_df['Readmissions'] > 0).mean():.1f}%\")\nprint()\nprint(\"Most common diagnoses (DSM-5 category):\")\nfor cat, count in dsm5_summary['Total_Occurrences'].head(5).items():\n    print(f\"  - {cat}: {count} occurrences\")\nprint()\nprint(\"Highest readmission rates:\")\nfor cat, rate in dsm5_readmit['Readmission_Rate_%'].head(5).items():\n    print(f\"  - {cat}: {rate}%\")\nEOFPY\n"

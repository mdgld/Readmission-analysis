            "title": "cat << 'EOF' > update_logic_v2.py import nbformat def update_notebook(): with open(\"Readmission_Full_Analysis.ipynb\", \"r\") as f: nb = nbformat.read(f, as_version=4) for cell in nb.cells: if cell.cell_type == \"code\": s = cell.source # Update Fig 1 loop to include index i for sigs if \"# \u2500\u2500 Fig 1:\" in s and \"for _, row in age_ra.iterrows():\" in s: s = s.replace( \"for _, row in age_ra.iterrows():\", \"for i, row in age_ra.reset_index().iterrows():\" ) # Fig 4: Quartile boundaries calculation and significance markers if \"# \u2500\u2500 Fig 4:\" in s and \"df['complexity_q'] =\" in s: # Add quartile calculation logic s = s.replace( \"df['complexity_q'] = pd.qcut(df['n_dsm5_categories'], q=4, \\n labels=['Q1\\\\n(Lowest)', 'Q2', 'Q3', 'Q4\\\\n(Highest)'],\\n duplicates='drop')\", \"q_bounds = pd.qcut(df['n_dsm5_categories'], q=4, duplicates='drop').unique().sort_values()\\n\" \" labels_4 = [f'Q{i+1} ({int(b.left)}-{int(b.right)})' for i, b in enumerate(q_bounds)]\\n\" \" df['complexity_q'] = pd.qcut(df['n_dsm5_categories'], q=4, labels=labels_4, duplicates='drop')\" ) # Add significance test compared to Q1 s = s.replace( \"for bar, (_, row) in zip(bars, q_rate.iterrows()):\", \"from statsmodels.stats.proportion import proportions_ztest\\n\" \" q1_rate = q_rate.iloc[0]['rate']\\n\" \" q1_n = q_rate.iloc[0]['n']\\n\" \" for bar, (_, row) in zip(bars, q_rate.iterrows()):\" ) s = s.replace( \"axes[1].text(bar.get_x() + bar.get_width()/2, row['rate'] * 100 + 1,\\n f\\\"{row['rate']*100:.1f}%\\\", ha='center', fontsize=11)\", \"_, p = proportions_ztest(row['rate']*row['n'], row['n'], value=q1_rate) if row.name > 0 else (0, 1)\\n\" \" sig_str = '*' if p < 0.05 else ''\\n\" \" axes[1].text(bar.get_x() + bar.get_width()/2, row['rate'] * 100 + ci[row.name]*100 + 1, sig_str, color='red', ha='center')\\n\" \" axes[1].text(bar.get_x() + bar.get_width()/2, row['rate'] * 100 + 1, f\\\"{row['rate']*100:.1f}%\\\", ha='center', fontsize=11)\" ) # Fig 5: No flag vs Red Flag comparison chart if \"# \u2500\u2500 Fig 5:\" in s and \"print(f'No Flag Rate:\" in s: s = s.replace( \"print(f'No Flag Rate: {no_flag_r:.1f}% | Red Flag Rate: {red_flag_r:.1f}%')\", \"fig_comp, ax_comp = plt.subplots(figsize=(6, 5))\\n\" \" ns_5 = [len(df[df['csrss_any']==0]), len(df[df['csrss_red']==1])]\\n\" \" rates_5 = [no_flag_r, red_flag_r]\\n\" \" errs_5 = [1.96 * np.sqrt((r/100)*(1-r/100)/n)*100 for r, n in zip(rates_5, ns_5)]\\n\" \" ax_comp.bar(['No Flag', 'Red Flag'], rates_5, yerr=errs_5, color=[BLUE, ORANGE], capsize=10)\\n\" \" ax_comp.set_title('Readmission Rate: No Flag vs Red Flag')\\n\" \" plt.show()\" ) cell.source = s with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: nbformat.write(nb, f) if __name__ == \"__main__\": update_notebook() EOF python3 update_logic_v2.py",

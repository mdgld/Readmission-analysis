            "raw_output": "(mcp__Jupyter_MCP_Server__add_cell completed with no output)",
            "permission_status": "resolved",
            "status": "completed",
            "selected_option_id": "allow",
            "session_id": "7ee154da-6f59-4d71-ae47-651b7f8dc518",
            "title": "mcp__Jupyter_MCP_Server__add_cell",
            "raw_input": {
              "cell_type": "code",
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Table 1: Descriptive statistics by readmission status \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\ndef pct(n, total): return f\"{n} ({100*n/total:.1f}%)\"\ndef mean_sd(series): return f\"{series.mean():.1f} \u00b1 {series.std():.1f}\"\ndef med_iqr(series): return f\"{series.median():.1f} [{series.quantile(.25):.1f}\u2013{series.quantile(.75):.1f}]\"\n\nra  = df[df['readmitted'] == 1]\nnra = df[df['readmitted'] == 0]\nrows = []\n\nfor label, vals, total in [('Not Readmitted', nra, len(nra)), ('Readmitted', ra, len(ra))]:\n    r = {'Group': label, 'N': total}\n    r['Age, mean\u00b1SD']              = mean_sd(vals['age'].dropna())\n    r['Male sex, n(%)']            = pct(vals['gender_male'].sum(), total)\n    r['Public insurance, n(%)']    = pct(vals['insurance_public'].sum(), total)\n    r['ACE score, median[IQR]']    = med_iqr(vals['ace_score'].dropna())\n    r['ACE \u22654, n(%)']             = pct(int(vals['ace_high'].sum()), int(vals['ace_high'].notna().sum()))\n    r['Restraints used, n(%)']     = pct(vals['had_restraints'].sum(), total)\n    r['Any C-SSRS flag, n(%)']    = pct(vals['csrss_any'].sum(), total)\n    r['LOS days, median[IQR]']     = med_iqr(vals['los_days'].dropna())\n    r['# visit diagnoses, mean\u00b1SD']= mean_sd(vals['n_visit_diags'])\n    r['# chronic diagnoses, mean\u00b1SD']=mean_sd(vals['n_chronic_diags'])\n    r['# DSM-5 categories, mean\u00b1SD']=mean_sd(vals['n_dsm5_categories'])\n    r['Medical comorbidity, n(%)'] = pct(vals['has_medical_comorbidity'].sum(), total)\n    r['NSSI diagnosis, n(%)']      = pct(vals['has_nssi'].sum(), total)\n    r['Trauma/PTSD, n(%)']         = pct(vals['has_trauma'].sum(), total)\n    r['ADHD, n(%)']                = pct(vals['has_adhd'].sum(), total)\n    r['ASD, n(%)']                 = pct(vals['has_asd'].sum(), total)\n    r['Conduct Disorder, n(%)']    = pct(vals['has_conduct'].sum(), total)\n    r['Depression, n(%)']          = pct(vals['has_depression'].sum(), total)\n    r['Anxiety, n(%)']             = pct(vals['has_anxiety'].sum(), total)\n    r['Bipolar, n(%)']             = pct(vals['has_bipolar'].sum(), total)\n    rows.append(r)\n\ntable1 = pd.DataFrame(rows).set_index('Group').T\ntable1.to_csv('figures/Table1_descriptive.csv')\nprint(\"Table 1: Characteristics by Readmission Status\")\nprint(\"=\" * 65)\nprint(table1.to_string())\n"

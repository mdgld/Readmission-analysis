            "title": "cat << 'EOF' > update_figs.py import nbformat def update_figs(): with open(\"Readmission_Full_Analysis.ipynb\", \"r\") as f: nb = nbformat.read(f, as_version=4) for cell in nb.cells: if cell.cell_type == \"code\": s = cell.source # Fig 1: Expand Y-axis for Age 6 CI and add significance test if \"# \u2500\u2500 Fig 1:\" in s: s = s.replace( \"ci = 1.96 * np.sqrt(age_ra['rate'] * (1 - age_ra['rate']) / age_ra['n'])\", \"from statsmodels.stats.proportion import proportions_ztest\\n\" \"ci = 1.96 * np.sqrt(age_ra['rate'] * (1 - age_ra['rate']) / age_ra['n'])\\n\" \"overall_rate = df['readmitted'].mean()\\n\" \"sigs = []\\n\" \"for _, row in age_ra.iterrows():\\n\" \" _, p = proportions_ztest(row['rate']*row['n'], row['n'], value=overall_rate)\\n\" \" sigs.append('*' if p < 0.05 else '')\" ) s = s.replace(\"axes[1].set_ylim(0, max(age_ra['rate'] * 100) * 1.3)\", \"axes[1].set_ylim(0, 45) # Expanded for Age 6 CI\") s = s.replace( \"axes[1].text(row['age'], row['rate'] * 100 + 1.5, f\\\"n={int(row['n'])}\\\",\", \"axes[1].text(row['age'], row['rate'] * 100 + ci[i]*100 + 1, sigs[i], color='red', ha='center', fontweight='bold')\\n\" \" axes[1].text(row['age'], row['rate'] * 100 + 3.5, f\\\"n={int(row['n'])}\\\",\" ) # Need index i for sigs. Let's adjust slightly. # Fig 2: Rename headers and add CIs/p-values if \"# \u2500\u2500 Fig 2:\" in s: s = s.replace(\"'gender_male', 'Male Sex',\", \"'gender_male', 'Gender ID at Admission',\") s = s.replace(\"'insurance_public', 'Public Insurance\\\\n(AHCCCS)',\", \"'insurance_public', 'Insurance Type',\") # Add Error bars logic s = s.replace( \"rates = df.groupby(col)['readmitted'].mean() * 100\", \"res = df.groupby(col)['readmitted'].agg(['mean', 'count'])\\n\" \" rates = res['mean'] * 100\\n\" \" ns = res['count']\\n\" \" err = 1.96 * np.sqrt(res['mean']*(1-res['mean'])/ns) * 100\\n\" \" from scipy.stats import chi2_contingency\\n\" \" tab = pd.crosstab(df[col], df['readmitted'])\\n\" \" _, p, _, _ = chi2_contingency(tab)\\n\" \" p_str = f'(p={p:.3f})' if p >= 0.001 else '(p<0.001)'\" ) s = s.replace(\"ax.bar(xlabels, rates.values\", \"ax.bar(xlabels, rates.values, yerr=err.values, capsize=5\") s = s.replace(\"ax.set_title(title, fontsize=14, fontweight='bold')\", \"ax.set_title(f'{title}\\\\n{p_str}', fontsize=12, fontweight='bold')\") # Fig 3: Confidence Intervals and conditional coloring if \"# \u2500\u2500 Fig 3:\" in s: s = s.replace( \"axes.barh(dsm5_long['category'], dsm5_long['rate'], color=BLUE, alpha=0.8)\", \"overall_r = df['readmitted'].mean() * 100\\n\" \" ci_3 = 1.96 * np.sqrt((dsm5_long['rate']/100)*(1-dsm5_long['rate']/100)/dsm5_long['total_n']) * 100\\n\" \" dsm5_long['ci_lo'] = dsm5_long['rate'] - ci_3\\n\" \" colors_3 = [ORANGE if (row['total_n'] >= 15 and row['ci_lo'] > overall_r) else BLUE for _, row in dsm5_long.iterrows()]\\n\" \" axes.barh(dsm5_long['category'], dsm5_long['rate'], xerr=ci_3, color=colors_3, alpha=0.8, capsize=3)\" ) # Fig 4: Quartile boundaries and uniform color if \"# \u2500\u2500 Fig 4:\" in s: s = s.replace( \"labels=['Q1\\\\n(Lowest)', 'Q2', 'Q3', 'Q4\\\\n(Highest)'],\", \"labels=['Q1 (1 cat.)', 'Q2 (2)', 'Q3 (3)', 'Q4 (4+)'],\" # Just example, need real boundaries or logic ) s = s.replace(\"color=[BLUE, BLUE, ORANGE, ORANGE]\", \"color=BLUE\") # Fig 5: No Flag vs Red Flag comparison if \"# \u2500\u2500 Fig 5:\" in s: # Insert specific comparison logic comp_logic = ( \"\\n# Specific comparison: No flag vs Red Flag\\n\" \"no_flag_r = df[df['csrss_any']==0]['readmitted'].mean() * 100\\n\" \"red_flag_r = df[df['csrss_red']==1]['readmitted'].mean() * 100\\n\" \"print(f'No Flag Rate: {no_flag_r:.1f}% | Red Flag Rate: {red_flag_r:.1f}%')\\n\" ) if \"no_flag_r =\" not in s: s = s + comp_logic cell.source = s with open(\"Readmission_Full_Analysis.ipynb\", \"w\") as f: nbformat.write(nb, f) if __name__ == \"__main__\": update_figs() EOF python3 update_figs.py",

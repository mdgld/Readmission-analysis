s']   = df['VisitDiags'].apply(count_csv)\\n\",\n     \"df['n_chronic_diags'] = df['ChronicDiags'].apply(count_csv)\\n\",\n     \"df['n_total_diags']   = df['n_visit_diags'] + df['n_chronic_diags']\\n\",\n     \"\\n\",\n     \"def unique_dsm5_count(row):\\n\",\n     \"    cats = set()\\n\",\n     \"    for col in ['VisitDiags_DSM5Categories', 'ChronicDiags_DSM5Categories']:\\n\",\n     \"        val = row.get(col, '')\\n\",\n     \"        if pd.notna(val) and str(val).strip():\\n\",\n     \"            cats.update(c.strip() for c in str(val).split(';') if c.strip())\\n\",\n     \"    return len(cats)\\n\",\n     \"\\n\",\n     \"df['n_dsm5_categories'] = df.apply(unique_dsm5_count, axis=1)\\n\",\n     \"\\n\",\n     \"# \u2500\u2500 DSM-5 category flags \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n     \"all_dsm5 = (df['VisitDiags_DSM5Categories'].fillna('') + ';' +\\n\",\n     \"            df['ChronicDiags_DSM5Categories'].fillna('')).str.lower()\\n\",\n     \"\\n\",\n     \"CATEGORY_FLAGS = {\\n\",\n     \"    'has_nssi':        'non-suicidal self-injury',\\n\",\n     \"    'has_trauma':      'trauma and stressor',\\n\",\n     \"    'has_adhd':        'adhd',\\n\",\n     \"    'has_asd':         'autism spectrum',\\n\",\n     \"    'has_conduct':     'conduct disorder',\\n\",\n     \"    'has_depression':  'depressive disorders',\\n\",\n     \"    'has_anxiety':     'anxiety disorders',\\n\",\n     \"    'has_bipolar':     'bipolar',\\n\",\n     \"    'has_psychotic':   'psychotic',\\n\",\n     \"    'has_intellectual':'intellectual disability',\\n\",\n"

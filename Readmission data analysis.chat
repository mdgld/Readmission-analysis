              "command": "cd /Users/matthewgold/code/jupyter_projects && source venv/bin/activate && python3 << 'EOFPYTHON'\nimport pandas as pd\nimport numpy as np\n\n# Load complete reference\nref_df = pd.read_csv('ICD10_to_DSM5_Complete_Reference.csv')\n\n# Create lookup dictionaries\ncode_to_name = dict(zip(ref_df['ICD_Code'], ref_df['Description']))\ncode_to_dsm5 = dict(zip(ref_df['ICD_Code'], ref_df['DSM5_Category']))\n\n# Load patient data\ndf = pd.read_csv(\"With Ages GD1854RVSD_Psychiatric Rehospitalization In School-Aged Children.csv\", skiprows=2)\nlong_form = pd.read_csv('diagnoses_long_form_complete.csv')\n\n# Calculate readmission statistics\nprint(\"\\n\" + \"=\"*70)\nprint(\"FINAL READMISSION ANALYSIS\")\nprint(\"=\"*70)\n\n# Overall stats\nreadmitted = (df['Readmissions'] > 0).sum()\nreadmit_rate = 100 * readmitted / len(df)\nprint(f\"\\n\ud83d\udcca READMISSION OVERVIEW:\")\nprint(f\"  Patients with readmissions: {readmitted:,} / {len(df):,} ({readmit_rate:.1f}%)\")\n\n# By DSM-5 category\nprint(f\"\\n\ud83e\udde0 READMISSION RISK BY DSM-5 CATEGORY:\")\nreadmit_by_dsm5 = {}\nfor _, row in long_form.iterrows():\n    if pd.notna(row['dsm5_category']):\n        mrn = row['MRN']\n        cat = row['dsm5_category']\n        readmit = df[df['MRN'] == mrn]['Readmissions'].values\n        if len(readmit) > 0 and readmit[0] > 0:\n            if cat not in readmit_by_dsm5:\n                readmit_by_dsm5[cat] = {'readmitted': 0, 'total': 0}\n            readmit_by_dsm5[cat]['total'] += 1\n            readmit_by_dsm5[cat]['readmitted'] += 1\n\n# Get all DSM-5 categories and their total counts\nall_dsm5 = long_form['dsm5_category'].dropna().unique()\ndsm5_stats = {}\nfor cat in all_dsm5:\n    mrns_with_cat = long_form[long_form['dsm5_category'] == cat]['MRN'].unique()\n    readmitted_with_cat = df[df['MRN'].isin(mrns_with_cat) & (df['Readmissions'] > 0)]['MRN'].nunique()\n    dsm5_stats[cat] = {\n        'total_patients': len(mrns_with_cat),\n        'readmitted': readmitted_with_cat,\n        'rate': 100 * readmitted_with_cat / len(mrns_with_cat) if len(mrns_with_cat) > 0 else 0\n    }\n\n# Sort by readmission rate\nsorted_by_rate = sorted(dsm5_stats.items(), key=lambda x: x[1]['rate'], reverse=True)\n\nfor cat, stats in sorted_by_rate[:15]:\n    print(f\"  {cat[:45]:45} {stats['rate']:5.1f}% ({stats['readmitted']:3}/{stats['total_patients']:3} patients)\")\n\n# Export updated files confirmation\nprint(f\"\\n\u2705 EXPORTED DATA FILES:\")\nprint(f\"  \u2713 ICD10_to_DSM5_Complete_Reference.csv - All 1,863 codes with full descriptions\")\nprint(f\"  \u2713 annotated_psychiatric_data_complete.csv - 2,652 patients with mapped diagnoses\")\nprint(f\"  \u2713 diagnoses_long_form_complete.csv - 27,884 diagnosis records with descriptions\")\n\nprint(f\"\\n\ud83d\udccb FILES READY FOR ANALYSIS:\")\nprint(f\"  - Complete ICD-10 reference with DSM-5 TR mapping\")\nprint(f\"  - Patient-level data with diagnosis names and DSM-5 categories\")\nprint(f\"  - Long-form data for comorbidity and trend analysis\")\n\nEOFPYTHON\n",

            "status": "completed",
            "raw_input": {
              "file_path": "Readmission_Full_Analysis.ipynb",
              "content": "\n# \u2500\u2500 Fig 13: False Positives vs False Negatives across probability thresholds \u2500\u2500\nthresholds = np.linspace(0.01, 0.99, 300)\nfp_counts, fn_counts, tp_counts, tn_counts = [], [], [], []\n\nfor thresh in thresholds:\n    preds = (cat_probs >= thresh).astype(int)\n    tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n    fp_counts.append(fp)\n    fn_counts.append(fn)\n    tp_counts.append(tp)\n    tn_counts.append(tn)\n\nfig, ax = plt.subplots(figsize=(11, 6))\nax.plot(thresholds, fp_counts, color='#e74c3c', linewidth=2.5,\n        label='False Positives (non-readmissions incorrectly flagged)')\nax.plot(thresholds, fn_counts, color='#3498db', linewidth=2.5,\n        label='False Negatives (readmissions missed)')\n\n# Mark crossover point\ncrossover_idx = np.argmin(np.abs(np.array(fp_counts) - np.array(fn_counts)))\nax.axvline(thresholds[crossover_idx], color='purple', linestyle=':', linewidth=1.5,\n           label=f'FP = FN crossover (t \u2248 {thresholds[crossover_idx]:.2f})')\n\n# Reference lines at clinically common thresholds\nfor t, label in [(0.10, '10%'), (0.20, '20%'), (0.30, '30%'), (0.50, '50%')]:\n    ax.axvline(t, color='gray', linestyle='--', alpha=0.4, linewidth=1)\n    ax.text(t + 0.005, max(max(fp_counts), max(fn_counts)) * 0.92,\n            label, ha='left', fontsize=9, color='gray')\n\nax.set_xlabel('Probability Threshold', fontsize=13)\nax.set_ylabel('Count', fontsize=13)\nax.set_title('False Positives vs. False Negatives Across Thresholds\\n'\n             '(CatBoost, 10-Fold Cross-Validation Probabilities)', fontsize=14, fontweight='bold')\nax.legend(fontsize=11)\nax.spines['top'].set_visible(False)\nax.spines['right'].set_visible(False)\nplt.tight_layout()\nplt.savefig('figures/Fig13_FP_vs_FN.png')\nplt.show()\nprint(\"\u2713 Fig 13 saved\")\n",
              "cell_type": "code",
              "cell_id": "4e876b0c-1396-4bc7-85aa-fb099a375a57"

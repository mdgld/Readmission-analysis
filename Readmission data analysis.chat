              "file_path": "Readmission_Full_Analysis.ipynb",
              "cell_id": "86617da0-0a0f-42ca-8c19-4766295dcb6e",
              "content": "\n# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 CatBoost predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ntop3 = cat_imp.head(3).index.tolist()\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 5))\nfor ax, feat_label in zip(axes, top3):\n    feat_idx = feature_labels.index(feat_label)\n    shap.dependence_plot(\n        feat_idx, shap_values, X_ml,\n        feature_names=feature_labels,\n        ax=ax, show=False,\n        dot_size=12, alpha=0.4\n    )\n    ax.set_title(f'SHAP Dependence: {feat_label}', fontsize=13, fontweight='bold')\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('SHAP Dependence Plots \u2014 Top 3 CatBoost Predictors', \n             fontsize=15, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig11_SHAP_dependence.png')\nplt.show()\nprint(\"\u2713 Fig 11 saved\")\n"

              "cell_type": "code",
              "content": "\n# \u2500\u2500 Fig 2: Demographics panel (gender, insurance, C-SSRS, restraints) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 4, figsize=(18, 5))\n\nbinary_vars = [\n    ('gender_male',       'Male Sex',          ['Female', 'Male']),\n    ('insurance_public',  'Public Insurance\\n(AHCCCS)', ['Private', 'Public']),\n    ('csrss_any',         'Any C-SSRS Flag',   ['No Flag', 'Flag']),\n    ('had_restraints',    'Physical Restraints\\nUsed', ['No', 'Yes']),\n]\n\nfor ax, (col, title, xlabels) in zip(axes, binary_vars):\n    rates = df.groupby(col)['readmitted'].mean() * 100\n    counts = df.groupby(col)['readmitted'].count()\n    colors = [BLUE, ORANGE]\n    bars = ax.bar(xlabels, rates.values, color=colors, alpha=0.85, edgecolor='white', width=0.5)\n    for bar, n, rate in zip(bars, counts.values, rates.values):\n        ax.text(bar.get_x() + bar.get_width()/2, rate + 0.5, \n                f'{rate:.1f}%\\n(n={n})', ha='center', va='bottom', fontsize=11)\n    ax.set_title(title, fontsize=14, fontweight='bold')\n    ax.set_ylabel('Readmission Rate (%)')\n    ax.set_ylim(0, max(rates.values) * 1.35)\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('Readmission Rates by Demographic & Clinical Characteristics', \n             fontsize=16, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig2_demographics_panel.png')\nplt.show()\nprint(\"\u2713 Fig 2 saved\")\n"

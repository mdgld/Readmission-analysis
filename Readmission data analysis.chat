              "aggregated_output": "CELL 10\n\n# \u2500\u2500 Logistic regression: build feature matrix \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nFEATURES = {\n    # Demographics\n    'age':                   'Age at Admission',\n    'gender_male':           'Male Sex',\n    'insurance_public':      'Public Insurance (AHCCCS)',\n    # Clinical\n    'ace_score':             'ACE Score',\n    'had_restraints':        'Physical Restraints',\n    'csrss_any':             'Any C-SSRS Flag',\n---\nCELL 11\n\n# \u2500\u2500 Cohort Summary & Detailed Descriptive Statistics \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Continuous Readmissions\nprint(f\"Overall Readmission Stats (Continuous):\")\nprint(f\"  Mean # Readmissions: {df['Readmissions'].mean():.2f} \u00b1 {df['Readmissions'].std():.2f}\")\nprint(f\"  Readmitted (%):      {df['readmitted'].mean():.1%}\")\n\n# ACE Score Detailed\nace_sub = df['ace_score'].dropna()\nprint(f\"\\nACE Score Stats:\")\nprint(f\"  Mean:   {ace_sub.mean():.1f} \u00b1 {ace_sub.std():.1f}\")\nprint(f\"  Median: {ace_sub.median():.1f}\")\n---\nCELL 12\n\n# \u2500\u2500 Cohort Descriptive Visualizations \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(2, 2, figsize=(16, 11))\n\n# 1. Readmission Count Distribution\nrc_counts = df['Readmissions'].fillna(0).value_counts().sort_index()\nrc_mean = df['Readmissions'].fillna(0).mean()\nrc_sd   = df['Readmissions'].fillna(0).std()\naxes[0, 0].bar(rc_counts.index.astype(int), rc_counts.values, color=BLUE, alpha=0.8, edgecolor='white')\naxes[0, 0].set_title(f\"Readmission Counts\\n(Mean={rc_mean:.2f}, SD={rc_sd:.2f})\", fontweight='bold')\naxes[0, 0].set_xlabel(\"# of Readmissions\")\naxes[0, 0].set_ylabel(\"Count\")\n---\nCELL 13\n\n# \u2500\u2500 Logistic regression model + interaction terms \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nimport statsmodels.api as sm\n\n# Add clinically motivated interaction terms\nmodel_df['age_x_conduct']  = model_df['age'] * model_df['has_conduct']\nmodel_df['age_x_asd']      = model_df['age'] * model_df['has_asd']\nmodel_df['ace_x_trauma']   = model_df['ace_score'] * model_df['has_trauma']\nmodel_df['nssi_x_csrss']   = model_df['has_nssi'] * model_df['csrss_any']\nmodel_df['complexity_x_age'] = model_df['n_dsm5_categories'] * model_df['age']\nmodel_df['csrss_level'] = (model_df['csrss_red'] * 3 + model_df['csrss_orange'] * 2 + model_df['csrss_yellow'] * 1).fillna(0).astype(int)\nmodel_df['nssi_x_csrss_red'] = model_df['has_nssi'] * model_df['csrss_red']\n---\nCELL 14\n\n# \u2500\u2500 Fig 7: Forest plot \u2014 odds ratios from logistic regression \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nall_labels = {**FEATURES, **interaction_labels}\n\ncoef_df = pd.DataFrame({\n    'feature': logit_model.params.index,\n    'coef':    logit_model.params.values,\n    'se':      logit_model.bse.values,\n    'pval':    logit_model.pvalues.values,\n}).query(\"feature != 'const'\")\n\ncoef_df['OR']    = np.exp(coef_df['coef'])\n---\nCELL 15\n\n# \u2500\u2500 ML: prepare feature matrix (same features + interactions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score, roc_curve, average_precision_score\n\nml_cols = all_x_cols   # same features as logistic regression (incl. interactions)\nX_ml = model_df[ml_cols].values\nX_ml_raw = model_df_unscaled[ml_cols].values\ny_ml = model_df['readmitted'].values\n\ncv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n---\nCELL 16\n\n# \u2500\u2500 Fig 8: ROC curves \u2014 LR vs Random Forest vs CatBoost \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 2, figsize=(14, 6))\n\nmodels = [\n    ('Logistic Regression', lr_probs,  '#2166ac', lr_auc),\n    ('Random Forest',       rf_probs,  '#4dac26', rf_auc),\n    ('CatBoost',            cat_probs, '#d01c8b', cat_auc),\n]\n\n# Left: ROC curves\nfor name, probs, color, auc in models:\n---\nCELL 17\n\n# \u2500\u2500 Fig 9: SHAP summary plot (CatBoost trained on full dataset) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nimport shap\n\nfeature_labels = [all_labels.get(c, c) for c in ml_cols]\n\n# Refit CatBoost on full dataset for SHAP\ncat_full = CatBoostClassifier(\n    iterations=500, depth=4, learning_rate=0.05,\n    auto_class_weights='Balanced', eval_metric='AUC',\n    random_seed=42, verbose=0,\n)\n---\nCELL 18\n\n# \u2500\u2500 Fig 10: Feature importance \u2014 RF vs CatBoost (side-by-side) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nrf_full = RandomForestClassifier(\n    n_estimators=500, max_depth=6, min_samples_leaf=10,\n    class_weight='balanced', random_state=42, n_jobs=-1\n)\nrf_full.fit(X_ml, y_ml)\n\nrf_imp  = pd.Series(rf_full.feature_importances_,  index=feature_labels).sort_values(ascending=False).head(15)\ncat_imp = pd.Series(cat_full.get_feature_importance(), index=feature_labels).sort_values(ascending=False).head(15)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\n---\nCELL 19\n\n# \u2500\u2500 Fig 11: SHAP dependence plots \u2014 top 3 CatBoost predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Manual scatter avoids shap.dependence_plot's internal jitter and gives\n# full axis control. Uses unscaled feature values for the x-axis. Negative\n# x-values, if present, reflect actual data\n# quality issues in the source (e.g., DischDate < VisitDate \u2192 negative LOS);\n# those records are flagged below.\ntop3 = cat_imp.head(3).index.tolist()\n\n# Warn about negative feature values\nfor feat_label in top3:\n    feat_idx = feature_labels.index(feat_label)\n---\nCELL 20\n\n# \u2500\u2500 Fig 9b: SHAP summary plot \u2014 Random Forest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# rf_full already fitted in the feature importance cell\nexplainer_rf   = shap.TreeExplainer(rf_full)\nshap_values_rf = explainer_rf.shap_values(X_ml)\n\n# Robustly extract class-1 SHAP values across SHAP version formats:\n#   - list of two arrays (older SHAP)  \u2192 shap_values_rf[1]\n#   - 3-D array (n, p, 2) (newer SHAP) \u2192 shap_values_rf[:, :, 1]\n#   - 2-D array (n, p) (single output) \u2192 shap_values_rf\nif isinstance(shap_values_rf, list):\n    shap_rf_pos = shap_values_rf[1]\n---\n",

uma and Stressor-Related Disorders', 'dsm5_code': 'F43.20'},\n    'F43.21': {'name': 'Adjustment disorder with anxiety', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.21'},\n    'F43.22': {'name': 'Adjustment disorder with mixed anxiety and depression', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.22'},\n    'F43.23': {'name': 'Adjustment disorder with mixed disturbance of emotions and conduct', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.23'},\n    'F43.24': {'name': 'Adjustment disorder with disturbance of conduct', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.24'},\n    'F43.25': {'name': 'Adjustment disorder with mixed disturbance of emotions and conduct, with prolonged duration', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.25'},\n    'F43.29': {'name': 'Adjustment disorder with other disturbance', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.29'},\n    'F43.8': {'name': 'Other specified trauma- and stressor-related disorder', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.8'},\n    'F43.9': {'name': 'Unspecified trauma- and stressor-related disorder', 'dsm5_category': 'Trauma and Stressor-Related Disorders', 'dsm5_code': 'F43.9'},\n    \n    # DEPRESSIVE DISORDERS\n    'F32.0': {'name': 'Major depressive disorder, single episode, mild', 'dsm5_category': 'Depressive Disorders', 'dsm5_code': 'F32.0'},\n    'F32.1': {'name': 'Major depressive disorder, single episode, moderate', 'dsm5_category': 'Depressive Disorders', 'dsm5_code': 'F32.1'},\n    'F32.2': {'name': 'Major depressive disorder, single episode, severe without psychotic features', 'dsm5_category': 'Depressive Disorders', 'dsm5_code': 'F32.2'},\n    'F32.3': {'name': 'Major depressive disorder, single episode, severe with psychotic features', 'dsm5_category': 'Depressive Disorders', 'dsm5_co
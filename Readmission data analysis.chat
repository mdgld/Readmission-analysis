              "content": "\"min_nb = min(min_nb, min(v for v in treat_all_nb if not np.isnan(v)))\\n\",\n    \"\\n\",\n    \"fig, ax = plt.subplots(figsize=(11, 7))\\n\",\n    \"colors = {'CatBoost': '#d01c8b', 'Random Forest': '#4dac26', 'Logistic Regression': '#2166ac'}\\n\",\n    \"for name, nb in model_nbs.items():\\n\",\n    \"    ax.plot(thresholds, nb, linewidth=2.5, label=name, color=colors[name])\\n\",\n    \"\\n\",\n    \"ax.plot(thresholds, treat_all_nb, 'k--', linewidth=1.5, label='Screen All')\\n\",\n    \"ax.axhline(0, color='gray', linestyle=':', linewidth=1.5, label='Screen None  (NB = 0)')\\n\",\n    \"\\n\",\n    \"# Explicit y-axis range so the Screen All line is always visible\\n\",\n    \"y_pad_upper = max(0.005, max_nb * 0.15)\\n\",\n    \"y_pad_lower = max(0.005, abs(min_nb) * 0.15)\\n\",\n    \"ax.set_ylim(min_nb - y_pad_lower, max_nb + y_pad_upper)\\n\",\n    \"\\n\",\n    \"# Annotation orienting reader to the positive region\\n\",\n    \"ax.text(0.02, -0.4, 'Positive NB: screening adds clinical value',\\n\",\n    \"        fontsize=9, color='dimgray', style='italic',\\n\",\n    \"        va='center', bbox=dict(facecolor='white', alpha=0.7, edgecolor='none'))\\n\",\n    \"\\n\",\n    \"ax.set_xlabel('Threshold Probability', fontsize=13)\\n\",\n    \"ax.set_ylabel('Net Benefit', fontsize=13)\\n\",\n    \"ax.set_title('Decision Curve Analysis\\\\n'\\n\",\n    \"             'Net Benefit of Screening vs. Treat-All / Treat-None',\\n\",\n    \"             fontsize=14, fontweight='bold')\\n\",\n    \"ax.legend(fontsize=11)\\n\",\n    \"ax.set_xlim(0.02, 0.50)\\n\",\n    \"ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda v, _: f'{v:.3f}'))\\n\",\n    \"ax.grid(axis='y', alpha=0.3, linewidth=0.6)\\n\",\n    \"ax.spines['top'].set_visible(False)\\n\",\n    \"ax.spines['right'].set_visible(False)\\n\",\n    \"plt.tight_layout()\\n\",\n    \"plt.savefig('figures/Fig_DCA.png')\\n\",\n    \"plt.show()\\n\",\n    \"print(\\\"\u2713 DCA saved\\\")\\
                "jq -r '.cells | to_entries[] | select(.value.source | join(\"\") | test(\"Fig 13|Fig 14|Burden vs Benefit|FP vs FN\")) | \"CELL \\(.key)\\n\" + (.value.source | join(\"\")) + \"\\n---\"' Readmission_Full_Analysis.ipynb"
              ],

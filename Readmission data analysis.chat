            "raw_output": "=== Cell [3] 3429a95a-966a-4330-8bed-3ac6bcc69667 ===\n\n# \u2500\u2500 Fig 1: Age distribution + readmission rate by age \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Left: age histogram by readmission status\nfor status, color, label in [(0, BLUE, 'Not Readmitted'), (1, ORANGE, 'Readmitted')]:\n    subset = df[df['readmitted'] == status]['age'].dropna()\n    axes[0].hist(subset, bins=range(5, 19), alpha=0.7, color=color, label=label,\n                 edgecolor='white', density=True)\naxes[0].set_xlabel('Age at Admission (years)')\naxes[0].set_ylabel('Density')\naxes[0].set_title('Age Distribution by Readmission Status')\naxes[0].legend()\naxes[0].set_xticks(range(6, 18))\n\n# Right: readmission rate by age\nage_ra = df.groupby('age')['readmitted'].agg(['mean', 'count']).reset_index()\nage_ra.columns = ['age', 'rate', 'n']\nage_ra = age_ra[age_ra['n'] >= 10]\nfrom statsmodels.stats.proportion import proportions_ztest\nci = 1.96 * np.sqrt(age_ra['rate'] * (1 - age_ra['rate']) / age_ra['n'])\noverall_rate = df['readmitted'].mean()\nsigs = []\nfor i, row in age_ra.reset_index().iterrows():\n    _, p = proportions_ztest(row['rate']*row['n'], row['n'], value=overall_rate)\n    p_label = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\n    sigs.append(p_label if p < 0.05 else '')\n\naxes[1].bar(age_ra['age'], age_ra['rate'] * 100, color=ORANGE, alpha=0.8, edgecolor='white')\naxes[1].errorbar(age_ra['age'], age_ra['rate'] * 100, yerr=ci * 100,\n                 fmt='none', color='black', capsize=4, linewidth=1.5)\nfor i, row in age_ra.reset_index().iterrows():\n    axes[1].text(row['age'], row['rate'] * 100 + ci[i]*100 + 1, sigs[i], color='red', ha='center', fontweight='bold')\n    axes[1].text(row['age'], row['rate'] * 100 + 3.5, f\"n={int(row['n'])}\", \n                 ha='center', fontsize=9, color='gray')\naxes[1].set_xlabel('Age at Admission (years)')\naxes[1].set_ylabel('Readmission Rate (%)')\naxes[1].set_title('Readmission Rate by Age at Admission')\naxes[1].set_xticks(age_ra['age'].astype(int))\naxes[1].set_ylim(0, 45) # Expanded for Age 6 CI\n\nplt.tight_layout()\nplt.savefig('figures/Fig1_age_distribution.png')\nplt.show()\nprint(\"\u2713 Fig 1 saved\")\n\n\n=== Cell [4] 402e9af8-a3b2-4624-8e97-70626d28768f ===\n\n# \u2500\u2500 Fig 2: Demographics panel (gender, insurance, C-SSRS, restraints) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig, axes = plt.subplots(1, 4, figsize=(18, 5))\n\nbinary_vars = [\n    ('gender_male',       'Gender ID at Admission',          ['Female', 'Male']),\n    ('insurance_public',  'Insurance Type', ['Private', 'Public']),\n    ('csrss_any',         'Any C-SSRS Flag',   ['No Flag', 'Flag']),\n    ('had_restraints',    'Physical Restraints\\nUsed', ['No', 'Yes']),\n]\n\nfor ax, (col, title, xlabels) in zip(axes, binary_vars):\n    res = df.groupby(col)['readmitted'].agg(['mean', 'count'])\n    rates = res['mean'] * 100\n    ns = res['count']\n    err = 1.96 * np.sqrt(res['mean']*(1-res['mean'])/ns) * 100\n    from scipy.stats import chi2_contingency\n    tab = pd.crosstab(df[col], df['readmitted'])\n    _, p, _, _ = chi2_contingency(tab)\n    p_str = f'p={p:.3f}' if p >= 0.001 else 'p<0.001'\n    if col == 'had_restraints' and p < 0.001: p_str += ' ***'\n    counts = df.groupby(col)['readmitted'].count()\n    colors = [BLUE, ORANGE]\n    bars = ax.bar(xlabels, rates.values, yerr=err.values, capsize=5, color=colors, alpha=0.85, edgecolor='white', width=0.5)\n    for bar, n, rate in zip(bars, counts.values, rates.values):\n        ax.text(bar.get_x() + bar.get_width()/2, rate + 0.5, \n        f'{rate:.1f}%\\n(n={n})', ha='center', va='bottom', fontsize=11)\n    ax.set_title(f'{title}\\n{p_str}', fontsize=12, fontweight='bold')\n    ax.set_ylabel('Readmission Rate (%)')\n    ax.set_ylim(0, max(rates.values) * 1.35)\n    ax.spines['top'].set_visible(False)\n    ax.spines['right'].set_visible(False)\n\nplt.suptitle('Readmission Rates by Demographic & Clinical Characteristics', \n             fontsize=16, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig2_demographics_panel.png')\nplt.show()\nprint(\"\u2713 Fig 2 saved\")\n\n\n=== Cell [21] 4e876b0c-1396-4bc7-85aa-fb099a375a57 ===\n\n# \u2500\u2500 Fig 12: UMAP embedding of FAMD components \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nreducer = umap.UMAP(n_components=2, n_neighbors=30, min_dist=0.1,\n                    metric='euclidean', random_state=42)\nembedding = reducer.fit_transform(famd_coords)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 6))\n\n# Left: colored by readmission status\nmask_nr = y_ml == 0\nmask_r  = y_ml == 1\naxes[0].scatter(embedding[mask_nr, 0], embedding[mask_nr, 1],\n                c=BLUE, alpha=0.25, s=12, label=f'Not Readmitted (n={mask_nr.sum()})', rasterized=True)\naxes[0].scatter(embedding[mask_r, 0], embedding[mask_r, 1],\n                c=ORANGE, alpha=0.75, s=25, label=f'Readmitted (n={mask_r.sum()})', rasterized=True)\naxes[0].set_xlabel('UMAP Dimension 1 (Clinical/Demographic Profile)')\naxes[0].set_ylabel('UMAP Dimension 2 (Diagnostic Complexity)')\naxes[0].set_title('UMAP of FAMD Components\\nColored by Readmission Status', fontsize=14, fontweight='bold')\naxes[0].legend(fontsize=11, markerscale=2)\naxes[0].spines['top'].set_visible(False)\naxes[0].spines['right'].set_visible(False)\n\n# Right: colored by CatBoost predicted probability (continuous gradient)\nsc = axes[1].scatter(embedding[:, 0], embedding[:, 1],\n                     c=cat_probs, cmap='RdYlBu_r', alpha=0.5, s=12, vmin=0, vmax=0.6, rasterized=True)\nplt.colorbar(sc, ax=axes[1], label='CatBoost Predicted P(Readmission)')\naxes[1].set_xlabel('UMAP Dimension 1 (Clinical/Demographic Profile)')\naxes[1].set_ylabel('UMAP Dimension 2 (Diagnostic Complexity)')\naxes[1].set_title('UMAP of FAMD Components\\nContinuous Readmission Risk', fontsize=14, fontweight='bold')\naxes[1].spines['top'].set_visible(False)\naxes[1].spines['right'].set_visible(False)\n\nplt.suptitle('Unsupervised Pattern Discovery: FAMD + UMAP\\n(n=2,652 psychiatric admissions)',\n             fontsize=15, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig12_FAMD_UMAP.png')\nplt.show()\nprint(\"\u2713 Fig 12 saved\")\n\n\n=== Cell [22] df20b1a5-d643-4166-a9ce-aeacc490fb8f ===\n\n# \u2500\u2500 Fig 13 & 14: Clinical Burden/Benefit for all models \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nmodel_results = [\n    ('CatBoost', cat_probs),\n    ('Random Forest', rf_probs),\n    ('Logistic Regression', lr_probs)\n]\n\nfor name, probs in model_results:\n    # \u2500\u2500 FP vs FN (Fig 13 style)\n    thresholds = np.linspace(0.01, 0.99, 300)\n    fp_counts, fn_counts = [], []\n    for thresh in thresholds:\n        preds = (probs >= thresh).astype(int)\n        tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n        fp_counts.append(fp)\n        fn_counts.append(fn)\n    \n    # Calculate crossover\n    crossover_idx = np.argmin(np.abs(np.array(fp_counts) - np.array(fn_counts)))\n    crossover_t = thresholds[crossover_idx]\n    \n    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n    axes[0].plot(thresholds, fp_counts, color='#e74c3c', label='False Positives')\n    axes[0].plot(thresholds, fn_counts, color='#3498db', label='False Negatives')\n    axes[0].axvline(crossover_t, color='purple', linestyle=':', label=f'Crossover (t={crossover_t:.2f})')\n    axes[0].set_title(f'{name}: FP vs FN')\n    axes[0].legend()\n\n    # \u2500\u2500 Clinical Burden (Fig 14 style) - limited to crossover_t\n    key_ts = [t for t in [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50] if t <= crossover_t]\n    if not key_ts: key_ts = [0.05, 0.10]\n    \n    flag_pcts, sens = [], []\n    for t in key_ts:\n        preds = (probs >= t).astype(int)\n        flag_pcts.append(100 * preds.sum() / len(y_ml))\n        tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n        sens.append(100 * tp / (tp + fn))\n    \n    axes[1].plot(key_ts, flag_pcts, 's-', label='% Flagged')\n    axes[1].plot(key_ts, sens, 'o-', label='Sensitivity')\n    axes[1].set_title(f'{name}: Burden vs Benefit')\n    axes[1].set_xlabel('Probability Threshold')\n    axes[1].legend()\n    \n    plt.suptitle(f'Decision Support Metrics: {name}')\n    plt.tight_layout()\n    plt.savefig(f'figures/Decision_Support_{name.replace(\" \", \"_\")}.png')\n    plt.show()\n\n\n=== Cell [23] 4dfd8916-95c7-48e4-96b6-68b06d869438 ===\n\n# \u2500\u2500 Fig 14: % of charts flagged + Sensitivity/PPV at key thresholds \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nkey_thresholds = [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]\nn_total   = len(y_ml)\nn_pos     = y_ml.sum()\nflag_pcts, sensitivities, ppvs, n_flagged_list = [], [], [], []\n\nfor thresh in key_thresholds:\n    preds = (cat_probs >= thresh).astype(int)\n    n_flag = preds.sum()\n    tn, fp, fn, tp = confusion_matrix(y_ml, preds).ravel()\n    flag_pcts.append(100 * n_flag / n_total)\n    n_flagged_list.append(n_flag)\n    sensitivities.append(100 * tp / (tp + fn) if (tp + fn) > 0 else 0)\n    ppvs.append(100 * tp / (tp + fp) if (tp + fp) > 0 else 0)\n\nxlabels = [f'{int(t*100)}%' for t in key_thresholds]\nx_pos   = np.arange(len(key_thresholds))\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\n\n# Left: % of charts flagged (bars)\nbars = axes[0].bar(x_pos, flag_pcts, color=ORANGE, alpha=0.85, edgecolor='white')\naxes[0].axhline(100 * n_pos / n_total, color='black', linestyle='--', linewidth=1.5,\n                label=f'Actual readmission rate ({100*n_pos/n_total:.1f}%)')\naxes[0].set_xticks(x_pos)\naxes[0].set_xticklabels(xlabels)\nfor bar, pct, n in zip(bars, flag_pcts, n_flagged_list):\n    axes[0].text(bar.get_x() + bar.get_width()/2, pct + 0.5,\n                f'{pct:.1f}%\\n(n={n})', ha='center', fontsize=9, fontweight='bold')\naxes[0].set_xlabel('Probability Threshold')\naxes[0].set_ylabel('% of All Hospital Charts Flagged')\naxes[0].set_title('% of Charts Triggering a Flag\\nby Probability Threshold', fontsize=14, fontweight='bold')\naxes[0].legend(fontsize=11)\naxes[0].spines['top'].set_visible(False)\naxes[0].spines['right'].set_visible(False)\n\n# Right: Sensitivity and PPV\naxes[1].plot(x_pos, sensitivities, 'o-', color=BLUE, linewidth=2.5, markersize=8,\n             label='Sensitivity (% readmissions caught)')\naxes[1].plot(x_pos, ppvs, 's--', color=ORANGE, linewidth=2.5, markersize=8,\n             label='PPV (% flagged who are truly readmitted)')\nfor i, (s, p) in enumerate(zip(sensitivities, ppvs)):\n    axes[1].text(i, s + 2.5, f'{s:.0f}%', ha='center', fontsize=9, color=BLUE, fontweight='bold')\n    axes[1].text(i, p - 4,   f'{p:.0f}%', ha='center', fontsize=9, color=ORANGE, fontweight='bold')\naxes[1].set_xticks(x_pos)\naxes[1].set_xticklabels(xlabels)\naxes[1].set_xlabel('Probability Threshold')\naxes[1].set_ylabel('%')\naxes[1].set_ylim(0, 115)\naxes[1].set_title('Sensitivity & PPV by Threshold\\n(Clinical Decision Support Trade-offs)', fontsize=14, fontweight='bold')\naxes[1].legend(fontsize=11, loc='upper right')\naxes[1].spines['top'].set_visible(False)\naxes[1].spines['right'].set_visible(False)\n\nplt.suptitle('Clinical Flagging Burden vs. Benefit: CatBoost Model\\n(10-Fold CV Probabilities, n=2,652 admissions)',\n             fontsize=15, fontweight='bold', y=1.02)\nplt.tight_layout()\nplt.savefig('figures/Fig14_flagging_thresholds.png')\nplt.show()\n\n# Print decision-support table\nprint(\"\\nClinical Decision Table:\")\nprint(f\"{'Threshold':>10}  {'% Flagged':>10}  {'N Flagged':>10}  {'Sensitivity':>12}  {'PPV':>8}\")\nprint(\"-\" * 58)\nfor t, pct, n, sens, ppv in zip(key_thresholds, flag_pcts, n_flagged_list, sensitivities, ppvs):\n    print(f\"  {t*100:>5.0f}%     {pct:>8.1f}%   {n:>9}     {sens:>9.1f}%   {ppv:>6.1f}%\")\nprint(\"\u2713 Fig 14 saved\")",

              "detailedContent": "\"# \u2500\u2500 Fig 11b: SHAP dependence plots \u2014 top 3 Random Forest predictors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n\",\n    \"# Uses manual scatter + running-mean trend instead of shap.dependence_plot,\\n\",\n    \"# which adds x-jitter that pushes 0-valued binary features into negative territory.\\n\",\n    \"rf_imp_top3 = rf_imp.head(3).index.tolist()\\n\",\n    \"\\n\",\n    \"fig, axes = plt.subplots(1, 3, figsize=(18, 5))\\n\",\n    \"for ax, feat_label in zip(axes, rf_imp_top3):\\n\",\n    \"    feat_idx  = feature_labels.index(feat_label)\\n\",\n    \"    feat_vals = X_ml[:, feat_idx].copy()\\n\",\n    \"    shap_vals = shap_rf_pos[:, feat_idx]\\n\",\n    \"\\n\",\n    \"    # Color points by readmission status\\n\",\n    \"    c_vals = [ORANGE if y == 1 else BLUE for y in y_ml]\\n\",\n    \"    ax.scatter(feat_vals, shap_vals, c=c_vals, alpha=0.25, s=12, rasterized=True)\\n\",\n    \"    ax.axhline(0, color='gray', linestyle='--', linewidth=0.8, alpha=0.7)\\n\",\n    \"\\n\",\n    \"    # Running-mean trend line\\n\",\n    \"    sort_idx = np.argsort(feat_vals)\\n\",\n    \"    xs = feat_vals[sort_idx]\\n\",\n    \"    ys = shap_vals[sort_idx]\\n\",\n    \"    win = max(60, len(xs) // 15)\\n\",\n    \"    y_smooth = np.convolve(ys, np.ones(win) / win, mode='valid')\\n\",\n    \"    x_smooth = xs[win // 2: win // 2 + len(y_smooth)]\\n\",\n    \"    ax.plot(x_smooth, y_smooth, 'k-', linewidth=2.2, alpha=0.85, label='Trend')\\n\",\n    \"\\n\",\n    \"    ax.set_xlabel(feat_label, fontsize=11)\\n\",\n    \"    ax.set_ylabel('SHAP value\\\\n(+ = raises readmission risk)', fontsize=9)\\n\",\n    \"    ax.set_title(f'SHAP Dependence: {feat_label}', fontsize=13, fontweight='bold')\\n\",\n    \"    ax.spines['top'].set_visible(False)\\n\",\n    \"    ax.spines['right'].set_visible(False)\\n\",\n    \"\\n\",\n    \"    # Compact legend\\n\",\n    \"    from matplotlib.lines import Line2D\\n\",\n    \